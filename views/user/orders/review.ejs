<div class="min-h-screen flex flex-col md:flex-row p-4 md:p-8 font-['Inter']" style="background-color: #F5E9DA;">

    <aside class="w-full md:w-[260px] shrink-0 mb-8 md:mb-0 md:mr-8">
        <%- include("../../partials/user/sidebar") %>
    </aside>

    <main class="flex-grow">
        <header class="mb-12 text-center md:text-left">
            <span class="text-[#C8A97E] text-[10px] font-black uppercase tracking-[0.4em] mb-4 block">Feedback</span>
            <h1 class="text-4xl md:text-5xl font-black text-stone-800 tracking-tighter uppercase leading-none">
                Rate Product
            </h1>
        </header>
<section class="bg-white/40 backdrop-blur-xl rounded-[3rem] shadow-xl border border-white/60 overflow-hidden mb-12">
    <div class="flex flex-col md:flex-row items-center p-8 md:p-12 gap-12">
        <div class="w-64 h-64 md:w-72 md:h-72 shrink-0 rounded-[2.5rem] overflow-hidden shadow-2xl border-4 border-white">
            <img src="<%= product.imageURL %>" alt="<%= product.name %>"
                class="w-full h-full object-cover" />
        </div>

        <div class="text-center md:text-left">
            <div class="h-1 w-12 bg-[#C8A97E] mb-6 mx-auto md:mx-0"></div>
            <h2 class="text-3xl font-black text-stone-800 tracking-tight uppercase mb-2">
                <%= product.name %>
            </h2>
            <p class="text-stone-500 font-medium tracking-wide text-xs uppercase opacity-60">
                Purchased from Luxe & Co.
            </p>
        </div>
    </div>
</section>

<section class="relative bg-white rounded-[3rem] shadow-[0_30px_60px_rgba(0,0,0,0.05)] p-10 md:p-16 border border-white/80 overflow-hidden">
    <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-[#C8A97E]/30 to-transparent"></div>

    <form action="/user/review/submit" method="POST" id="reviewForm">
        <input type="hidden" name="productId" value="<%= product.id %>">
        <input type="hidden" name="orderId" value="<%= orderId %>">
        <input type="hidden" name="rating" id="selectedRating" value="0">

        <div class="mb-20 text-center md:text-left">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10">
                <div>
                    <label class="block text-stone-800 font-black text-[11px] uppercase tracking-[0.4em] mb-2">
                        Your Personal Rating
                    </label>
                    <p class="text-stone-400 text-xs italic">How would you describe your experience?</p>
                </div>
                
<div class="flex justify-center gap-6 p-6 bg-[#F9F7F4] rounded-[2rem] shadow-[inner_0_4px_12px_rgba(0,0,0,0.03)] border border-stone-200/40 relative overflow-hidden" id="starContainer">                    <% for(let i=1; i <=5; i++) { %>
                        <button type="button" data-value="<%= i %>"
                            class="star-btn text-stone-200 transition-all duration-500 transform hover:scale-125 hover:text-amber-400">
                            <svg class="w-10 h-10 pointer-events-none drop-shadow-sm" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                        </button>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="mb-16">
            <label for="reviewBody" class="block text-stone-800 font-black text-[11px] uppercase tracking-[0.4em] mb-6">
                Written Feedback
            </label>
            <div class="relative group">
                <textarea id="reviewBody" name="comment" rows="6" required
                    class="w-full p-10 rounded-[2rem] bg-stone-50/30 border border-stone-200 focus:bg-white focus:border-[#C8A97E]/50 focus:ring-4 focus:ring-[#C8A97E]/5 outline-none transition-all duration-500 text-stone-700 placeholder-stone-300 resize-none text-lg leading-relaxed shadow-inner"
                    placeholder="Describe the craftsmanship, fit, and feel..."></textarea>
                <div class="absolute bottom-6 right-6 opacity-20 pointer-events-none">
                    <svg class="w-8 h-8 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row justify-end items-center gap-10">
            <a href="javascript:history.back()"
                class="text-stone-400 font-bold text-[10px] uppercase tracking-[0.3em] hover:text-red-800 transition-all duration-300 py-2 group">
                <span class="inline-block transition-transform group-hover:-translate-x-1 mr-1">←</span> Cancel Review
            </a>

            <button type="submit"
                class="w-full sm:w-auto px-20 py-6 rounded-full bg-stone-900 text-[#C8A97E] font-black text-[11px] uppercase tracking-[0.4em] shadow-2xl shadow-stone-900/20 transition-all duration-500 transform hover:-translate-y-1 hover:bg-black active:scale-95">
                Post Review
            </button>
        </div>
    </form>
</section>
    </main>
</div>
<script>
    const stars = document.querySelectorAll('.star-btn');
    const ratingInput = document.getElementById('selectedRating');
    const reviewForm = document.getElementById('reviewForm');

    stars.forEach(star => {
        star.addEventListener('click', () => {
            const value = star.getAttribute('data-value');
            ratingInput.value = value;
            updateStars(value);
        });

        star.addEventListener('mouseenter', () => {
            updateStars(star.getAttribute('data-value'), true);
        });

        star.addEventListener('mouseleave', () => {
            updateStars(ratingInput.value);
        });
    });

    function updateStars(value, isHover = false) {
        const numericValue = parseInt(value) || 0;
        stars.forEach(s => {
            const sValue = parseInt(s.getAttribute('data-value'));
            if (sValue <= numericValue) {
                s.classList.remove('text-stone-100');
                s.classList.add(isHover ? 'text-amber-200' : 'text-amber-400');
            } else {
                s.classList.add('text-stone-100');
                s.classList.remove('text-amber-200', 'text-amber-400');
            }
        });
    }

    reviewForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (ratingInput.value === "0") {
            return notyf.error('Please select a rating.');
        }

        try {
            const formData = {
                productId: document.getElementsByName('productId')[0].value,
                orderId: document.getElementsByName('orderId')[0].value,
                rating: ratingInput.value,
                comment: document.getElementById('reviewBody').value
            };

            const response = await axios.post('/user/review/submit', formData);

            if (response.data.success) {
                notyf.success(response.data.message);
                setTimeout(() => {
                    window.location.href = response.data.redirect;
                }, 1500);
            }
        } catch (error) {
            notyf.error(error.response?.data?.message || 'Server Error: Could not post review');
        }
    });
</script>