<div class="min-h-screen bg-[#F5E9DA] p-4 md:p-8 font-['Inter']">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row">
        
        <aside class="w-full md:w-[260px] shrink-0 mb-8 md:mb-0 md:mr-8">
            <%- include("../../partials/user/sidebar") %>
        </aside>

        <main class="flex-grow">
            <header class="mb-12 text-center md:text-left">
                <span class="text-[#C8A97E] text-[10px] font-black uppercase tracking-[0.4em] mb-4 block">Feedback</span>
                <h1 class="text-4xl md:text-5xl font-black text-stone-800 tracking-tighter uppercase leading-none">
                    Rate Product
                </h1>
            </header>

            <section class="bg-white rounded-[2.5rem] shadow-2xl shadow-stone-300/40 overflow-hidden mb-12 border border-white">
                <div class="flex flex-col md:flex-row items-center p-8 md:p-10 gap-10">
                    <div class="w-64 h-64 md:w-72 md:h-72 shrink-0 bg-stone-50 rounded-2xl overflow-hidden shadow-inner border border-stone-100">
                        <img 
                            src="<%= product.imageURL %>" 
                            alt="<%= product.name %>" 
                            class="w-full h-full object-cover transform hover:scale-110 transition-transform duration-1000"
                        />
                    </div>
                    
                    <div class="text-center md:text-left">
                        <span class="inline-block px-3 py-1 bg-stone-100 rounded-full text-stone-400 text-[9px] font-bold uppercase tracking-widest mb-4">
                            <%= product.category %>
                        </span>
                        <h2 class="text-3xl font-black text-stone-800 leading-tight mb-2">
                            <%= product.name %>
                        </h2>
                        <p class="text-stone-400 text-sm italic">Tell us what you think about this piece.</p>
                    </div>
                </div>
            </section>

            <section class="bg-white rounded-[2.5rem] shadow-2xl shadow-stone-300/40 p-10 md:p-16 border border-white">
                <form action="/user/review/submit" method="POST" id="reviewForm">
                    <input type="hidden" name="productId" value="<%= product.id %>">
                    <input type="hidden" name="orderId" value="<%= orderId %>">
                    <input type="hidden" name="rating" id="selectedRating" value="0">

                    <div class="mb-16">
                        <label class="block text-stone-400 font-bold text-[10px] uppercase tracking-[0.3em] mb-8 text-center md:text-left">
                            Your Personal Rating
                        </label>
                        <div class="flex justify-center md:justify-start gap-6" id="starContainer">
                            <% for(let i = 1; i <= 5; i++) { %>
                                <button type="button" data-value="<%= i %>" class="star-btn text-stone-100 transition-all duration-300 transform hover:scale-125">
                                    <svg class="w-12 h-12 pointer-events-none" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                    </svg>
                                </button>
                            <% } %>
                        </div>
                    </div>

                    <div class="mb-16">
                        <label for="reviewBody" class="block text-stone-400 font-bold text-[10px] uppercase tracking-[0.3em] mb-6">
                            Written Feedback
                        </label>
                        <textarea 
                            id="reviewBody"
                            name="comment"
                            rows="5" 
                            required
                            class="w-full p-8 rounded-3xl bg-stone-50 border border-stone-100 focus:bg-white focus:ring-1 focus:ring-stone-200 outline-none transition-all text-stone-700 placeholder-stone-300 resize-none text-lg"
                            placeholder="Share your thoughts..."></textarea>
                    </div>

                    <div class="flex flex-col-reverse sm:flex-row justify-between items-center gap-8">
                        <a href="javascript:history.back()" class="text-stone-300 font-bold text-[10px] uppercase tracking-[0.2em] hover:text-stone-800 transition-colors">
                            Cancel
                        </a>
                        <button type="submit" class="w-full sm:w-auto px-16 py-5 rounded-2xl bg-[#C8A97E] text-white font-bold text-[10px] uppercase tracking-[0.4em] shadow-xl shadow-[#C8A97E]/30 transition-all transform hover:-translate-y-1 active:scale-95">
                            Post Review
                        </button>
                    </div>
                </form>
            </section>
        </main>
    </div>
</div>
<script>
    const stars = document.querySelectorAll('.star-btn');
    const ratingInput = document.getElementById('selectedRating');
    const reviewForm = document.getElementById('reviewForm');

    stars.forEach(star => {
        star.addEventListener('click', () => {
            const value = star.getAttribute('data-value');
            ratingInput.value = value;
            updateStars(value);
        });

        star.addEventListener('mouseenter', () => {
            updateStars(star.getAttribute('data-value'), true);
        });

        star.addEventListener('mouseleave', () => {
            updateStars(ratingInput.value);
        });
    });

    function updateStars(value, isHover = false) {
        const numericValue = parseInt(value) || 0; 
        stars.forEach(s => {
            const sValue = parseInt(s.getAttribute('data-value')); 
            if (sValue <= numericValue) {
                s.classList.remove('text-stone-100');
                s.classList.add(isHover ? 'text-amber-200' : 'text-amber-400');
            } else {
                s.classList.add('text-stone-100');
                s.classList.remove('text-amber-200', 'text-amber-400');
            }
        });
    }

    reviewForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        if (ratingInput.value === "0") {
            return notyf.error('Please select a rating.');
        }

        try {
            const formData = {
                productId: document.getElementsByName('productId')[0].value,
                orderId: document.getElementsByName('orderId')[0].value,
                rating: ratingInput.value,
                comment: document.getElementById('reviewBody').value
            };

            const response = await axios.post('/user/review/submit', formData);

            if (response.data.success) {
                notyf.success(response.data.message);
                setTimeout(() => {
                    window.location.href = response.data.redirect; 
                }, 1500);
            }
        } catch (error) {
            notyf.error(error.response?.data?.message || 'Server Error: Could not post review');
        }
    });
</script>
