<% // Define formatPrice locally at the top of the file 
const formatPrice=(amount)=> {
    return new Intl.NumberFormat('en-IN', {
        style: 'currency',
        currency: 'INR',
        minimumFractionDigits: 2
    }).format(amount || 0);
};
%>

<div class="min-h-screen flex flex-col md:flex-row p-4 md:p-8" style="background-color: #F5E9DA;">
    <aside class="w-full md:w-[260px] shrink-0 mb-8 md:mb-0 md:mr-8">
        <%- include("../../partials/user/sidebar") %>
    </aside>

    <main class="flex-grow max-w-5xl space-y-6">
        <div class="flex justify-between items-center pb-6 border-b border-stone-200 mb-8">
    <h1 class="text-3xl font-bold text-stone-700 tracking-tight">Order Details</h1>
    
    <% 
        const hasItemReturnRequested = order.items.some(item => item.status === 'Return Requested');
        
        let mainBadgeStyle=''; 
        let displayStatus = order.status;

        if (hasItemReturnRequested) {
            displayStatus = 'Return In Progress';
            mainBadgeStyle = 'bg-orange-50 border-orange-200 border-l-orange-500 text-orange-600';
        } else {
            switch (order.status) { 
                case 'Cancelled': 
                    mainBadgeStyle='bg-red-50 border-red-200 border-l-red-500 text-red-600'; break;
                case 'Confirmed': 
                    mainBadgeStyle='bg-green-50 border-green-200 border-l-green-500 text-green-600'; break;
                case 'Processing': 
                    mainBadgeStyle='bg-blue-50 border-blue-200 border-l-blue-500 text-blue-600'; break;
                case 'Shipped': 
                    mainBadgeStyle='bg-purple-50 border-purple-200 border-l-purple-500 text-purple-600'; break;
                case 'Delivered': 
                    mainBadgeStyle='bg-emerald-50 border-emerald-200 border-l-emerald-600 text-emerald-700'; break;
                case 'Returned': 
                    mainBadgeStyle='bg-blue-50 border-blue-200 border-l-blue-500 text-blue-600'; break;
                case 'Rejected':
                case 'Return Rejected': 
                    mainBadgeStyle='bg-red-50 border-red-200 border-l-red-600 text-red-700'; break;
                default: 
                    mainBadgeStyle='bg-white border-stone-300 border-l-stone-400 text-stone-600';
            } 
        }
    %>

    <div class="flex flex-col items-end gap-1">
        <span class="inline-flex items-center px-4 py-2 border rounded text-[10px] font-black uppercase tracking-widest shadow-sm <%= mainBadgeStyle %>">
            <%= displayStatus %>
        </span>
        <% if (hasItemReturnRequested) { %>
            <span class="text-[9px] font-bold text-orange-400 animate-pulse">Waiting for admin approval</span>
        <% } %>
    </div>
</div>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-stone-200">
            <div class="flex justify-between items-center mb-8">
                <h3 class="font-semibold text-stone-700">Delivery Progress</h3>
                <p class="text-xs text-stone-500">Expected Delivery: Dec 28, 2024</p>
            </div>

            <div class="relative flex items-center justify-between">
                <div class="absolute left-0 top-5 w-full h-1 bg-stone-100 -z-0"></div>
                <div class="absolute left-0 top-5 h-1 bg-stone-700 -z-0 transition-all duration-500"
                    style="width: <%= order.status === 'Delivered' ? '100%' : (order.status === 'Shipped' ? '50%' : '25%') %>;">
                </div>

                <div class="relative z-10 flex flex-col items-center">
                    <div class="w-10 h-10 rounded-full bg-stone-700 flex items-center justify-center text-white mb-2">✓</div>
                    <span class="text-[10px] font-medium text-stone-600">Order Placed</span>
                </div>

                <div class="relative z-10 flex flex-col items-center">
                    <div class="w-10 h-10 rounded-full <%= ['Shipped', 'Out for Delivery', 'Delivered'].includes(order.status) ? 'bg-stone-700 text-white' : 'bg-white border-2 border-stone-200 text-stone-300' %> flex items-center justify-center mb-2">
                        <%= ['Shipped', 'Out for Delivery', 'Delivered'].includes(order.status) ? '✓' : '2' %>
                    </div>
                    <span class="text-[10px] font-medium text-stone-600">Shipped</span>
                </div>

                <div class="relative z-10 flex flex-col items-center">
                    <div class="w-10 h-10 rounded-full <%= ['Out for Delivery', 'Delivered'].includes(order.status) ? 'bg-stone-700 text-white' : 'bg-white border-2 border-stone-200 text-stone-300' %> flex items-center justify-center mb-2">
                        <%= ['Out for Delivery', 'Delivered'].includes(order.status) ? '✓' : '3' %>
                    </div>
                    <span class="text-[10px] font-medium text-stone-600">Out for Delivery</span>
                </div>

                <div class="relative z-10 flex flex-col items-center">
                    <div class="w-10 h-10 rounded-full <%= order.status === 'Delivered' ? 'bg-stone-700 text-white' : 'bg-white border-2 border-stone-200 text-stone-300' %> flex items-center justify-center mb-2">
                        <%= order.status==='Delivered' ? '✓' : '4' %>
                    </div>
                    <span class="text-[10px] font-medium text-stone-600">Delivered</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-stone-200 space-y-6">
                <div>
                    <h3 class="font-semibold text-stone-700 mb-4 border-b pb-2">Order Information</h3>
                    <div class="text-sm space-y-2">
                        <p><span class="font-semibold">Order ID:</span> #<%= order.orderId %></p>
                        <p><span class="font-semibold">Order Date:</span> <%= new Date(order.createdAt).toLocaleDateString() %></p>
                    </div>
                </div>

<div>
    <h3 class="font-semibold text-stone-700 mb-4 border-b pb-2">Product Details</h3>
    
    <% order.items.forEach(item => { %>
    <div class="flex gap-4 mb-4 items-center border-b pb-4 last:border-0">
        <img src="<%= item.image %>" class="w-20 h-20 object-cover rounded-lg border" alt="<%= item.productName %>">
        
        <div class="flex-1">
            <h4 class="text-sm font-bold text-stone-800"><%= item.productName %></h4>
            <div class="flex gap-3 mt-1">
                <p class="text-[10px] text-stone-500 uppercase font-bold">Size: <%= item.size %></p>
                <p class="text-[10px] text-stone-500 uppercase font-bold">Qty: <%= item.quantity %></p>
            </div>
            
            <div class="mt-2">
                <% if (item.status === 'Cancelled') { %>
                    <span class="text-[9px] px-2 py-0.5 rounded border font-black uppercase bg-red-50 text-red-600 border-red-200">
                        <%= item.status %>
                    </span>
                <% } else if (['Return Requested', 'Returned', 'Rejected'].includes(item.status)) { %>
                    <span class="text-[9px] px-2 py-0.5 rounded border font-black uppercase bg-orange-50 text-orange-600 border-orange-200">
                        <%= item.status %>
                    </span>
                <% } else if (item.status === 'Delivered') { %>
                    <span class="text-[9px] px-2 py-0.5 rounded border font-black uppercase bg-green-50 text-green-600 border-green-200">
                        Delivered
                    </span>
                <% } %>
            </div>
            
            <p class="text-sm font-bold text-[#C8A97E] mt-1">₹<%= item.price.toLocaleString() %></p>
        </div>

        <div class="flex flex-col gap-2">
          <% 
    const isItemCancelled = item.status === 'Cancelled';
    const isItemReturned = ['Returned', 'Return Requested'].includes(item.status); // NEW CHECK
    const isOrderDelivered = order.status === 'Delivered';
    const isOrderCancelled = order.status === 'Cancelled';
    const isOrderShipped = order.status === 'Shipped';
%>

     
         <% if (!isOrderDelivered && !isOrderShipped && !isItemCancelled && !isOrderCancelled && !isItemReturned) { %>
              <button onclick="cancelSingleItem('<%= order._id %>', '<%= item._id %>')" 
            class="text-[10px] px-4 py-1.5 bg-white border border-rose-300 text-rose-600 rounded font-black hover:bg-rose-50 transition-all uppercase tracking-wider">
               Cancel Item
              </button>
          <% } %>

            <% if (isOrderDelivered && !isItemCancelled && !['Return Requested', 'Returned'].includes(item.status)) { %>
                 <a href="/user/order-return/<%= order._id %>?productId=<%= item.productId._id || item.productId %>" 
                   class="text-[10px] text-center px-4 py-1.5 bg-[#C8A97E] text-white rounded font-black hover:brightness-110 transition-all uppercase tracking-wider">
                    Return Item
                </a>
            <% } %>

            <% if (isOrderDelivered && !isItemCancelled) { %>
                <button class="text-[10px] px-4 py-1.5 bg-stone-100 border border-stone-300 text-stone-600 rounded font-black hover:bg-stone-200 uppercase tracking-wider">
                    Write Review
                </button>
            <% } %>
        </div>
    </div>
    <% }) %>
</div>

            </div>

            <div class="bg-white p-2 rounded-xl shadow-sm border border-stone-200 hidden lg:block">
                <img src="<%= order.items[0].image %>" class="w-full h-full object-cover rounded-lg">
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded-xl border border-stone-200">
                <h3 class="font-semibold text-stone-700 mb-4">Delivery Address</h3>
                <div class="text-sm text-stone-600 space-y-1">
                    <p><%= order.address.street %></p>
                    <p><%= order.address.city %>, <%= order.address.state %> <%= order.address.zip %></p>
                    <p class="pt-2"><span class="font-bold">Phone:</span> <%= order.address.phone %></p>
                </div>
            </div>

            <div class="bg-white p-6 rounded-xl border border-stone-200">
                <h3 class="font-semibold text-stone-700 mb-4">Price Summary</h3>
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between"><span>Subtotal</span><span><%= formatPrice(order.total) %></span></div>
                    <div class="flex justify-between"><span>Shipping</span><span><%= order.shipping === 0 ? "FREE" : formatPrice(order.shipping) %></span></div>
                    <div class="flex justify-between font-bold text-lg border-t pt-2 text-stone-800">
                        <span>Total</span><span><%= formatPrice(order.total) %></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center pt-6">
           <a href="/user/orders/invoice/<%= order._id %>" 
              class="px-8 py-3 bg-stone-800 text-white rounded-lg text-sm font-bold shadow-md hover:bg-black transition-all inline-block">
               DOWNLOAD INVOICE
          </a>

            <% if (order.status !== 'Delivered' && order.status !== 'Cancelled' && order.status !== 'Returned' && order.status !== 'Return Requested'  && order.status !== 'Shipped') { %>
                <button onclick="confirmCancel('<%= order._id %>')" class="px-8 py-3 bg-red-50 text-red-600 border border-red-200 rounded-lg text-sm font-bold hover:bg-red-100 transition-all">
                    CANCEL ORDER
                </button>
            <% } %>
        </div>
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
    async function cancelSingleItem(orderId, itemId) {
    const result = await Swal.fire({
        title: 'Cancel this item?',
        text: "The proportional refund will be added to your wallet.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#be123c', 
        cancelButtonColor: '#57534e', 
        confirmButtonText: 'Yes, cancel it'
    });

    if (result.isConfirmed) {
        try {
            const response = await axios.patch('/user/orders/cancel-item',{orderId,itemId});
            if (response.data.success) {
                notyf.success(response.data.message)
               setTimeout(()=> location.reload(),1000)
            } else {
                notyf.error(response.data.message);
            }
        } catch (error) {
            console.error('Error:', error);
            notyf.error(error.response?.data?.message || 'Error cancelling item');        }
    }
}
        async function confirmCancel(id) {
            try {
                const response = await axios.patch(`/user/order-cancelled/${id}`);
                if (response.data.success) {
                    notyf.success(response.data.message);
                    setTimeout(() => { location.reload() }, 1000);
                } else {
                    notyf.error(response.data.message);
                }
            } catch (error) {
                const errorMsg = error.response?.data?.message || "Error cancelling order";
                notyf.error(errorMsg);
            }
        }
    </script>