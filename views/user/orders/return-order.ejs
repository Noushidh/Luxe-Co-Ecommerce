<% const formatPrice=(amount)=> {
    return new Intl.NumberFormat('en-IN', {
    style: 'currency',
    currency: 'INR',
    minimumFractionDigits: 2
    }).format(amount || 0);
    };
    %>

    <div class="min-h-screen flex flex-col md:flex-row p-4 md:p-8" style="background-color: #F5E9DA;">
        <aside class="w-full md:w-[260px] shrink-0 mb-8 md:mb-0 md:mr-8">
            <%- include("../../partials/user/sidebar") %>
        </aside>

        <div class="flex-grow max-w-5xl">

            <div class="mb-8">
                <h1 class="text-3xl font-bold text-stone-700 tracking-tight">Return Your Product</h1>
                <p class="text-stone-600 mt-2">We accept returns within 30 days. Ensure the item is in original
                    packaging.</p>
            </div>

            <div class="flex flex-col gap-6">
                <div class="bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden">
                    <div class="px-6 py-4 bg-stone-800 text-white flex justify-between items-center">
                        <h2 class="text-xs font-bold uppercase tracking-widest">Order Summary</h2>
                        <span class="text-[10px] font-bold opacity-70">Order ID: #<%= order.orderId %></span>
                    </div>

                    <div class="p-5 md:p-6 flex items-center gap-6">
                        <img src="<%= item.image %>"
                            class="w-20 h-20 md:w-28 md:h-28 rounded-xl object-cover ring-1 ring-stone-100 shadow-sm"
                            alt="Product">
                        <div class="flex-1">
                            <h3 class="text-lg font-bold text-stone-800 uppercase tracking-tight">
                                <%= item.productName %>
                            </h3>
                            <p class="text-xl font-black text-[#C8A97E] mt-1">
                                <%= formatPrice(item.price) %>
                            </p>
                            <p class="text-xs text-stone-400 mt-2 font-medium">Quantity: <%= item.quantity %> | Size:
                                    <%= item.size %>
                            </p>
                        </div>
                    </div>
                </div>

                <form id="returnForm" class="flex flex-col gap-6">
                    <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 md:p-8 space-y-6">
                        <h2
                            class="text-xs font-bold text-stone-400 uppercase tracking-widest mb-4 border-b border-stone-100 pb-2">
                            Return Details</h2>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label
                                    class="text-[10px] font-bold text-stone-700 uppercase tracking-widest px-1">Reason
                                    for Return</label>
                                <select name="reason"
                                    class="w-full bg-stone-50 border border-stone-200 rounded-lg px-4 py-3 text-sm font-bold text-stone-700 focus:ring-2 focus:ring-[#C8A97E] outline-none appearance-none cursor-pointer">
                                    <option value="">Select a reason</option>
                                    <option value="Damaged Product">Damaged Product</option>
                                    <option value="Wrong Item Received">Wrong Item Received</option>
                                    <option value="Quality issue">Quality Issue</option>
                                </select>
                            </div>

                            <div class="space-y-2">
                                <label
                                    class="text-[10px] font-bold text-stone-700 uppercase tracking-widest px-1">Refund
                                    Mode</label>
                                <select name="refundMode"
                                    class="w-full bg-stone-50 border border-stone-200 rounded-lg px-4 py-3 text-sm font-bold text-stone-700 focus:ring-2 focus:ring-[#C8A97E] outline-none">
                                    <option value="Wallet">Wallet (Instant)</option>
                                    <option value="Bank">Bank Transfer</option>
                                </select>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label
                                class="text-[10px] font-bold text-stone-700 uppercase tracking-widest px-1">Additional
                                Comments</label>
                            <textarea name="comments" rows="3" placeholder="Explain the issue..."
                                class="w-full bg-stone-50 border border-stone-200 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-[#C8A97E] outline-none"></textarea>
                        </div>
                    </div>

                    <!-- DELIVERY ADDRESS -->
                    <div class="bg-white rounded-xl shadow-md p-6 border">
                        <div class="flex justify-between items-center mb-4">
                            <h2 class="text-xl font-bold text-gray-800">PickUp Address</h2>

                            <a href="/user/address?from=return-order"
                                class="inline-block text-sm font-semibold text-[#4B3621] hover:underline">
                                + Add New Address & Edit address
                            </a>
                        </div>

                        <div class="grid grid-cols-1 gap-4">

                            <% if (addresses && addresses.length> 0) { %>
                                <% const hasDefault=addresses.some(a=> a.isDefault); %>
                                    <% addresses.forEach((addr, index)=> { %>
                                        <label
                                            class="relative border rounded-lg p-4 flex cursor-pointer hover:bg-stone-50 transition">
                                            <input type="radio" name="selectedAddress" value="<%= addr._id %>"
                                                class="mt-1 mr-3" <%=addr.isDefault || (!hasDefault && index===0)
                                                ? "checked" : "" %>
                                            />
                                            <div class="text-sm">
                                                <p class="font-bold flex items-center gap-2">
                                                    <%= addr.name %>
                                                        <% if (addr.isDefault) { %>
                                                            <span
                                                                class="text-xs bg-[#C8A97E] text-white px-2 py-0.5 rounded">
                                                                Default
                                                            </span>
                                                            <% } %>

                                                                <% if (addr.type) { %>
                                                                    <span
                                                                        class="text-xs bg-gray-200 px-2 py-0.5 rounded">
                                                                        <%= addr.type.toUpperCase() %>
                                                                    </span>
                                                                    <% } %>
                                                </p>

                                                <p>
                                                    <%= addr.street %>
                                                        <% if (addr.street2) { %>, <%= addr.street2 %>
                                                                <% } %>
                                                </p>

                                                <p>
                                                    <%= addr.city %>, <%= addr.state %> - <%= addr.pincode %>
                                                </p>

                                                <p class="text-gray-500 mt-1">
                                                    Phone: <%= addr.phone %>
                                                </p>
                                            </div>
                                        </label>
                                        <% }) %>

                                            <% } else { %>
                                                <p class="text-red-500 text-sm">
                                                    No addresses found. Please add one to continue.
                                                </p>
                                                <% } %>
                        </div>
                    </div>


                    <div class="flex flex-col sm:flex-row gap-4">
                        <% if (item.status==='Return Requested' ) { %>
                            <div
                                class="flex-1 p-4 bg-orange-50 border border-orange-200 rounded-lg flex items-center justify-center">
                                <p class="text-orange-700 font-bold text-xs uppercase tracking-widest text-center">
                                    Return Requested ⏳
                                </p>
                            </div>
                            <% } else { %>
                                <button type="button" onclick="handleReturnRequest(event)"
                                    class="flex-1 px-8 py-4 rounded-lg text-xs font-bold text-white shadow-sm transition-transform active:scale-95"
                                    style="background-color: #C8A97E;">
                                    SUBMIT RETURN REQUEST
                                </button>
                                <% } %>

                                    <button type="button" onclick="history.back()"
                                        class="sm:w-48 text-center px-8 py-4 rounded-lg text-xs font-bold text-stone-600 bg-white border border-stone-200">
                                        CANCEL
                                    </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
if (typeof window.notyf === 'undefined') {
        window.notyf = new Notyf({ 
            duration: 2000, 
            position: { x: 'right', y: 'top' } 
        });
    }  
         async function handleReturnRequest() {
            if (event) event.preventDefault();

            try {
                const reason = document.querySelector('select[name="reason"]').value;
                const refundMode = document.querySelector('select[name="refundMode"]').value;
                const comments = document.querySelector('textarea[name="comments"]').value;
                const selectedAddress = document.querySelector('input[name="selectedAddress"]:checked');

                if (!reason) return notyf.error("Please select a reason for return");
                if (!selectedAddress) return notyf.error("Please select an address");


                const data = { orderId: "<%= order._id %>", itemId: "<%= item._id %>", reason: reason, refundMode: refundMode, comments: comments, addressId: selectedAddress.value };
                console.log("Sending data to backend:", data); 
                const response = await axios.post('/user/order/return', data);

                if (response.data.success) {
                    notyf.success("Return request submitted successfully!");
                    setTimeout(() => { window.location.href = "/user/orders" }, 2000);
                }else{
                    notyf.error("eroor")
                }
            } catch (error) {
                console.error(error);
                notyf.error(error.response?.data?.message || "Error submitting return request");
            }
        }
    </script>