<% const formatPrice=(amount)=> { 
    return new Intl.NumberFormat('en-IN', { 
        style: 'currency', 
        currency: 'INR', 
        minimumFractionDigits: 2 
    }).format(amount || 0); 
}; %>

<div class="min-h-screen flex flex-col md:flex-row p-4 md:p-8" style="background-color: #F5E9DA;">
    <aside class="w-full md:w-[260px] shrink-0 mb-8 md:mb-0 md:mr-8">
        <%- include("../../partials/user/sidebar") %>
    </aside>

    <div class="flex-grow max-w-5xl">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-stone-700 tracking-tight">My Orders</h1>
            <p class="text-stone-600 mt-2">Track your orders and view your purchase history.</p>
        </div>

        <div class="mb-10 relative">
            <input type="text" id="orderSearch" placeholder="Search by Order ID or Product Name"
                class="w-full md:w-96 pl-4 pr-12 py-3 rounded-lg border border-stone-300 focus:ring-2 focus:ring-[#C8A97E] outline-none shadow-sm transition-all bg-white text-stone-700">
        </div>

        <div class="flex flex-col gap-6">
            <% if (orders && orders.length > 0) { %>
                <% orders.forEach(order => { %>
                    <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300 p-5 md:p-6 border border-stone-200">
                        
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-stone-100 pb-4 mb-4">
                            <div class="mb-2 sm:mb-0">
                                <h2 class="text-lg font-bold text-stone-800">#<%= order.orderId %></h2>
                                <p class="text-xs font-medium text-stone-400 mt-0.5 uppercase tracking-wide">
                                    Placed on <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
                                </p>
                            </div>

                            <% 
                            let badgeStyle=''; 
                            switch (order.status) { 
                                case 'Pending': badgeStyle='bg-stone-100 text-stone-600 border-stone-200'; break; 
                                case 'Confirmed': badgeStyle='bg-green-50 text-green-600 border-green-200'; break;
                                case 'Processing': badgeStyle='bg-blue-50 text-blue-600 border-blue-200'; break;
                                case 'Shipped': badgeStyle='bg-purple-50 text-purple-600 border-purple-200'; break; 
                                case 'Delivered': badgeStyle='bg-emerald-100 text-emerald-700 border-emerald-300'; break;
                                case 'Cancelled': badgeStyle='bg-red-50 text-red-600 border-red-200'; break; 
                                case 'Return Requested': badgeStyle='bg-orange-50 text-orange-600 border-orange-200'; break; 
                                default: badgeStyle='bg-gray-100 text-gray-600 border-gray-200';
                            } 
                            %>
                            <span class="inline-flex items-center px-4 py-1 border rounded-full text-xs font-bold uppercase tracking-widest <%= badgeStyle %>">
                                <%= order.status %>
                            </span>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-5 mb-6">
                            <% if (order.items && order.items.length > 0) { %>
                                <img src="<%= order.items[0].image %>" alt="Product" class="w-24 h-24 object-cover rounded-lg bg-stone-50 border border-stone-100">
                                <div class="flex-1 space-y-1">
                                    <h4 class="text-base font-semibold text-stone-700"><%= order.items[0].productName %></h4>
                                    <div class="flex items-center text-sm text-stone-500">
                                        <span>Quantity: <%= order.items[0].quantity %></span>
                                        <span class="mx-2 text-stone-300">|</span>
                                        <span class="font-medium text-stone-800"><%= formatPrice(order.total) %></span>
                                    </div>
                                    <% if(order.items.length > 1) { %>
                                        <p class="text-xs text-[#C8A97E] font-semibold italic">+ <%= order.items.length - 1 %> other items</p>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>

                        <div class="flex flex-wrap gap-3 pt-2">
                            <a href="/user/order-details/<%= order._id %>"
                                class="flex-1 sm:flex-none text-center px-8 py-2.5 rounded-lg text-xs font-bold text-white shadow-sm transition-transform active:scale-95"
                                style="background-color: #C8A97E;">
                                VIEW DETAILS
                            </a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="text-center py-24 bg-white rounded-2xl border-2 border-dashed border-stone-300">
                    <p class="text-stone-500 font-medium mb-6">You haven't placed any orders yet.</p>
                    <button onclick="window.location.href='/user/shop'" class="px-10 py-3 rounded-lg text-sm font-bold text-white shadow-md" style="background-color: #C8A97E;">
                        CONTINUE SHOPPING
                    </button>
                </div>
            <% } %>
        </div>
    </div>
</div>