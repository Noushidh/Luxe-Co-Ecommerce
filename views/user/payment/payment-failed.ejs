<div class="min-h-screen flex items-center justify-center px-4" style="background-color: #F5E9DA;">
    <div class="max-w-xl w-full bg-[#FCF8F2] rounded-[2.5rem] p-10 md:p-16 text-center shadow-[20px_20px_60px_#d1c6b9,-20px_-20px_60px_#ffffff] border border-white/50">
        
        <div class="mb-10 flex justify-center">
            <div class="w-20 h-20 bg-[#F5E9DA] rounded-full flex items-center justify-center shadow-[inset_6px_6px_12px_#d1c6b9,inset_-6px_-6px_12px_#ffffff]">
                <svg class="w-8 h-8 text-stone-500/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </div>
        </div>

        <h1 class="text-2xl md:text-3xl font-light text-stone-800 tracking-[0.2em] mb-4 uppercase italic">
            Transaction Paused
        </h1>
        
        <div class="w-16 h-[1px] bg-stone-300 mx-auto mb-8 opacity-60"></div>

        <p class="text-stone-500 font-light leading-relaxed mb-12 max-w-sm mx-auto text-sm tracking-wide">
            <%= reason || "An unexpected interruption occurred. Your account has not been charged, and your selection remains reserved in your bag." %>
        </p>

        <div class="flex flex-col space-y-5">
            <a href="/user/checkout" class="w-full py-4 bg-stone-900 text-stone-50 text-[11px] tracking-[0.3em] uppercase hover:bg-black transition-all duration-500 rounded-full shadow-lg">
                Re-attempt Payment
            </a>
            
            <a href="/user/cart" class="w-full py-4 bg-transparent border border-stone-300 text-stone-600 text-[11px] tracking-[0.3em] uppercase hover:bg-stone-100 transition-all duration-500 rounded-full">
                Back to Selection
            </a>
        </div>

        <p class="mt-12 text-[9px] text-stone-400 uppercase tracking-[0.4em]">
            Luxe & Co Concierge is available 24/7
        </p>
    </div>
</div>