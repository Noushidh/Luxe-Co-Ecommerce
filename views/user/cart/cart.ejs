<% // ---------------- HELPERS ---------------- const cart=locals.cart || []; const
    cartItemsCount=locals.cartItemsCount|| cart.length; const
    primaryBtnClass="w-full h-12 bg-[#4B3621] hover:bg-stone-700 text-white font-semibold rounded-lg transition duration-200"
    ; const formatter=new Intl.NumberFormat("en-IN", { style: "currency" , currency: "INR" , minimumFractionDigits: 2,
    maximumFractionDigits: 2, }); const formatPrice=(amount)=> {
    if (typeof amount !== "number") amount = parseFloat(amount) || 0;
    return formatter.format(amount);
    };
    // -----------------------------------------
    %>

    <div class="w-full min-h-screen bg-[#F5E9DA]">
        <div class="container mx-auto px-4 py-8 max-w-7xl">

            <h1 class="text-4xl font-extrabold text-gray-800 mb-8">Shopping Cart</h1>

            <div id="cart-content-wrapper">
                <% if (cartItemsCount===0) { %>
                    <div
                        class="flex flex-col items-center justify-center min-h-[400px] bg-white rounded-xl shadow-lg p-10">
                        <h2 class="text-2xl font-semibold text-gray-700 mb-2">Your Cart is Empty</h2>
                        <a href="/user/products"
                            class="<%= primaryBtnClass %> bg-[#C8A97E] flex items-center justify-center w-52 h-10">
                            Start Shopping
                        </a>
                    </div>

                    <% } else { %>

                        <div class="flex flex-col lg:flex-row gap-8">

                            <div class="flex-grow lg:w-3/5 space-y-4">

                                <% cart.forEach(item=> { %>
                                    <div class="flex p-4 bg-white rounded-xl shadow-md border"
                                        id="row-<%= item.variantId %>">

                                        <img src="<%= item.image %>"
                                            class="w-28 h-28 object-cover rounded-lg mr-4 border">

                                        <div class="flex-grow flex flex-col justify-between">
                                            <div>
                                                <h3 class="text-lg font-semibold">
                                                    <%= item.productId.name %>
                                                </h3>
                                                <p class="text-sm text-gray-500">
                                                    Size: <strong>
                                                        <%= item.size %>
                                                    </strong> |
                                                    Color: <strong>
                                                        <%= item.color %>
                                                    </strong>
                                                </p>
                                            </div>

                                            <div class="flex items-center space-x-2 mt-2">
                                                <span class="text-sm font-medium">Qty:</span>

                                                <button id="minus-btn-<%= item.variantId %>"
                                                    class="w-6 h-6 bg-gray-100 rounded-full hover:bg-gray-200 disabled:opacity-50"
                                                    onclick="updateQuantity('<%= item.variantId %>', <%= item.quantity - 1 %>)"
                                                    <%=item.quantity <=1 ? 'disabled' : '' %>>−</button>

                                                <input id="input-<%= item.variantId %>" type="number"
                                                    value="<%= item.quantity %>"
                                                    class="w-12 text-center border rounded bg-gray-50" readonly>

                                                <button id="plus-btn-<%= item.variantId %>"
                                                    class="w-6 h-6 bg-gray-100 rounded-full hover:bg-gray-200 disabled:opacity-50"
                                                    onclick="updateQuantity('<%= item.variantId %>', <%= item.quantity + 1 %>)"
                                                    <%=item.quantity>= 4 ? 'disabled' : '' %>>+</button>
                                            </div>
                                        </div>

                                        <div class="flex flex-col items-end justify-between ml-4">
                                         <p id="item-total-<%= item.variantId %>" class="text-lg font-bold">
                                           <%= formatPrice(item.rowTotal) %>
                                             </p>

                                            <button onclick="removeItem('<%= item.variantId %>')"
                                                class="text-red-500 hover:text-red-700 text-sm font-medium transition">
                                                Remove
                                            </button>
                                        </div>

                                    </div>
                                    <% }) %>

                            </div>

                            <div class="lg:w-2/5 bg-white rounded-xl shadow-lg p-6 h-fit border">
                                <h2 class="text-2xl font-semibold mb-6">Order Summary</h2>

                                <div class="space-y-3 text-gray-700">

                                    <!-- Subtotal -->
                                    <div class="flex justify-between">
                                        <span>Subtotal</span>
                                        <span id="summary-subtotal">
                                            <%= formatPrice(subTotal) %>
                                        </span>
                                    </div>

                                    <!-- Discount -->
                                    <div id="discount-row"
                                        class="<%= discount > 0 ? 'flex' : 'hidden' %> justify-between text-green-600">
                                        <span>Discount</span>
                                        <span id="summary-discount">
                                            - <%= formatPrice(discount) %>
                                        </span>
                                    </div>

                                    <!-- Shipping / Delivery -->
                                    <div class="flex justify-between">
                                        <span>Shipping</span>
                                        <span id="summary-shipping">
                                            <%= shipping===0 ? "FREE" : formatPrice(shipping) %>
                                        </span>
                                    </div>

                                </div>


                                <div class="border-t mt-4 pt-4 flex justify-between font-bold text-lg">
                                    <span>Total</span>
                                    <span id="summary-total">
                                        <%= formatPrice(total) %>
                                    </span>
                                </div><br>

                                <button onclick="handleCheckout(event)" class=" bg-[#C8A97E] <%= primaryBtnClass %>">
                                    Proceed to Checkout
                                </button>
                            </div>

                        </div>
                        <% } %>
            </div>
        </div>
    </div>
<script src="/js/utils.js"></script>
    <script>
        async function updateQuantity(variantId, newQty) {
            const notyf = new Notyf({ duration: 2000, position: { x: 'right', y: 'top' } });

            if (newQty < 1 || newQty > 4) return;

            try {
                const res = await axios.patch("/user/cart/update-quantity", { variantId, quantity: Number(newQty) });

                if (res.data.success) {
                    notyf.success(res.data.message);

                    setTimeout(() => {
                        window.location.reload();
                    }, 800);

                } else {
                    notyf.error(res.data.message);
                }
            } catch (err) {
                console.error(err);
                notyf.error("Failed to update cart");
            }
        }

        async function removeItem(variantId) {
            const notyf = new Notyf({ duration: 2000, position: { x: 'right', y: 'top' } });
            try {
                const response = await axios.delete(`/user/cart/remove-item/${variantId}`);
                if (response.data.success) {
                    notyf.success(response.data.message);
                    setTimeout(() => { window.location.reload(); }, 800);
                }
            } catch (err) {
                const errorMessage=error.response?.data?.message || "Something went wrong. Please try again.";
               notyf.error(errorMessage);
            }
        }

        async function handleCheckout(event) {
            const notyf = new Notyf({ duration: 2000, position: { x: 'right', y: 'top' } });
            const btn = event.currentTarget; 
            btn.disabled = true;
            const originalText = btn.innerText; 
            btn.innerText = "Processing...";
            try {
                const response = await axios.get('/user/cart/check-stock')
                if (response.data.success) {
                    window.location.href = response.data.redirect;
                } else {
                notyf.error(response.data.message);
                 btn.disabled = false;
                 btn.innerText = originalText;
                }
            } catch (error) {
                const errorMessage = error.response?.data?.message || "Something went wrong. Please try again.";
                notyf.error(errorMessage);
            btn.disabled = false;
            btn.innerText = originalText;
            }
        }
    </script>