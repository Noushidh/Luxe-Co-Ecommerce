<div class="min-h-screen bg-[#F5E9DA]">

    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col md:flex-row gap-8">

            <main class="flex-1">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
                    <div>
                        <h1 class="text-3xl font-bold text-stone-800">My Wishlist</h1>
                        <p class="text-stone-500 mt-1">Your saved favorites — move them to your cart anytime.</p>
                    </div>
                    <button onclick="clearWishlist()"
                        class="px-6 py-2 bg-[#C8A97E] text-white font-medium rounded hover:opacity-90 transition-opacity shadow-sm">
                        Clear All
                    </button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                    <% if (wishlist && wishlist.length> 0) { %>
                        <% wishlist.forEach(item=> { %>
                            <% const p=item.productId; const selectedVariant=p.variants.find(v=> v._id.toString() ===
                                item.variantId.toString());

                                let mainImg = "/images/placeholder.png";
                                if (selectedVariant && selectedVariant.images && selectedVariant.images[0]) {
                                mainImg = selectedVariant.images[0];
                                } else if (p.image) {
                                mainImg = p.image;
                                }

                                const finalPrice = p.price - (p.price * (p.discount / 100));
                                %>

                                <div
                                    class="group bg-white rounded-lg shadow-sm border border-stone-200 overflow-hidden hover:shadow-md transition-all flex flex-col h-full">

                                    <a href="/user/productDetails/<%= p._id %>?variantId=<%= item.variantId %>"
                                        class="relative block h-48 overflow-hidden">
                                        <img src="<%= mainImg %>"
                                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                            alt="<%= p.name %>" />

                                        <% if (p.discount> 0) { %>
                                            <div
                                                class="absolute top-2 left-2 bg-red-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded">
                                                -<%= p.discount %>%
                                            </div>
                                            <% } %>
                                    </a>

                                    <div class="p-3 flex flex-col flex-grow">
                                        <div class="flex-grow">
                                            <h3 class="text-sm font-semibold text-stone-800 line-clamp-1">
                                                <%= p.name %>
                                            </h3>
                                            <p class="text-[11px] text-stone-500 mt-0.5">
                                                <%= selectedVariant.color %> • <%= selectedVariant.size %>
                                            </p>

                                            <div class="flex items-center gap-2 mt-1">
                                                <span class="text-base font-bold text-stone-900">
                                                    ₹<%= finalPrice.toFixed(0) %>
                                                </span>
                                                <% if (p.discount> 0) { %>
                                                    <del class="text-stone-400 text-[11px]">
                                                        ₹<%= p.price.toFixed(0) %>
                                                    </del>
                                                    <% } %>
                                            </div>
                                        </div>

<div class="mt-3 grid grid-cols-1 gap-2">
    <% 
        const userCart = locals.cart || { items: [] };

        const isInCart = userCart.items && userCart.items.some(cartItem => 
            cartItem.variantId.toString() === item.variantId.toString()
        );
    %>

    <% if (isInCart) { %>
        <a href="/user/cart" 
           class="w-full py-2 bg-stone-100 text-stone-600 text-xs font-bold rounded text-center border border-stone-200 hover:bg-stone-200 transition-colors">
            IN CART - VIEW
        </a>
    <% } else { %>
        <button onclick="addToCart('<%= p._id %>', '<%= item.variantId %>')" 
                class="w-full py-2 bg-[#C8A97E] text-white text-xs font-bold rounded hover:brightness-95 transition-all">
            ADD TO CART
        </button>
    <% } %>

    <button onclick="removeFromWishlist('<%= item.variantId %>')"
            class="w-full py-2 bg-transparent text-stone-600 text-xs font-medium border border-stone-300 rounded hover:bg-red-50 hover:text-red-600 hover:border-red-200 transition-all">
        Remove
    </button>
</div>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <div class="col-span-full text-center py-12">
                                            <p class="text-stone-500">Your wishlist is empty</p>
                                            <a href="/user/products"
                                                class="text-sm text-[#C8A97E] underline mt-2 block">Continue
                                                Shopping</a>
                                        </div>
                                        <% } %>
                </div>
            </main>
        </div>
    </div>
</div>
<script>
     const notyf = new Notyf({ duration: 2500, position: { x: 'right', y: 'top' } });
    async function addToCart(productId, variantId) {
    const notyf = new Notyf({ duration: 2500, position: { x: 'right', y: 'top' } });

    try {
        const res = await axios.post('/user/cart/product/add', {
            productId: productId,
            variantId: variantId,
            quantity: 1 
        });

        if (res.data?.success) {
            notyf.success(res.data.message || "Added to cart");
            setTimeout(() => window.location.reload(), 1000); 
        }
    } catch (err) {
        notyf.error(err.response?.data?.message || "Could not add to cart");
    }
}

async function removeFromWishlist(variantId) {
    try{
        const response = await axios.patch('/user/wishlist/remove',{variantId})
           if (response.data?.success) {
            notyf.success(response.data.message);
            setTimeout(() => window.location.reload(), 1000); 
        }
    }catch(err){
        console.log(err)
      notyf.error(err.response?.data?.message || "Could not remove to wishlist"); 
    }
}
</script>