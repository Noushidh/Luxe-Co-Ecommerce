<div class="min-h-screen bg-[#F5E9DA]">
    
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col md:flex-row gap-8">

            <main class="flex-1">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
                    <div>
                        <h1 class="text-3xl font-bold text-stone-800">My Wishlist</h1>
                        <p class="text-stone-500 mt-1">Your saved favorites — move them to your cart anytime.</p>
                    </div>
                    <button onclick="clearWishlist()" class="px-6 py-2 bg-[#C8A97E] text-white font-medium rounded hover:opacity-90 transition-opacity shadow-sm">
                        Clear All
                    </button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% if (products && products.length > 0) { %>
                        <% products.forEach(p => { %>
                            <% 
                                let mainImg="/images/placeholder.png"; 
                                if (p && p.variants && p.variants[0] && p.variants[0].images && p.variants[0].images[0]) { 
                                    mainImg = p.variants[0].images[0]; 
                                } else if (p && p.image && p.image.trim() !== "") { 
                                    mainImg = p.image; 
                                } 
                            %>

                            <div class="group bg-white rounded-xl shadow-sm border border-stone-100 overflow-hidden hover:shadow-lg transition-all duration-300 flex flex-col">
                                <a href="/user/productDetails/<%= p._id %>" class="relative aspect-square overflow-hidden block">
                                    <img src="<%= mainImg %>" 
                                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                                         alt="<%= p.name %>" />
                                    
                                    <% if (p.discountPercentage > 0) { %>
                                        <div class="absolute top-3 right-3 bg-red-500 text-white text-[10px] font-bold px-2 py-1 rounded shadow-sm">
                                            <%= p.discountPercentage %>% OFF
                                        </div>
                                    <% } %>
                                </a>

                                <div class="p-5 flex-grow flex flex-col">
                                    <a href="/user/productDetails/<%= p._id %>" class="block">
                                        <h3 class="text-lg font-bold text-stone-800 hover:text-[#C8A97E] transition-colors line-clamp-1">
                                            <%= p.name %>
                                        </h3>
                                    </a>

                                    <div class="flex items-center gap-2 mt-2">
                                        <span class="text-xl font-bold text-stone-900">
                                            ₹<%= p.finalPrice.toFixed(0) %>
                                        </span>
                                        <% if (p.discountPercentage > 0) { %>
                                            <del class="text-stone-400 text-sm italic">
                                                ₹<%= p.price.toFixed(0) %>
                                            </del>
                                        <% } %>
                                    </div>

                                    <div class="mt-6 space-y-3">
                                        <button onclick="addToCart('<%= p._id %>')" 
                                                class="w-full py-3 bg-[#C8A97E] text-white font-bold rounded-md hover:bg-[#b89a6f] transition-colors shadow-sm">
                                            Add to Cart
                                        </button>
                                        
                                        <button onclick="removeFromWishlist('<%= p._id %>')" 
                                                class="w-full py-3 bg-white text-stone-600 font-semibold border border-stone-200 rounded-md hover:bg-stone-50 hover:text-red-600 hover:border-red-200 transition-all">
                                            Remove
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="col-span-full flex flex-col items-center justify-center py-20 bg-white/50 rounded-2xl border-2 border-dashed border-stone-300">
                            <h2 class="text-2xl font-semibold text-stone-700">Your wishlist is empty</h2>
                            <a href="/user/products" class="mt-6 px-8 py-3 bg-[#C8A97E] text-white font-bold rounded-md shadow-lg hover:shadow-xl transition-all">
                                Go Shopping
                            </a>
                        </div>
                    <% } %>
                </div>
            </main>
        </div>
    </div>
</div>