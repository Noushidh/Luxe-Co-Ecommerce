<% 
    let unblockedVariants = product.variants.filter(v => !v.isBlocked);
    let initialVariant = unblockedVariants[0];
    let initialImage = initialVariant?.images[0] || '/images/default.png';
    let uniqueSizes = [...new Set(unblockedVariants.map(v => v.size))].sort();
    let uniqueColors = [...new Set(unblockedVariants.map(v => v.color))];
    let initialImages = initialVariant?.images || [];
%>

<style>
    #zoomContainer {
        position: relative;
        cursor: crosshair;
    }

    #mainImage {
        background-repeat: no-repeat;
        opacity: 0;
        transition: opacity 0.3s;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    #visibleImage {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .active-size {
        outline: 2px solid #5D4037 !important;
        background-color: #5D4037 !important;
        color: white !important;
    }

    .active-color {
        outline: 3px solid #5D4037 !important;
    }

    .disabled-option {
        opacity: 0.5;
        pointer-events: none;
    }
</style>

<div class="bg-[#F5E9DA] border-b border-stone-300">
    <div class="max-w-7xl mx-auto px-6 py-3">
        <nav class="text-sm text-stone-600">
            <ol class="flex items-center gap-2">
                <li><a href="/user/products" class="text-[#C8A97E] hover:text-[#b6916a] font-semibold">Product</a>
                </li>
                <li class="text-stone-400">/</li>
                <li><a href="/user/products?category=<%= category %>"
                        class="text-[#C8A97E] hover:text-[#b6916a] font-semibold">
                        <%= category.charAt(0).toUpperCase() + category.slice(1) || 'All' %>
                    </a></li>
                <% if (subcategoryName) { %>
                    <li class="text-stone-400">/</li>
                    <li><span class="text-stone-700 font-semibold">
                            <%= subcategoryName %>
                        </span></li>
                <% } %>
                <li class="text-stone-400">/</li>
                <li class="text-stone-700 font-semibold">
                    <%= product.name %>
                </li>
            </ol>
        </nav>
    </div>
</div>

<div class="bg-[#F5E9DA] py-12">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <div>
                <div id="zoomContainer"
                    class="w-full h-96 bg-white rounded-lg shadow-md border border-stone-400 overflow-hidden relative mb-6"
                    onmousemove="zoom(event)" onmouseout="hideZoom()">
                    <% if (product.discount && product.discount > 0) { %>
                        <div
                            class="absolute top-4 right-4 bg-red-600 text-white text-sm font-bold px-3 py-1 rounded-full z-20 shadow-lg">
                            -<%= product.discount %>%</div>
                    <% } %>
                    <img id="visibleImage" src="<%= initialImage %>" alt="<%= product.name %>"
                        class="w-full h-full object-cover">
                    <div id="mainImage" class="w-full h-full object-cover transition-opacity duration-300">
                    </div>
                </div>

                <div id="thumbnailGallery" class="flex flex-wrap gap-3">
                    <% initialImages.forEach(img => { %>
                        <div class="w-28 h-28 bg-white rounded-lg outline outline-1 outline-offset-[-1px] outline-stone-400 cursor-pointer hover:opacity-80 transition"
                            onclick="changeMainImage(this.querySelector('img').src);">
                            <img src="<%= img %>" class="w-full h-full object-cover rounded-lg thumbImg" alt="Thumbnail">
                        </div>
                    <% }) %>
                </div>

                <div class="mt-6">
                    <span class="text-black text-base font-semibold">Colors:</span>
                    <div class="flex gap-3 mt-3">
                        <% uniqueColors.forEach(color => { %>
                            <div class="color-option w-10 h-10 rounded-full cursor-pointer transition outline outline-1 outline-offset-[-1px] outline-stone-400 hover:outline-2 <%= color === initialVariant?.color ? 'active-color' : '' %>"
                                data-color="<%= color %>" onclick="selectColor('<%= color %>')"
                                style="background-color: <%= color.toLowerCase() === 'black' ? '#000000' : (color.toLowerCase() === 'brown' ? '#5D4037' : color) %>;"
                                title="<%= color %>"></div>
                        <% }) %>
                    </div>
                </div>
                <input type="hidden" id="selectedColor" value="<%= initialVariant?.color || '' %>">
            </div>

            <div class="space-y-6">
                <h1 class="text-4xl font-bold text-stone-700">
                    <%= product.name %>
                </h1>
                <p class="text-neutral-900 text-base leading-7">
                    <%= product.description %>
                </p>

                <div class="flex items-center gap-4 border-b border-stone-200 pb-6">
                    <div class="text-3xl font-bold text-stone-700">
                        <% const finalPrice = product.price * (1 - (product.discount / 100)); %>
                        ₹<%= finalPrice.toFixed(2) %>
                    </div>
                    <% if (product.discount && product.discount > 0) { %>
                        <del class="text-lg font-semibold text-stone-400">₹<%= product.price.toFixed(2) %></del>
                    <% } %>
                </div>

                <div class="flex items-center gap-2">
                    <span class="text-yellow-500 text-lg">★★★★★</span>
                    <span class="text-stone-700 text-sm">(<%= product.reviews || 0 %> reviews)</span>
                </div>

                <div>
                    <h3 class="text-sm font-semibold text-stone-700 mb-3">Select Size</h3>
                    <div class="flex flex-wrap gap-3">
                        <% uniqueSizes.forEach(s => { %>
                            <button data-size="<%= s %>"
                                class="size-option flex items-center justify-center w-16 h-11 border-2 border-stone-400 rounded-full text-stone-700 font-medium text-sm hover:bg-stone-400 hover:text-white transition <%= s === initialVariant?.size ? 'active-size' : '' %>"
                                onclick="selectSize('<%= s %>')">
                                <%= s %>
                            </button>
                        <% }) %>
                    </div>
                    <input type="hidden" id="selectedSize" value="<%= initialVariant?.size || '' %>">
                </div>

                <div>
                    <h3 class="text-sm font-semibold text-stone-700 mb-3">Quantity</h3>
                    <div class="flex items-center gap-4">
                        <button id="decrementBtn"
                            class="w-10 h-10 border-2 border-stone-400 rounded-full flex items-center justify-center text-stone-700 font-bold hover:bg-stone-200 transition">−</button>
                        <span id="quantityDisplay" class="text-lg font-semibold text-stone-700">1</span>
                        <button id="incrementBtn"
                            class="w-10 h-10 border-2 border-stone-400 rounded-full flex items-center justify-center text-stone-700 font-bold hover:bg-stone-200 transition">+</button>
                    </div>
                    <div id="stockMessage" class="mt-3 text-sm text-green-600 font-medium">In Stock: <%=
                        initialVariant?.stock || 0 %> units</div>
                </div>

       <div class="space-y-3 pt-4">
       <button
        id="addToCartBtn"
        class="w-full h-14 bg-[#4B3621] hover:bg-stone-700 text-white font-semibold rounded-lg transition
         <%= initialVariant ? '' : 'disabled-option' %>">
       Add to Cart
      </button>


            </div>

                <div
                class="flex items-center gap-4 pt-6 border-t border-stone-300 mt-6 bg-[#F5E9DA] p-5 rounded-lg">

            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-[#C8A97E]" fill="none" 
            viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
             <path stroke-linecap="round" stroke-linejoin="round" 
          d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>

                    <div>
                        <p class="text-stone-800 font-semibold text-base">Free Worldwide Shipping</p>
                        <p class="text-stone-600 text-sm">On all orders above ₹500</p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="bg-white border-t-2 border-stone-400 py-16">
    <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-stone-700 mb-8">Product Details</h2>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <div>
                <h3 class="text-lg font-semibold text-stone-700 mb-4">Description</h3>
                <p class="text-neutral-900 text-sm leading-7 mb-6">
                    <%= product.description %>
                </p>

                <% if (product.highlights && product.highlights.length) { %>
                    <h3 class="text-lg font-semibold text-stone-700 mb-4">Highlights</h3>
                    <ul class="space-y-2">
                        <% product.highlights.forEach(h => { %>
                            <li class="flex items-start gap-3 text-stone-700 text-sm">
                                <span class="text-[#C8A97E] font-bold mt-0.5">•</span>
                                <%= h %>
                            </li>
                        <% }) %>
                    </ul>
                <% } %>
            </div>

            <div>
                <% if (product.material) { %>
                    <div class="mb-8">
                        <h3 class="text-lg font-semibold text-stone-700 mb-3">Material</h3>
                        <p class="text-neutral-900 text-sm">
                            <%= product.material %>
                        </p>
                    </div>
                <% } %>

                <% if (product.specifications && Object.keys(product.specifications).length) { %>
                    <div>
                        <h3 class="text-lg font-semibold text-stone-700 mb-4">Specifications</h3>
                        <table class="w-full text-sm">
                            <tbody>
                                <% 
                                    const specObj = product.specifications; 
                                    const specKeys = Object.keys(specObj || {}); 
                                    const isNumericSequence = specKeys.length > 0 && specKeys.every(k => /^\d+$/.test(k));
                                    
                                    if (isNumericSequence) {
                                        const ordered = specKeys
                                            .map(k => ({ idx: Number(k), val: specObj[k] }))
                                            .sort((a,b) => a.idx - b.idx)
                                            .map(x => x.val);
                                        const combined = ordered.join('');
                                %>
                                <tr class="border-b border-stone-200 last:border-b-0">
                                    <td class="py-3 font-semibold text-stone-700 w-1/3">Details</td>
                                    <td class="py-3 text-neutral-900">
                                        <%= combined %>
                                    </td>
                                </tr>
                                <% } else { %>
                                    <% Object.entries(specObj).forEach(([key, value]) => { %>  
                                        <tr class="border-b border-stone-200 last:border-b-0">
                                            <td class="py-3 font-semibold text-stone-700 w-1/3">
                                                <%= key %>
                                            </td>
                                            <td class="py-3 text-neutral-900">
                                                <%= value %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

