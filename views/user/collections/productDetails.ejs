<% 
    let unblockedVariants = product.variants.filter(v => !v.isBlocked);
    let initialVariant = unblockedVariants[0];
    let initialImage = initialVariant?.images[0] || '/images/default.png';
    let uniqueSizes = [...new Set(unblockedVariants.map(v => v.size))].sort();
    let uniqueColors = [...new Set(unblockedVariants.map(v => v.color))];
    let initialImages = initialVariant?.images || [];
%>

<style>
    #zoomContainer {
        position: relative;
        cursor: crosshair;
    }

    #mainImage {
        background-repeat: no-repeat;
        opacity: 0;
        transition: opacity 0.3s;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    #visibleImage {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .active-size {
        outline: 2px solid #5D4037 !important;
        background-color: #5D4037 !important;
        color: white !important;
    }

    .active-color {
        outline: 3px solid #5D4037 !important;
    }

    .disabled-option {
        opacity: 0.5;
        pointer-events: none;
    }
    /*review animation*/
@keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}
.animate-fade-in {
    animation: fade-in 0.4s ease forwards;
}
</style>

