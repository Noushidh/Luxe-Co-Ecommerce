<script>
/* ===================== GLOBAL DATA ===================== */

const productData = window.productData || {};
const hasVariants =
  Array.isArray(productData.variants) && productData.variants.length > 0;

let selectedColor = document.getElementById('selectedColor')?.value || '';
let selectedSize = document.getElementById('selectedSize')?.value || '';
let quantity = 1;

/* ===================== VARIANT HELPERS ===================== */

function findCurrentVariant() {
  return productData.variants?.find(
    v => v.color === selectedColor && v.size === selectedSize && !v.isBlocked
  );
}

/* ===================== GALLERY ===================== */

function updateGallery(images) {
  const thumbnailGallery = document.getElementById('thumbnailGallery');
  thumbnailGallery.innerHTML = '';

  if (!images || images.length === 0) {
    thumbnailGallery.innerHTML =
      '<p class="text-sm text-red-500">No images available.</p>';
    document.getElementById('visibleImage').src = '/images/default.png';
    return;
  }

  images.forEach(img => {
    const div = document.createElement('div');
    div.className =
      "w-28 h-28 bg-white rounded-lg outline outline-1 outline-offset-[-1px] outline-stone-400 cursor-pointer hover:opacity-80 transition";
    div.onclick = () => changeMainImage(img);

    const imgEl = document.createElement('img');
    imgEl.src = img;
    imgEl.className = "w-full h-full object-cover rounded-lg";
    div.appendChild(imgEl);

    thumbnailGallery.appendChild(div);
  });

  changeMainImage(images[0]);
}

/* ===================== STOCK ===================== */

function updateStock(variant) {
  const stockMessage = document.getElementById('stockMessage');
  const addToCartBtn = document.getElementById('addToCartBtn');

  if (!variant) {
    stockMessage.textContent = 'Variant unavailable';
    stockMessage.className = 'mt-3 text-sm text-red-600 font-medium';
    addToCartBtn.disabled = true;
    return;
  }

  if (variant.stock > 0) {
    stockMessage.textContent = `In Stock: ${variant.stock} units`;
    stockMessage.className = 'mt-3 text-sm text-green-600 font-medium';
    addToCartBtn.disabled = false;
  } else {
    stockMessage.textContent = 'Out of Stock';
    stockMessage.className = 'mt-3 text-sm text-red-600 font-medium';
    addToCartBtn.disabled = true;
  }
}

/* ===================== COLOR & SIZE (INLINE USES) ===================== */

window.selectColor = function (color) {
  selectedColor = color;
  document.getElementById('selectedColor').value = color;

  document.querySelectorAll('.color-option')
    .forEach(c => c.classList.remove('active-color'));

  document.querySelector(`.color-option[data-color="${color}"]`)
    ?.classList.add('active-color');

  const colorVariants =
    productData.variants.filter(v => v.color === color && !v.isBlocked);

  let newSize = null;

  document.querySelectorAll('.size-option').forEach(btn => {
    const size = btn.dataset.size;
    const available = colorVariants.some(v => v.size === size);

    btn.classList.remove('active-size');
    btn.classList.toggle('disabled-option', !available);

    if (!newSize && available) newSize = size;
  });

  selectedSize = newSize;
  document.getElementById('selectedSize').value = newSize || '';

  if (newSize) {
    document
      .querySelector(`.size-option[data-size="${newSize}"]`)
      ?.classList.add('active-size');
  }

  const variant = findCurrentVariant();

if (variant && document.getElementById('selectedVariantId')) {
        document.getElementById('selectedVariantId').value = variant._id;
    }

  updateGallery(variant?.images || []);
  updateStock(variant);
};

window.selectSize = function (size) {
  selectedSize = size;
  document.getElementById('selectedSize').value = size;

  document.querySelectorAll('.size-option')
    .forEach(s => s.classList.remove('active-size'));

  document
    .querySelector(`.size-option[data-size="${size}"]`)
    ?.classList.add('active-size');

  const variant = findCurrentVariant();

  if (variant && document.getElementById('selectedVariantId')) {
        document.getElementById('selectedVariantId').value = variant._id;
    }

  updateGallery(variant?.images || []);
  updateStock(variant);
};

/* ===================== IMAGE ===================== */

window.changeMainImage = function (src) {
  document.getElementById('visibleImage').src = src;
  document.getElementById('mainImage').style.backgroundImage = `url('${src}')`;
};

/* ===================== ZOOM (INLINE WORKS) ===================== */

window.zoom = function (e) {
  const mainImage = document.getElementById('mainImage');
  const zoomContainer = document.getElementById('zoomContainer');
  const rect = zoomContainer.getBoundingClientRect();
  const zoomLevel = 2.5;

  mainImage.style.opacity = '1';
  mainImage.style.backgroundSize =
    `${rect.width * zoomLevel}px ${rect.height * zoomLevel}px`;

  const x = (e.clientX - rect.left) / rect.width;
  const y = (e.clientY - rect.top) / rect.height;

  const posX = -x * rect.width * (zoomLevel - 1);
  const posY = -y * rect.height * (zoomLevel - 1);

  mainImage.style.backgroundPosition =
    `${posX}px ${posY}px`;
};

window.hideZoom = function () {
  document.getElementById('mainImage').style.opacity = '0';
};


document.addEventListener('DOMContentLoaded', () => {
  const addToCartBtn = document.getElementById('addToCartBtn');
  const quantityDisplay = document.getElementById('quantityDisplay');
  const incBtn = document.getElementById('incrementBtn');
  const decBtn = document.getElementById('decrementBtn');

  incBtn.onclick = () => {
    const v = findCurrentVariant();
    quantity = Math.min(quantity + 1, v?.stock || 1);
    quantityDisplay.textContent = quantity;
  };

  decBtn.onclick = () => {
    quantity = Math.max(1, quantity - 1);
    quantityDisplay.textContent = quantity;
  };

  updateStock(findCurrentVariant());

  addToCartBtn.onclick = async () => {
      if (addToCartBtn.disabled) return;
    const notyf = new Notyf({ duration: 2500, position: { x: 'right', y: 'top' } });

    const variant = findCurrentVariant();
    if (!variant) return notyf.error("Select size & color");

    addToCartBtn.disabled = true;
    addToCartBtn.textContent = 'Adding...';

    try {
      const res = await axios.post('/user/cart/product/add', { productId: productData._id,size: selectedSize,color: selectedColor,quantity});

      if (res.data?.success) {
        notyf.success(res.data.message);
        updateCartCount(res.data.cartCount);
        window.location.reload();
      } else {
        notyf.error(res.data?.message || "Could not add item to cart.");
      }
    } catch(err) {
     const msg =err.response?.data?.message ||"Something went wrong";
       notyf.error(msg);
    } finally {
      addToCartBtn.disabled = false;
      addToCartBtn.textContent = 'Add to Cart';
    }
  };
});

async function toggleWishlist() {
    const notyf = new Notyf({duration: 3000,position: { x: 'right', y: 'top' }});
    const variantInput = document.getElementById('selectedVariantId');
    const productId = window.productData._id;
    const variantId = variantInput ? variantInput.value : null;
    if (!variantId || variantId === "undefined") {
        return notyf.error("Please select a valid size and color first.");
    }

    try {
        const response = await axios.post('/user/wishlist/add', { variantId,productId});
        if (response.data.success) {
            notyf.success(response.data.message);
        }
    } catch (err) {
        notyf.error(err.response?.data?.message || "Error adding to wishlist");
    }
}

/* ===================== SELECT BY ID ===================== */
window.selectVariantById = function(variantId) {
    const variant = productData.variants.find(v => v._id.toString() === variantId.toString());
    
    if (variant) {
        selectColor(variant.color);
        selectSize(variant.size);
            } else {
        console.warn("Variant ID not found in product data:", variantId);
    }
};

document.addEventListener("DOMContentLoaded", function() {
    const targetVariantId = "<%= initialVariantId %>";

    if (targetVariantId && targetVariantId !== "null" && targetVariantId !== "") {
            selectVariantById(targetVariantId);
    }
});
