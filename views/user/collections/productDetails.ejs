        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <div>
                <h3 class="text-lg font-semibold text-stone-700 mb-4">Description</h3>
                <p class="text-neutral-900 text-sm leading-7 mb-6">
                    <%= product.description %>
                </p>

                <% if (product.highlights && product.highlights.length) { %>
                    <h3 class="text-lg font-semibold text-stone-700 mb-4">Highlights</h3>
                    <ul class="space-y-2">
                        <% product.highlights.forEach(h => { %>
                            <li class="flex items-start gap-3 text-stone-700 text-sm">
                                <span class="text-[#C8A97E] font-bold mt-0.5">•</span>
                                <%= h %>
                            </li>
                        <% }) %>
                    </ul>
                <% } %>
            </div>

            <div>
                <% if (product.material) { %>
                    <div class="mb-8">
                        <h3 class="text-lg font-semibold text-stone-700 mb-3">Material</h3>
                        <p class="text-neutral-900 text-sm">
                            <%= product.material %>
                        </p>
                    </div>
                <% } %>

                <% if (product.specifications && Object.keys(product.specifications).length) { %>
                    <div>
                        <h3 class="text-lg font-semibold text-stone-700 mb-4">Specifications</h3>
                        <table class="w-full text-sm">
                            <tbody>
                                <% 
                                    const specObj = product.specifications; 
                                    const specKeys = Object.keys(specObj || {}); 
                                    const isNumericSequence = specKeys.length > 0 && specKeys.every(k => /^\d+$/.test(k));
                                    
                                    if (isNumericSequence) {
                                        const ordered = specKeys
                                            .map(k => ({ idx: Number(k), val: specObj[k] }))
                                            .sort((a,b) => a.idx - b.idx)
                                            .map(x => x.val);
                                        const combined = ordered.join('');
                                %>
                                <tr class="border-b border-stone-200 last:border-b-0">
                                    <td class="py-3 font-semibold text-stone-700 w-1/3">Details</td>
                                    <td class="py-3 text-neutral-900">
                                        <%= combined %>
                                    </td>
                                </tr>
                                <% } else { %>
                                    <% Object.entries(specObj).forEach(([key, value]) => { %>  
                                        <tr class="border-b border-stone-200 last:border-b-0">
                                            <td class="py-3 font-semibold text-stone-700 w-1/3">
                                                <%= key %>
                                            </td>
                                            <td class="py-3 text-neutral-900">
                                                <%= value %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

