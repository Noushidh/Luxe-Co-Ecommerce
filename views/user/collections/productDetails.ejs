<div class="bg-[#F5E9DA] py-16">
    <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-stone-800 mb-8">You May Also Like</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <% relProds.forEach(prod => { %>

                <a href="/user/productDetails/<%= prod._id %>" class="block 
                    bg-white 
                    rounded-lg 
                    shadow-md 
                    overflow-hidden 
                    hover:shadow-xl 
                    transform 
                    hover:scale-[1.03]  transition 
                    duration-300 
                    ease-in-out 
                    cursor-pointer">

                    <div class="w-full h-56 bg-[#F5E9DA] flex items-center justify-center">
                        <img src="<%= prod.image %>" alt="<%= prod.name %>" class="w-full h-full object-cover">
