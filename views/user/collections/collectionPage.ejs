<%
    const totalDocs = totalDocuments || 0; 
%>

<div class="w-full min-h-screen bg-[#F5E9DA] p-4 md:p-6 flex flex-col lg:flex-row gap-6">

    <div class="w-full lg:w-64">
        <%- include("../../partials/user/filter", { sizes: sizes, category: category, price: price, selectedSize: selectedSize }) %>
    </div>

    <div class="flex-1">
        <div class="flex flex-col md:flex-row justify-between items-start mb-6 gap-4">
            <div>
                <h1 class="text-2xl font-bold text-stone-800 mb-2">Collections</h1>
                <p class="text-gray-600">Discover our curated luxury footwear collection</p>
            </div>

            <div class="relative inline-block text-left w-full md:w-auto">
                <button id="sortBtn"
                    class="flex items-center justify-between md:justify-start gap-2 w-full md:w-auto px-5 py-2.5 bg-[#C8A97E] text-white font-semibold rounded-lg shadow hover:bg-[#b6916a] transition">
                    Sort By
                    <svg class="w-4 h-4 transition-transform" id="sortArrow" fill="none" stroke="currentColor"
                        stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                <div id="sortDropdown"
                    class="hidden absolute right-0 mt-2 w-full md:w-56 bg-white rounded-lg shadow-lg border border-stone-300 z-50">
                    <ul class="py-2 text-sm text-stone-700 max-h-40 overflow-y-auto">
                        <li>
                            <button data-sort="price_asc"
                                class="w-full text-left px-4 py-2 hover:bg-stone-100 transition">
                                Price: Lower to Higher
                            </button>
                        </li>
                        <li>
                            <button data-sort="price_desc"
                                class="w-full text-left px-4 py-2 hover:bg-stone-100 transition">
                                Price: Higher to Lower
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
            <% if (products && products.length > 0) { %>
                <% products.forEach(p => { %>
                    <% 
                        let mainImg="/images/placeholder.png"; 
                        if (p && p.variants && p.variants[0] && p.variants[0].images && p.variants[0].images[0]) { 
                            mainImg = p.variants[0].images[0]; 
                        } else if (p && p.image && p.image.trim() !== "") { 
                            mainImg = p.image; 
                        } 
                    %>

     <div class="group relative bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col">
    <a href="/user/productDetails/<%= p._id %>" class="block cursor-pointer flex-1">
        <div class="relative h-64 bg-stone-100 overflow-hidden">
            <img src="<%= mainImg %>" 
                 class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                 alt="<%= p.name %>" />
            
            <% if (p.discountPercentage > 0) { %>
                <div class="absolute top-2 right-2 bg-red-600 text-white text-[10px] font-bold px-2 py-1 rounded-md shadow-md z-10 animate-pulse">
                    <%= p.discountPercentage %>% OFF
                </div>
            <% } %>
        </div>

        <div class="p-4 border-t border-stone-50">
            <h3 class="text-lg font-semibold text-stone-800 truncate">
                <%= p.name %>
            </h3>

            <div class="flex items-center gap-2 mt-1">
                <span class="text-stone-900 font-bold text-lg">
                    ₹<%= p.finalPrice.toFixed(0) %>
                </span>

                <% if (p.discountPercentage > 0) { %>
                    <del class="text-stone-400 text-sm">
                        ₹<%= p.price.toFixed(0) %>
                    </del>
                <% } %>
            </div>
        </div>
    </a>
</div>
                <% }) %>
            <% } else { %>
                <div class="col-span-full text-center text-stone-600 text-lg py-20">
                    No products found for these filters.
                </div>
            <% } %>
        </div>
        
        <% 
            const buildQs = (newPage) => {
                let currentParams = [];
                if (category) currentParams.push(`category=${encodeURIComponent(category)}`);
                if (price) currentParams.push(`price=${price}`);
                if (selectedSize) currentParams.push(`size=${selectedSize}`); 
                if (sort) currentParams.push(`sort=${sort}`); 
                currentParams.push(`page=${newPage}`);
                return currentParams.join("&");
            };
        %>

        <% if (totalPages >= 1 && totalDocs > 0) { %>
            <div class="flex flex-wrap justify-center items-center gap-2 md:gap-3 mt-12 pb-10">
                <% if (currentPage > 1) { %>
                    <a href="?<%= buildQs(currentPage - 1) %>"
                        class="w-10 h-10 flex items-center justify-center rounded-full bg-[#E7D7C3] hover:bg-[#D8C4A8] text-gray-800 transition">
                        «
                    </a>
                <% } %>

                <% for (let i = 1; i <= totalPages; i++) { %>
                    <a href="?<%= buildQs(i) %>"
                        class="w-10 h-10 flex items-center justify-center rounded-full text-sm font-semibold transition
                            <%= i === currentPage 
                                ? 'bg-[#C8A97E] text-white shadow-md' 
                                : 'bg-[#E7D7C3] text-gray-800 hover:bg-[#D8C4A8]' 
                            %>">
                        <%= i %>
                    </a>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <a href="?<%= buildQs(currentPage + 1) %>"
                        class="w-10 h-10 flex items-center justify-center rounded-full bg-[#E7D7C3] hover:bg-[#D8C4A8] text-gray-800 transition">
                        »
                    </a>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<script>
    const notyf = new Notyf({duration: 3000,position: { x: 'right', y: 'top' }});
    const sortBtn = document.getElementById("sortBtn");
    const sortDropdown = document.getElementById("sortDropdown");
    const sortArrow = document.getElementById("sortArrow");

    sortBtn.addEventListener("click", () => {
        sortDropdown.classList.toggle("hidden");
        sortArrow.classList.toggle("rotate-180");
    });

    document.addEventListener("click", (e) => {
        if (!sortBtn.contains(e.target) && !sortDropdown.contains(e.target)) {
            sortDropdown.classList.add("hidden");
            sortArrow.classList.remove("rotate-180");
        }
    });

    document.querySelectorAll("#sortDropdown button").forEach(btn => {
        btn.addEventListener("click", () => {
            const sortType = btn.getAttribute("data-sort");
            const currentUrl = new URL(window.location.href);
            const params = currentUrl.searchParams;

            params.delete("sort");
            params.delete("page"); 

            if (sortType) {
                params.set("sort", sortType);
            }
            window.location.href = currentUrl.pathname + "?" + params.toString();
        });
    });

</script>