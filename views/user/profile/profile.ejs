<div class="min-h-screen bg-[#F5E9DA]">

    <div class="w-full px-4 md:px-6 py-6 md:py-10">

        <div class="flex flex-col md:flex-row items-start gap-6 md:gap-12 max-w-7xl mx-auto">

            <aside class="w-full md:w-[230px] shrink-0">
                <%- include("../../partials/user/sidebar") %>
            </aside>

            <section class="w-full lg:max-w-[1000px] bg-white rounded-2xl shadow p-5 md:p-8 relative">

                <a href="/user/profile/edit" class="static mb-6 md:absolute md:top-6 md:right-6 bg-[#C8A97E] text-white
                  px-6 py-2 rounded-lg text-sm flex items-center justify-center gap-2
                  hover:opacity-90 transition w-full md:w-auto">
                    ✏️ Edit
                </a>

                <h2 class="text-xl md:text-2xl font-bold text-stone-800 mb-6 md:mb-10">
                    Personal Information
                </h2>

                <div class="flex justify-center mb-8 md:mb-10">
                    <div class="w-24 h-24 md:w-32 md:h-32 rounded-full border-4 border-stone-400
            flex items-center justify-center bg-stone-50 overflow-hidden">

                        <% if (userData.profilePic) { %>
                            <img src="<%= userData.profilePic %>?v=<%= Date.now() %>"
                                class="w-full h-full object-cover rounded-full" />
                            <% } else { %>
                                <span class="text-3xl">👤</span>
                                <% } %>

                    </div>
                </div>

                <div class="space-y-6 md:space-y-8">

                    <div>
                        <label class="block text-sm font-medium text-stone-700 mb-2">
                            Full Name
                        </label>
                        <p class="px-4 py-3 border border-stone-300 rounded-lg bg-stone-50 break-words">
                            <%= userData.fullname %>
                        </p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-stone-700 mb-2">
                            Email
                        </label>
                        <p class="px-4 py-3 border border-stone-300 rounded-lg bg-stone-50 break-words">
                            <%= userData.email %>
                        </p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-stone-700 mb-2">
                            Phone
                        </label>

                        <% if (userData.phone) { %>
                            <p class="px-4 py-3 border border-stone-300 rounded-lg bg-stone-50">
                                <%= userData.phone %>
                            </p>
                            <% } else { %>
                                <p class="px-4 py-3 border border-dashed border-stone-300 rounded-lg text-stone-400">
                                    Not added
                                </p>
                                <a href="/user/profile/edit" class="text-sm text-[#C8A97E] mt-2 inline-block">
                                    + Add phone number
                                </a>
                                <% } %>
                    </div>

                    <div class="pt-6 md:pt-8 border-t border-stone-200">

                        <label class="block text-sm font-medium text-stone-700 mb-3">
                            Referral Code
                        </label>

                        <div class="bg-stone-200 rounded-xl px-4 md:px-6 py-4
                        flex justify-between items-center">

                            <span id="referralCode" class="text-base md:text-lg font-semibold tracking-wide text-stone-800">
                                <%= userData.referralCode %>
                            </span>

                            <button type="button" onclick="copyReferralCode()"
                                class="text-sm font-medium hover:underline text-[#C8A97E] md:text-stone-800">
                                Copy
                            </button>
                        </div>

                        <p class="text-center text-sm text-stone-600 mt-4">
                            Share your code and both of you will get 
                            <strong>₹1000</strong> in wallet
                        </p>

                    </div>

                </div>
            </section>

        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
function copyReferralCode() {
    const code = document.getElementById('referralCode').innerText;
    const tempInput = document.createElement("input");
    tempInput.value = code;
    document.body.appendChild(tempInput);
    tempInput.select();
    tempInput.setSelectionRange(0, 99999); 
    document.execCommand("copy");
    document.body.removeChild(tempInput);
    Swal.fire({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 2000,
        timerProgressBar: true,
        background: '#FAF7F2',
        icon: 'success',
        title: 'Referral Code Copied'
    });
}
</script>