<% // ---------------- HELPERS ---------------- const
  primaryBtnClass="w-full h-12 bg-[#4B3621] hover:bg-stone-700 text-white font-semibold rounded-lg transition duration-200 uppercase tracking-wider"
  ; const formatter=new Intl.NumberFormat("en-IN", { style: "currency" , currency: "INR" }); const
  formatPrice=(amount)=> formatter.format(amount || 0);
  // -----------------------------------------
  %>

  <div class="w-full min-h-screen bg-[#F5E9DA] pb-12">
    <div class="container mx-auto px-4 py-8 max-w-7xl">
      <h1 class="text-4xl font-extrabold text-gray-800 mb-8">Checkout</h1>

      <% if (checkoutitemcount===0) { %>
        <!-- EMPTY -->
        <div class="flex flex-col items-center justify-center min-h-[400px] bg-white rounded-xl shadow-lg p-10">
          <h2 class="text-2xl font-semibold text-gray-700 mb-2">
            Your Checkout is empty
          </h2>
          <a href="/user/products"
            class="<%= primaryBtnClass %> bg-[#C8A97E] flex items-center justify-center w-52 h-10 mt-4">
            Start Shopping
          </a>
        </div>

        <% } else { %>

          <div class="flex flex-col lg:flex-row gap-8">

            <!-- LEFT -->
            <div class="flex-grow lg:w-3/5 space-y-6">

              <!-- REVIEW ITEMS -->
              <div class="space-y-4">
                <h2 class="text-xl font-bold text-gray-800">Review Items</h2>

                <% checkout.forEach(item=> { %>
                  <div class="flex p-4 bg-white rounded-xl shadow-sm border items-center">
                    <img src="<%= item.image %>" class="w-20 h-20 object-cover rounded-lg mr-4 border" />

                    <div class="flex-grow">
                      <h3 class="font-semibold text-gray-800">
                        <%= item.productId.name %>
                      </h3>
                      <p class="text-xs text-gray-500">
                        Size: <%= item.size %> | Color: <%= item.color %>
                      </p>
                      <p class="text-sm font-medium mt-1">
                        Qty: <%= item.quantity %>
                      </p>
                    </div>

                    <div class="text-right">
                      <p class="font-bold text-lg">
                       <%# Use itemTotal which already contains (finalPrice * quantity) %>
                       <%= formatPrice(item.itemTotal) %>
                    </p>
                    
                    </div>
                  </div>
                  <% }) %>
              </div>

              <!-- DELIVERY ADDRESS -->
              <div class="bg-white rounded-xl shadow-md p-6 border">
                <div class="flex justify-between items-center mb-4">
                  <h2 class="text-xl font-bold text-gray-800">Delivery Address</h2>

                  <a href="/user/address?from=checkout"
                    class="inline-block text-sm font-semibold text-[#4B3621] hover:underline">
                    + Add New Address & Edit address
                  </a>
                </div>

                <div class="grid grid-cols-1 gap-4">

                  <% if (addresses && addresses.length> 0) { %>

                    <% const hasDefault=addresses.some(a=> a.isDefault); %>

                      <% addresses.forEach((addr, index)=> { %>
                        <label class="relative border rounded-lg p-4 flex cursor-pointer hover:bg-stone-50 transition">

                          <input type="radio" name="selectedAddress" value="<%= addr._id %>" class="mt-1 mr-3"
                            <%=addr.isDefault || (!hasDefault && index===0) ? "checked" : "" %>
                          />

                          <div class="text-sm">
                            <p class="font-bold flex items-center gap-2">
                              <%= addr.name %>

                                <% if (addr.isDefault) { %>
                                  <span class="text-xs bg-[#C8A97E] text-white px-2 py-0.5 rounded">
                                    Default
                                  </span>
                                  <% } %>

                                    <% if (addr.type) { %>
                                      <span class="text-xs bg-gray-200 px-2 py-0.5 rounded">
                                        <%= addr.type.toUpperCase() %>
                                      </span>
                                      <% } %>
                            </p>

                            <p>
                              <%= addr.street %>
                                <% if (addr.street2) { %>, <%= addr.street2 %>
                                    <% } %>
                            </p>

                            <p>
                              <%= addr.city %>, <%= addr.state %> - <%= addr.pincode %>
                            </p>

                            <p class="text-gray-500 mt-1">
                              Phone: <%= addr.phone %>
                            </p>
                          </div>
                        </label>
                        <% }) %>

                          <% } else { %>
                            <p class="text-red-500 text-sm">
                              No addresses found. Please add one to continue.
                            </p>
                            <% } %>

                </div>
              </div>
            </div>

            <!-- RIGHT -->
            <div class="lg:w-2/5 space-y-6">
              <div class="bg-white rounded-xl shadow-lg p-6 border h-fit sticky top-6">

                <h2 class="text-2xl font-semibold mb-6">Order Summary</h2>

                <!-- COUPON -->
       <div class="mb-4">
    <label class="block text-sm font-medium text-gray-700 mb-2">Have a Coupon?</label>
    <div class="flex gap-2">
        <input type="text" id="couponInput" placeholder="Enter code"
            value="<%= locals.appliedCouponCode ? appliedCouponCode : '' %>"
            <%= locals.appliedCouponCode ? 'disabled' : '' %>
            class="flex-grow border rounded-lg px-3 py-2 text-sm focus:ring-1 focus:ring-[#C8A97E] outline-none uppercase font-mono font-bold <%= locals.appliedCouponCode ? 'bg-gray-100 text-gray-500' : '' %>" />
        
        <% if (locals.appliedCouponCode) { %>
            <button onclick="removeCoupon()"
                class="bg-red-500 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-red-600 transition active:scale-95">
                Remove
            </button>
        <% } else { %>
            <button onclick="applyCoupon()"
                class="bg-[#C8A97E] text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-[#b8986d] transition active:scale-95">
                Apply
            </button>
        <% } %>
    </div>
    <p id="couponMessage" class="text-[10px] mt-1 hidden"></p>
</div>

<% if (locals.coupons && coupons.length > 0) { %>
    <div class="mb-6">
        <button onclick="toggleCouponList()"
            class="text-[#4B3621] text-xs font-bold flex items-center gap-1 hover:underline mb-3 uppercase tracking-tight">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 11h.01M7 15h.01M13 7h.01M13 11h.01M13 15h.01M17 7h.01M17 11h.01M17 15h.01" />
            </svg>
            Available & Upcoming Offers (<%= coupons.length %>)
        </button>

        <div id="couponList" class="hidden space-y-3 max-h-64 overflow-y-auto pr-2 custom-scrollbar">
            <% coupons.forEach(coupon => { 
                const isLocked = subTotal < coupon.minPurchase;
                const progress = Math.min((subTotal / coupon.minPurchase) * 100, 100);
                const isCurrentlyApplied = locals.appliedCouponCode && appliedCouponCode === coupon.code;
            %>
                <div class="border-2 rounded-xl p-3 transition-all relative group 
                    <%= isLocked ? 'border-gray-200 bg-gray-50/50' : 'border-dashed border-[#C8A97E] bg-white shadow-sm' %>
                    <%= isCurrentlyApplied ? 'ring-2 ring-red-400 border-red-400' : '' %>">
                    
                    <div class="flex justify-between items-start mb-2">
                        <div>
                            <div class="flex items-center gap-2">
                                <p class="font-mono font-bold text-sm <%= isLocked ? 'text-gray-400' : 'text-[#4B3621]' %> uppercase tracking-wider">
                                    <%= coupon.code %>
                                </p>
                                <% if (isLocked) { %>
                                    <span class="text-[8px] bg-gray-200 text-gray-500 px-1.5 py-0.5 rounded uppercase font-bold">Locked</span>
                                <% } else if (isCurrentlyApplied) { %>
                                    <span class="text-[8px] bg-red-100 text-red-600 px-1.5 py-0.5 rounded uppercase font-bold">Applied</span>
                                <% } else { %>
                                    <span class="text-[8px] bg-green-100 text-green-600 px-1.5 py-0.5 rounded uppercase font-bold animate-pulse">Available</span>
                                <% } %>
                            </div>

                            <p class="text-[11px] font-bold mt-1 <%= isLocked ? 'text-gray-400' : 'text-green-600' %>">
                                Save <%= coupon.discountType === 'percentage' ? coupon.discountValue + '%' : '₹' + coupon.discountValue %>
                            </p>
                        </div>

                        <% if (isCurrentlyApplied) { %>
                            <button onclick="removeCoupon()"
                                class="text-[10px] px-3 py-1.5 rounded-md font-bold transition-all shadow-sm bg-red-600 text-white hover:bg-red-700">
                                REMOVE
                            </button>
                        <% } else { %>
                            <button onclick="copyAndFill('<%= coupon.code %>')" <%= isLocked ? 'disabled' : '' %>
                                class="text-[10px] px-3 py-1.5 rounded-md font-bold transition-all shadow-sm
                                <%= isLocked ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-[#C8A97E] text-white hover:brightness-110' %>">
                                <%= isLocked ? 'LOCKED' : 'APPLY' %>
                            </button>
                        <% } %>
                    </div>

                    <% if (isLocked) { %>
                        <div class="mt-2">
                            <div class="flex justify-between items-center mb-1">
                                <p class="text-[9px] text-red-500 font-semibold">
                                    Add ₹<%= (coupon.minPurchase - subTotal).toFixed(0) %> more to unlock
                                </p>
                                <p class="text-[8px] text-gray-400"><%= progress.toFixed(0) %>%</p>
                            </div>
                            <div class="w-full bg-gray-200 h-1 rounded-full overflow-hidden">
                                <div class="bg-[#C8A97E] h-full transition-all duration-500" style="width: <%= progress %>%"></div>
                            </div>
                        </div>
                    <% } else if (!isCurrentlyApplied) { %>
                        <p class="text-[9px] text-gray-500 mt-1 italic font-medium text-green-600">Reached minimum purchase of ₹<%= coupon.minPurchase %></p>
                    <% } %>
                </div>
            <% }) %>
        </div>
    </div>
<% } else { %>
    <div class="mb-6 p-4 border-2 border-dotted border-stone-200 rounded-xl bg-stone-50/50 flex items-center gap-3">
        <p class="text-[11px] text-stone-500 font-medium">No special coupons available at this moment.</p>
    </div>
<% } %>

                      <!-- SUMMARY -->
                      <div class="space-y-3 text-gray-700">
                        <div class="flex justify-between">
                          <span>Subtotal</span>
                          <span>
                            <%= formatPrice(subTotal) %>
                          </span>
                        </div>

                        <% if (offerDiscount> 0) { %>
                          <div class="flex justify-between text-green-600 font-medium">
                            <span>Product Offer Savings</span>
                            <span>- <%= formatPrice(offerDiscount) %></span>
                          </div>
                          <% } %>

                      <% if (couponDiscount > 0) { %>
                       <div class="flex justify-between items-center bg-green-50 p-2 rounded-lg border border-dashed border-green-200">
                        <div>
                         <p class="text-green-700 font-semibold text-sm">Coupon Applied</p>
                         <p class="text-[10px] text-green-600 uppercase font-mono"><%= appliedCouponCode %></p>
                        </div>
                        <span class="text-green-700 font-bold">- <%= formatPrice(couponDiscount) %></span>
                        </div>
                         <% } %>

                            <div class="flex justify-between">
                              <span>Shipping</span>
                              <span>
                                <%= shipping===0 ? "FREE" : formatPrice(shipping) %>
                              </span>
                            </div>

                            <div class="border-t mt-4 pt-4 flex justify-between font-bold text-xl">
                              <span>Total Amount</span>
                              <span>
                                <%= formatPrice(total) %>
                              </span>
                            </div>

                            <div class="bg-[#fdf8f3] p-3 rounded-xl border border-[#C8A97E]/20 text-center">
                            <p class="text-[#C8A97E] text-xs font-bold uppercase tracking-wider">
                             Total Savings on this order: <%= formatPrice(totalDiscount) %>
                             </p>
                             </div>
                            </div>

                      <button onclick="processPayment()" class="<%= primaryBtnClass %> mt-8 bg-[#C8A97E] shadow-lg">
                        Continue to Payment
                      </button>

                      <p class="text-[10px] text-center text-gray-400 mt-4">
                        By clicking, you agree to our Terms & Conditions
                      </p>

              </div>
            </div>

          </div>

          <% } %>
    </div>
  </div>
  <style>
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #C8A97E;
      border-radius: 10px;
    }
  </style>
  <script>

    async function processPayment() {
      try {
        const selected = document.querySelector('input[name="selectedAddress"]:checked');
        if (!selected) {
          return notyf.error("Please select an address");
        }

        const addressId = selected.value;

        const response = await fetch(`/user/payment?addressId=${addressId}`, {
          method: 'GET',
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });

        const contentType = response.headers.get("content-type");

        if (!response.ok) {
          if (contentType && contentType.includes("application/json")) {
            const errorData = await response.json();
            throw new Error(errorData.message || "Invalid request. Please check your address.");
          }
          throw new Error(`Server error: ${response.status}`);
        }

        window.location.href = `/user/payment?addressId=${addressId}`;

      } catch (error) {
        console.error("Payment Error:", error);
        notyf.error(error.message);
      }
    }

    function toggleCouponList() {
      const list = document.getElementById('couponList');
      list.classList.toggle('hidden');
    }

    function copyAndFill(code) {
      const input = document.getElementById('couponInput');
      input.value = code;
      input.focus();
    }

    async function applyCoupon() {
      const code = document.getElementById('couponInput').value;
      if (!code) return notyf.error("Please enter a code");
      try{
       const response = await axios.post('/user/apply-coupon',{code})
       if(response.data.success){
        notyf.success(response.data.message);
        setTimeout(()=>location.reload(),1000)
       }else{
        notyf.error(response.data.message)
       }
      }catch(error){
        notyf.error(error.response?.data?.message || "Error coupon Applied");
      }
    }

async function removeCoupon() {
    try {
        const response = await axios.patch('/user/remove-coupon');
        
        if (response.data.success) {
            window.location.reload(); 
        }
    } catch (error) {
        console.error("Remove Coupon Error:", error);
        const msg = document.getElementById('couponMessage');
        if (msg) {
            msg.textContent = "Failed to remove coupon";
            msg.classList.remove('hidden');
        }
    }
}
  </script>