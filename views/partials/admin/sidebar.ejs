<!-- SIDEBAR (fixed) -->
<aside class="fixed top-[103px] left-0 w-[230px] 
    h-[calc(100vh-103px)] bg-white shadow-md 
    flex flex-col justify-between overflow-y-auto">

    <!-- MENU ITEMS -->
    <div class="mt-2 space-y-1">

        <!-- Dashboard (ALWAYS COLORED) -->
        <a href="/admin/dashboard"
           class="group w-full flex items-center gap-3 py-3 cursor-pointer
           bg-[#EEE4D4] text-[#C8A97E] font-bold shadow-sm
           hover:bg-[#e0d4c2]
           hover:shadow-lg hover:shadow-[#c8a97e]/30
           hover:scale-[1.03]
           transition-all duration-200 transform-gpu rounded-md">

            <div class="w-1 h-12 bg-[#c8a97e] rounded-r"></div>
            <img class="w-5 h-5 ml-3" src="https://c.animaapp.com/mi8qitnhNI1H79/img/span-8.svg" />
            <span class="text-[#c8a97e] font-medium text-sm">Dashboard</span>
        </a>

        <!-- Products -->
        <a href="/admin/products"
           class="group w-full flex items-center gap-3 py-3 cursor-pointer
           hover:-translate-y-[1px] hover:translate-x-[3px]
           hover:shadow-md hover:shadow-[#c8a97e]/20
           hover:scale-[1.01] transition-all duration-200 rounded-md
           <%= currentPath === '/admin/products'
             ? 'bg-[#EEE4D4] text-[#C8A97E] font-bold shadow-sm'
             : 'hover:bg-[#f5f0ea] text-stone-600'
           %>">

            <img class="w-5 h-5 ml-6" src="https://c.animaapp.com/mi8qitnhNI1H79/img/span-4.svg" />
            <span class="font-medium text-sm">Products</span>
        </a>

        <!-- Categories -->
        <a href="/admin/category"
           class="group w-full flex items-center gap-3 py-3 cursor-pointer
           hover:-translate-y-[1px] hover:translate-x-[3px]
           hover:shadow-md hover:shadow-[#c8a97e]/20
           hover:scale-[1.01] transition-all duration-200 rounded-md
           <%= currentPath === '/admin/category'
             ? 'bg-[#EEE4D4] text-[#C8A97E] font-bold shadow-sm'
             : 'hover:bg-[#f5f0ea] text-stone-600'
           %>">

            <img class="w-5 h-5 ml-6" src="https://c.animaapp.com/mi8qitnhNI1H79/img/span-5.svg" />
            <span class="font-medium text-sm">Categories</span>
        </a>

        <!-- Orders -->
        <a href="/admin/orders"
           class="group w-full flex items-center gap-3 py-3 cursor-pointer
           hover:-translate-y-[1px] hover:translate-x-[3px]
           hover:shadow-md hover:shadow-[#c8a97e]/20
           hover:scale-[1.01] transition-all duration-200 rounded-md
           <%= currentPath === '/admin/orders'
             ? 'bg-[#EEE4D4] text-[#C8A97E] font-bold shadow-sm'
             : 'hover:bg-[#f5f0ea] text-stone-600'
           %>">

            <img class="w-5 h-5 ml-6" src="https://c.animaapp.com/mi8qitnhNI1H79/img/span.svg" />
            <span class="font-medium text-sm">Orders</span>
        </a>

        <!-- Customers -->
        <a href="/admin/customers"
           class="group w-full flex items-center gap-3 py-3 cursor-pointer
           hover:-translate-y-[1px] hover:translate-x-[3px]
           hover:shadow-md hover:shadow-[#c8a97e]/20
           hover:scale-[1.01] transition-all duration-200 rounded-md
           <%= currentPath === '/admin/customers'
             ? 'bg-[#EEE4D4] text-[#C8A97E] font-bold shadow-sm'
             : 'hover:bg-[#f5f0ea] text-stone-600'
           %>">

            <img class="w-5 h-5 ml-6" src="https://c.animaapp.com/mi8qitnhNI1H79/img/span-2.svg" />
            <span class="font-medium text-sm">Customers</span>
        </a>

        <!-- Analytics -->
        <a href="/admin/sales-report"
           class="group w-full flex items-center gap-3 py-3 cursor-pointer
           hover:-translate-y-[1px] hover:translate-x-[3px]
           hover:shadow-md hover:shadow-[#c8a97e]/20
           hover:scale-[1.01] transition-all duration-200 rounded-md
           <%= currentPath === '/admin/analytics'
             ? 'bg-[#EEE4D4] text-[#C8A97E] font-bold shadow-sm'
             : 'hover:bg-[#f5f0ea] text-stone-600'
           %>">

            <img class="w-5 h-5 ml-6" src="https://c.animaapp.com/mi8qitnhNI1H79/img/span-5.svg" />
            <span class="font-medium text-sm">Analytics</span>
        </a>

        <!-- Coupons -->
        <a href="/admin/coupons"
           class="group w-full flex items-center gap-3 py-3 cursor-pointer
           hover:-translate-y-[1px] hover:translate-x-[3px]
           hover:shadow-md hover:shadow-[#c8a97e]/20
           hover:scale-[1.01] transition-all duration-200 rounded-md
           <%= currentPath === '/admin/coupons'
             ? 'bg-[#EEE4D4] text-[#C8A97E] font-bold shadow-sm'
             : 'hover:bg-[#f5f0ea] text-stone-600'
           %>">

            <img class="w-5 h-5 ml-6" src="https://c.animaapp.com/mi8qitnhNI1H79/img/span-6.svg" />
            <span class="font-medium text-sm">Coupons</span>
        </a>

        <!-- Banner -->
        <a href="/admin/banner"
           class="group w-full flex items-center gap-3 py-3 cursor-pointer
           hover:-translate-y-[1px] hover:translate-x-[3px]
           hover:shadow-md hover:shadow-[#c8a97e]/20
           hover:scale-[1.01] transition-all duration-200 rounded-md
           <%= currentPath === '/admin/banner'
             ? 'bg-[#EEE4D4] text-[#C8A97E] font-bold shadow-sm'
             : 'hover:bg-[#f5f0ea] text-stone-600'
           %>">

            <img class="w-5 h-5 ml-6" src="https://c.animaapp.com/mi8qitnhNI1H79/img/span-7.svg" />
            <span class="font-medium text-sm">Banner</span>
        </a>

        <!-- Offers -->
        <a href="/admin/offers"
           class="group w-full flex items-center gap-3 py-3 cursor-pointer
           hover:-translate-y-[1px] hover:translate-x-[3px]
           hover:shadow-md hover:shadow-[#c8a97e]/20
           hover:scale-[1.01] transition-all duration-200 rounded-md
           <%= currentPath === '/admin/offers'
             ? 'bg-[#EEE4D4] text-[#C8A97E] font-bold shadow-sm'
             : 'hover:bg-[#f5f0ea] text-stone-600'
           %>">

            <img class="w-5 h-5 ml-6" src="https://c.animaapp.com/mi8qitnhNI1H79/img/span-3.svg" />
            <span class="font-medium text-sm">Offers</span>
        </a>

        <!-- Settings -->
        <a href="/admin/settings"
           class="group w-full flex items-center gap-3 py-3 cursor-pointer
           hover:-translate-y-[1px] hover:translate-x-[3px]
           hover:shadow-md hover:shadow-[#c8a97e]/20
           hover:scale-[1.01] transition-all duration-200 rounded-md
           <%= currentPath === '/admin/settings'
             ? 'bg-[#EEE4D4] text-[#C8A97E] font-bold shadow-sm'
             : 'hover:bg-[#f5f0ea] text-stone-600'
           %>">

            <img class="w-5 h-5 ml-6" src="https://c.animaapp.com/mi8qitnhNI1H79/img/span-1.svg" />
            <span class="font-medium text-sm">Settings</span>
        </a>

    </div>

    <!-- Logout -->
    <form action="/admin/logout" method="get">
        <button class="flex items-center justify-center gap-2 
        bg-[#C8A97E] text-[#2c2c2c] 
        px-5 py-2.5 rounded-xl mx-4 mb-4 
        font-medium text-sm cursor-pointer
        hover:shadow-lg hover:shadow-[#c8a97e]/40
        hover:scale-[1.05]
        transition-all duration-200">
            <img class="w-[18px] h-[18px]" src="https://c.animaapp.com/mi8qitnhNI1H79/img/frame.svg" />
            <span>Logout</span>
        </button>
    </form>

</aside>
