<aside class="w-64 bg-white p-6 shadow-md rounded-lg">
    <h2 class="text-base font-bold text-stone-700 mb-6 tracking-wide">
        Filters
    </h2>

    <div class="mb-8">
        <label for="category" class="block text-base font-semibold text-stone-700 mb-3">
            Category
        </label>

        <select id="category"
            class="w-full px-3 py-2 rounded-lg border border-stone-400 bg-white text-sm text-stone-700">
            <option value="" <%=category==="" ? 'selected' : '' %>>All</option>
            <option value="men" <%=category==="men" ? 'selected' : '' %>>Men</option>
            <option value="women" <%=category==="women" ? 'selected' : '' %>>Women</option>
            <option value="kids" <%=category==="kids" ? 'selected' : '' %>>Kids</option>
        </select>
    </div>

    <div class="mb-8">
        <label for="subcategory" class="block text-base font-semibold text-stone-700 mb-3">
            Styles
        </label>
        <select id="subcategory"
            class="w-full px-3 py-2 rounded-lg border border-stone-400 bg-white text-sm text-stone-700">

            <option value="">All</option>

            <% subcategories.forEach(sc => { %>
                <option 
                    data-category="<%= (sc.category || '').toString().toLowerCase() %>" 
                    value="<%= sc._id %>" 
                    class="subcategory-option"
                    <%= currentSubcategory === sc._id.toString() ? "selected" : "" %>
                >
                    <%= sc.subcategory %>
                </option>
            <% }) %>
        </select>
    </div>


    <div class="mb-8">
        <label class="block text-sm font-semibold text-stone-700 mb-3">
            Size
        </label>

        <div class="grid grid-cols-3 gap-3">
            <% sizes 
                .filter(s => !isNaN(s) && Number(s) > 0 && Number(s) <= 20) 
                .sort((a, b) => Number(a) - Number(b))
                .forEach(s => { 
                // Assuming 'selectedSize' holds the currently applied size parameter
            %>
                <button type="button" class="size-btn w-16 h-11 flex items-center justify-center rounded 
                border border-[#C8A97E] text-sm transition-all duration-200
                <%= selectedSize == s 
                    ? 'bg-[#C8A97E] text-white' 
                    : 'bg-white text-stone-700 hover:bg-[#C8A97E] hover:text-white' %>" data-size="<%= s %>">
                    <%= s %>
                </button>
            <% }) %>
        </div>
    </div>

    <div class="mb-6">
        <label class="block text-sm font-semibold text-stone-700 mb-3">
            Price Range
        </label>

        <style>
            input[type="radio"] {
                accent-color: #5D4037; 
            }
        </style>

        <div class="space-y-3 text-sm text-stone-700">
            <% 
                // Define the price ranges and check if the 'price' variable matches
                const priceRanges = [
                    { value: "0-1000", label: "Under ₹1000" },
                    { value: "1000-3000", label: "₹1000 - ₹3000" },
                    { value: "3000-6000", label: "₹3000 - ₹6000" },
                    { value: "6000+", label: "Over ₹6000" }
                ];
            %>
            <% priceRanges.forEach(range => { %>
                <label class="flex items-center gap-3">
                    <input type="radio" name="price" value="<%= range.value %>" 
                        <%=price===range.value ? "checked" : "" %> >
                    <%= range.label %>
                </label>
            <% }) %>

        </div>
    </div>


<div class="mt-4">
    <a href="/user/products" 
       class="block w-full py-3 px-6 text-center rounded-full border-2 border-[#C8A97E] 
              bg-[#2D1B14] text-[#C8A97E] font-semibold text-lg
              hover:bg-[#C8A97E] hover:text-[#2D1B14] transition-all duration-300 shadow-md">
        Clear Filters
    </a>
</div>


</aside>


<script>

    function filterSubcategories() {
        const selectedCategory = document.getElementById("category").value;
        const subcategorySelect = document.getElementById("subcategory");
        const subcategoryOptions = document.querySelectorAll(".subcategory-option");

        let selectedOptionVisible = subcategorySelect.value === "";

        subcategoryOptions.forEach(option => {
            const optionCategory = option.dataset.category;
            if (!optionCategory) return; 
            
            const isVisible = (selectedCategory === "" || optionCategory === selectedCategory);
            option.style.display = isVisible ? '' : 'none';

            if (isVisible && option.selected) {
                selectedOptionVisible = true;
            }
        });

        if (!selectedOptionVisible && subcategorySelect.value !== "") {
            subcategorySelect.value = "";
        }
    }



    function applyFiltersAndRedirect(changedFilterType = null, changedValue = null) {
        const url = new URL(window.location.href);
        
        url.searchParams.delete('page');

        const category = document.getElementById("category").value;
        if (category) url.searchParams.set("category", category);
        else url.searchParams.delete("category");

        const subcategory = document.getElementById("subcategory").value;
        if (subcategory) url.searchParams.set("subcategory", subcategory);
        else url.searchParams.delete("subcategory");

        const price = document.querySelector("input[name='price']:checked");
        if (price) url.searchParams.set("price", price.value);
        else url.searchParams.delete("price");

        if (changedFilterType === 'size') {
            const currentSize = url.searchParams.get('size');
            if (currentSize === changedValue) {
                url.searchParams.delete('size');
            } else {
                url.searchParams.set('size', changedValue);
            }
        } else {
        }

        window.location.href = url.toString();
    }



    document.addEventListener('DOMContentLoaded', () => {
        filterSubcategories(); 

        document.getElementById("category").addEventListener("change", () => {
             filterSubcategories(); 
             applyFiltersAndRedirect(); 
        });

        document.getElementById("subcategory").addEventListener("change", applyFiltersAndRedirect);

        document.querySelectorAll(".size-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                const sizeValue = btn.dataset.size;
                applyFiltersAndRedirect('size', sizeValue);
            });
        });

        document.querySelectorAll("input[name='price']").forEach(radio => {
             radio.addEventListener("change", applyFiltersAndRedirect);
        });
        
        document.getElementById("applyFilters").addEventListener("click", applyFiltersAndRedirect);
    });
</script>