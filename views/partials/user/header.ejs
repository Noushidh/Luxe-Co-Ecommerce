<%
    const currentCategory = (typeof category === "string")
        ? category.toLowerCase()
        : "";
%>

<style>
    @keyframes smoothFadeInDown {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .slow-load-header { opacity: 0; animation: smoothFadeInDown 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .slow-load-1 { animation-delay: 0.2s; }
    .slow-load-2 { animation-delay: 0.5s; }
    .slow-load-3 { animation-delay: 0.8s; }
</style>

<header class="w-full bg-[#2B1B17] h-20 shadow-md flex items-center z-50 relative">
    <div class="max-w-7xl mx-auto w-full px-6 flex items-center justify-between">

        <!-- LOGO -->
        <div class="text-white text-3xl font-serif font-bold tracking-wide slow-load-header slow-load-1">
            <a href="/user" aria-label="Luxe & Co Shop" class="hover:text-[#C8A97E]">
                Luxe &amp; Co
            </a>
        </div>

        <!-- DESKTOP MENU -->
        <nav class="hidden md:flex items-center space-x-10 text-white text-sm slow-load-header slow-load-2">
            <a href="/user/products"
               class="hover:text-[#C8A97E] transition <%= currentCategory === '' ? 'text-[#C8A97E] font-semibold' : '' %>">
                All
            </a>

            <a href="/user/products?category=men"
               class="hover:text-[#C8A97E] transition <%= currentCategory === 'men' ? 'text-[#C8A97E] font-semibold' : '' %>">
                Men
            </a>

            <a href="/user/products?category=women"
               class="hover:text-[#C8A97E] transition <%= currentCategory === 'women' ? 'text-[#C8A97E] font-semibold' : '' %>">
                Women
            </a>

            <a href="/user/products?category=kids"
               class="hover:text-[#C8A97E] transition <%= currentCategory === 'kids' ? 'text-[#C8A97E] font-semibold' : '' %>">
                Kids
            </a>
        </nav>

        <!-- RIGHT SIDE -->
        <div class="flex items-center space-x-6 slow-load-header slow-load-3">

            <!-- SEARCH (ALL USERS) -->
            <div class="relative hidden md:block">
                <input type="text" placeholder="Search..."
                       class="pl-4 pr-9 py-2 rounded-full bg-white/10 text-sm text-white
                       placeholder:text-stone-300 outline-none border border-white/20
                       focus:ring-2 focus:ring-[#C8A97E]">
                <svg class="w-4 h-4 text-stone-200 absolute right-3 top-2.5"
                     fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="7"></circle>
                    <line x1="16" y1="16" x2="20" y2="20"></line>
                </svg>
            </div>

            <% if (user) { %>
                <!-- LOGGED-IN USER ICONS -->

                <!-- WISHLIST -->
                <a href="/wishlist" class="hover:scale-110 transition">
                    <svg class="w-6 h-6 text-[#C8A97E]" fill="none" stroke="currentColor" stroke-width="2"
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0
                              00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                </a>

                <!-- CART -->
                <a href="/cart" class="hover:scale-110 transition">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="1.8"
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M6 6h15l-1.5 9h-12L5 3H2"/>
                        <circle cx="9" cy="20" r="1.3"/>
                        <circle cx="18" cy="20" r="1.3"/>
                    </svg>
                </a>

                <!-- PROFILE -->
                <a href="/user/profile" class="hover:scale-110 transition">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="1.7"
                         viewBox="0 0 24 24">
                        <circle cx="12" cy="7" r="4"/>
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M4 21c0-4 4-7 8-7s8 3 8 7"/>
                    </svg>
                </a>

                <!-- LOGOUT -->
                <button onclick="handleLogout()" class="hover:scale-110 transition">
                    <svg class="w-7 h-7 text-red-400" fill="none" stroke="currentColor" stroke-width="2"
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M17 16l4-4m0 0l-4-4m4 4H7"/>
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M7 4h6a4 4 0 014 4v8a4 4 0 01-4 4H7"/>
                    </svg>
                </button>

            <% } else { %>
                <!-- GUEST USER BUTTONS -->

                <a href="/user/login"
                   class="px-4 py-2 text-sm border border-[#C8A97E] text-[#C8A97E]
                          rounded-full hover:bg-[#C8A97E] hover:text-black transition">
                    Login
                </a>

                <a href="/user/register"
                   class="px-4 py-2 text-sm bg-[#C8A97E] text-black
                          rounded-full hover:opacity-90 transition">
                    Register
                </a>
            <% } %>

            <!-- MOBILE MENU BUTTON -->
            <button id="mobileMenuBtn" class="md:hidden text-white hover:scale-110 transition">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2"
                     viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>
        </div>
    </div>
</header>

<!-- MOBILE MENU -->
<div id="mobileMenu"
     class="fixed top-20 left-0 w-full bg-[#2B1B17] text-white py-6 px-6 space-y-4
            transform -translate-y-full opacity-0 transition-all duration-300 md:hidden z-40">

    <a href="/user/products" class="block text-lg">All</a>
    <a href="/user/products?category=men" class="block text-lg">Men</a>
    <a href="/user/products?category=women" class="block text-lg">Women</a>
    <a href="/user/products?category=kids" class="block text-lg">Kids</a>

    <% if (user) { %>
        <button onclick="handleLogout()" class="block text-left text-lg text-red-400">
            Logout
        </button>
    <% } else { %>
        <a href="/user/login" class="block text-lg">Login</a>
        <a href="/user/register" class="block text-lg">Register</a>
    <% } %>
</div>

<script>
    const mobileMenuBtn = document.getElementById("mobileMenuBtn");
    const mobileMenu = document.getElementById("mobileMenu");

    mobileMenuBtn.addEventListener("click", () => {
        const open = mobileMenu.style.transform === "translateY(0)";
        mobileMenu.style.transform = open ? "translateY(-100%)" : "translateY(0)";
        mobileMenu.style.opacity = open ? "0" : "1";
    });

    async function handleLogout() {
        const notyf = new Notyf();
        try {
            const response = await axios.get("/user/logout");
            if (response.data.success) {
                notyf.success("Logged out!");
                setTimeout(() => window.location.href = "/user/login", 500);
            }
        } catch {
            notyf.error("Logout failed!");
        }
    }
</script>
