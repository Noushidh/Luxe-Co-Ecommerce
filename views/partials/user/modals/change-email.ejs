<!-- Change Email Modal -->
 
<div id="changeEmailModal" 
     class="fixed inset-0 bg-black/60 hidden items-center justify-center" 
     style="z-index: 9999 !important;"> <div class="bg-white w-full max-w-md rounded-2xl p-8 shadow-2xl transform transition-all relative z-[10000]">
        
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold text-stone-800 tracking-tight">Change Email</h2>
            <button onclick="closeEmailModal()" class="text-stone-400 hover:text-stone-600 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <div class="space-y-4">
            <div>
                <label class="text-xs uppercase tracking-widest text-stone-500 font-bold mb-2 block">New Email Address</label>
                <input id="emailInput" type="email" 
                       class="w-full p-4 border border-stone-200 rounded-xl focus:ring-2 focus:ring-[#C8A97E] focus:border-transparent outline-none transition-all" 
                       placeholder="example@luxe.com" />
            </div>

            <button onclick="sendVerificationLink(event)"
                class="w-full bg-[#C8A97E] hover:bg-[#b6916a] text-white py-4 rounded-xl font-bold tracking-wide transition-all shadow-lg shadow-[#C8A97E]/20 active:scale-[0.98]">
                Send Verification Link
            </button>

            <button onclick="closeEmailModal()" class="w-full py-2 text-stone-400 text-sm font-medium hover:text-stone-600 transition-colors">
                Cancel and return
            </button>
        </div>
    </div>
</div>
<script>
    const modal = document.getElementById("changeEmailModal");
    function openEmailModal() {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
    }
    function closeEmailModal() {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
    }

    async function sendVerificationLink() {
        const newEmail = document.getElementById("emailInput").value;
            const btn = event.currentTarget; 
            btn.disabled = true;
            const originalText = btn.innerText; 
            btn.innerText = "Processing...";
        if (!newEmail) {
            notyf.error("Please enter an email address");
            return;
        }

        try {
            const response = await axios.patch("/user/change-email/send-link", { newEmail });

            if (response.data.success) {
                notyf.success(response.data.message);
                closeEmailModal(); 
            }
        } catch (err) {
            notyf.error(err.response?.data?.message || "Something went wrong");
                 btn.disabled = false;
                 btn.innerText = originalText; 
        }
    }

</script>