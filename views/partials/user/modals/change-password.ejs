<!-- ================= CHANGE PASSWORD MODAL ================= -->
<div id="passwordModal" class="fixed inset-0 z-50 hidden
     bg-black/40 flex justify-center items-start">

  <!-- Modal Card -->
  <div class="mt-24 w-full max-w-md
        bg-white rounded-2xl shadow-xl
        p-6 relative">

    <!-- Close Button -->
    <button onclick="closePasswordModal()"
      class="absolute top-4 right-4
      text-stone-500 hover:text-stone-800">
      ✕
    </button>

    <!-- Title -->
    <h3 class="text-xl font-bold text-stone-800 mb-6 text-center">
      Change Password
    </h3>

    <!-- FORM -->
    <form id="changePasswordForm" class="space-y-5">

      <!-- Current Password -->
      <div class="form-group relative">
        <label class="block text-sm font-medium text-stone-700 mb-1">
          Current Password
        </label>

        <input type="password" id="currentPassword"
          placeholder="Enter current password"
          class="w-full px-4 py-3 pr-12
          border border-stone-300 rounded-lg
          outline-none focus:ring-2 focus:ring-[#C8A97E]" />

        <!-- Eye -->
        <button type="button"
          class="absolute right-3 top-9 text-stone-500"
          onmousedown="showPassword('currentPassword')"
          onmouseup="hidePassword('currentPassword')"
          onmouseleave="hidePassword('currentPassword')"
          ontouchstart="showPassword('currentPassword')"
          ontouchend="hidePassword('currentPassword')">
          🔒
        </button>
      </div>

      <!-- New Password -->
      <div class="form-group relative">
        <label class="block text-sm font-medium text-stone-700 mb-1">
          New Password
        </label>

        <input type="password" id="newPassword"
          placeholder="Enter new password"
          class="w-full px-4 py-3 pr-12
          border border-stone-300 rounded-lg
          outline-none focus:ring-2 focus:ring-[#C8A97E]" />

        <!-- Eye -->
        <button type="button"
          class="absolute right-3 top-9 text-stone-500"
          onmousedown="showPassword('newPassword')"
          onmouseup="hidePassword('newPassword')"
          onmouseleave="hidePassword('newPassword')"
          ontouchstart="showPassword('newPassword')"
          ontouchend="hidePassword('newPassword')">
          👁️
        </button>
      </div>

      <!-- Confirm Password -->
      <div class="form-group relative">
        <label class="block text-sm font-medium text-stone-700 mb-1">
          Confirm New Password
        </label>

        <input type="password" id="confirmPassword"
          placeholder="Re-enter new password"
          class="w-full px-4 py-3 pr-12
          border border-stone-300 rounded-lg
          outline-none focus:ring-2 focus:ring-[#C8A97E]" />

        <!-- Eye -->
        <button type="button"
          class="absolute right-3 top-9 text-stone-500"
          onmousedown="showPassword('confirmPassword')"
          onmouseup="hidePassword('confirmPassword')"
          onmouseleave="hidePassword('confirmPassword')"
          ontouchstart="showPassword('confirmPassword')"
          ontouchend="hidePassword('confirmPassword')">
          👁️
        </button>
      </div>

      <!-- Actions -->
      <div class="flex justify-end gap-3 pt-4">

        <button type="button" onclick="closePasswordModal()"
          class="px-5 py-2 rounded-lg
          border border-stone-300
          text-stone-700 hover:bg-stone-100">
          Cancel
        </button>

        <button type="button" onclick="submitChangePassword()"
          class="px-6 py-2 rounded-lg
          bg-[#C8A97E] text-white
          font-medium hover:opacity-90">
          Update Password
        </button>

      </div>
    </form>
  </div>
</div>
<script type="module">
  import {validatePassword,PasswordMatch,showError,clearError} from "/js/utils/validation.js";

  const notyf = new Notyf({ duration: 2500, position: { x: "right", y: "top" } });

  window.openPasswordModal = () => {
    document.getElementById("passwordModal").classList.remove("hidden");
  };

  window.closePasswordModal = () => {
    document.getElementById("passwordModal").classList.add("hidden");
  };

  window.submitChangePassword = async () => {
    const currentPasswordEl = document.getElementById("currentPassword");
    const newPasswordEl = document.getElementById("newPassword");
    const confirmPasswordEl = document.getElementById("confirmPassword");

    const currentPassword = currentPasswordEl.value.trim();
    const newPassword = newPasswordEl.value.trim();
    const confirmPassword = confirmPasswordEl.value.trim();

    let valid = true;

    if (!currentPassword) {
      showError(currentPasswordEl, "Current password is required");
      valid = false;
    } else clearError(currentPasswordEl);

    if (!validatePassword(newPassword)) {
      showError(
        newPasswordEl,
        "Min 8 chars, include letter, number & special character"
      );
      valid = false;
    } else clearError(newPasswordEl);

    if (!PasswordMatch(newPassword, confirmPassword)) {
      showError(confirmPasswordEl, "Passwords do not match");
      valid = false;
    } else clearError(confirmPasswordEl);

    if (!valid) return;

    const btn = document.querySelector("#changePasswordForm button:last-child");
    btn.disabled = true;
    btn.innerText = "Updating...";

    try {
      const response = await axios.patch("/user/profile/change-password",{ currentPassword, newPassword });

      if (response.data.success && response.data.redirect) {
        window.location.href = response.data.redirect;
      }
    } catch (err) {
      notyf.error(err.response?.data?.message || "Password change failed");
    }

    btn.disabled = false;
    btn.innerText = "Update Password";
  };
</script>
<script>
  window.showPassword = (id) => {
    const input = document.getElementById(id);
    if (input) input.type = "text";
  };

  window.hidePassword = (id) => {
    const input = document.getElementById(id);
    if (input) input.type = "password";
  };
</script>
