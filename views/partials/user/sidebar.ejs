<% const currentPath=locals.currentPath || '' %>

  <div class="md:hidden flex items-center justify-between bg-white p-4 rounded-xl shadow mb-4">
    <span class="font-bold text-stone-700">Account Menu</span>
    <button onclick="toggleMobileSidebar()" class="text-2xl text-[#c8a97e]">☰</button>
  </div>

  <aside id="userSidebar"
    class="hidden md:flex bg-white rounded-2xl shadow p-5 flex-col min-h-[auto] md:min-h-[108vh] transition-all duration-300">

    <ul class="space-y-2">
      <a href="/user/profile">
        <li class="relative px-4 py-3 flex items-center gap-3 rounded-lg cursor-pointer
            <%= currentPath === '/user/profile' ? 'bg-[#eee4d4] text-[#c8a97e]' : 'hover:bg-stone-100' %>">
          👤 <span class="text-sm font-medium">Personal Info</span>
          <% if (currentPath==='/user/profile' ) { %>
            <span class="absolute left-0 top-2 bottom-2 w-1 bg-[#c8a97e] rounded-r"></span>
            <% } %>
        </li>
      </a>

      <a href="/user/orders" class="block">
        <li
          class="px-4 py-3 flex items-center gap-3 rounded-lg cursor-pointer transition-all
            <%= currentPath === '/user/orders' ? 'bg-[#EEE4D4] text-[#C8A97E] font-bold shadow-sm' : 'hover:bg-stone-100 text-stone-600' %>">
          <span class="text-lg">📦</span>
          <span class="text-sm font-medium">My Orders</span>
        </li>
      </a>

      <a href="/user/address">
        <li class="relative px-4 py-3 flex items-center gap-3 rounded-lg cursor-pointer
            <%= currentPath === '/user/address' ? 'bg-[#eee4d4] text-[#c8a97e]' : 'hover:bg-stone-100' %>">
          🏠 <span class="text-sm font-medium">Address</span>
        </li>
      </a>

      <a href="/user/wallet">
        <li class="px-4 py-3 flex items-center gap-3 hover:bg-stone-100 rounded-lg cursor-pointer">
          💳 <span class="text-sm font-medium">Wallet</span>
        </li>
      </a>

      <li onclick="toggleSecurity()"
        class="px-4 py-3 flex items-center justify-between hover:bg-stone-100 rounded-lg cursor-pointer">
        <div class="flex items-center gap-3">
          🔐 <span class="text-sm font-medium">Security</span>
        </div>
        <span id="securityArrow" class="text-xs">▾</span>
      </li>

      <ul id="securityOptions" class="hidden ml-8 space-y-1">
        <% if (locals.userData && !userData.googleId) { %>
          <li onclick="openPasswordModal()" class="px-3 py-2 text-sm rounded-md hover:bg-stone-100 cursor-pointer">
            🔑 Change Password
          </li>
          <li onclick="openEmailModal()" class="px-3 py-2 text-sm rounded-md hover:bg-stone-100 cursor-pointer">
            📧 Change Email
          </li>
          <% } else { %>
            <li class="px-3 py-2 text-sm text-gray-400 cursor-not-allowed">
              🔑 Change Password (Google)
            </li>
            <li class="px-3 py-2 text-sm text-gray-400 cursor-not-allowed">
              📧 Change Email (Google)
            </li>
            <% } %>
      </ul>
    </ul>

    <div class="mt-auto pt-6">
      <button onclick="handleLogout()"
        class="w-full bg-[#c8a97e] text-white py-3 rounded-xl flex items-center justify-center gap-2 font-medium hover:opacity-90 transition">
        ⎋ Logout
      </button>
    </div>
  </aside>

  <%- include("./modals/change-password") %>
    <%- include("./modals/change-email") %>

      <script>
        function toggleMobileSidebar() {
          const sidebar = document.getElementById("userSidebar");
          sidebar.classList.toggle("hidden");
          sidebar.classList.toggle("flex");
        }

        function toggleSecurity() {
          const options = document.getElementById("securityOptions");
          const arrow = document.getElementById("securityArrow");
          if (!options) {
            console.error("Could not find securityOptions element!");
            return;
          }
          options.classList.toggle("hidden");
          arrow.textContent = options.classList.contains("hidden") ? "▾" : "▴";
        }

        async function handleLogout() {
          try {
            const res = await axios.get("/user/logout");

            if (res.data.success) {
              notyf.success(res.data.message || "Logged out successfully");
              setTimeout(() => {
                window.location.href = "/user/login";
              }, 800);
            }
          } catch (error) {
            console.error("Logout failed:", error);
            notyf.error("Something went wrong while logging out.");
          }
        }
      </script>