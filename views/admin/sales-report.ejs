<div class="min-h-screen bg-[#F5E9DA] p-4 md:p-8 font-['Inter']">
    <div class="max-w-7xl mx-auto">

        <div class="bg-white rounded-lg shadow-sm border border-stone-200 p-6 mb-6">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-stone-700">Sales Report & Performance Overview</h1>
                    <p class="text-stone-500 text-sm mt-1">Analyze sales trends and revenue metrics.</p>
                </div>

                <div class="relative inline-block text-left">
                    <button onclick="toggleExportMenu()" id="exportBtn"
                        class="flex items-center gap-2 px-6 py-2.5 bg-[#C8A97E] hover:bg-stone-600 text-white rounded-md transition-colors shadow-sm focus:outline-none">
                        <i class="fas fa-download text-xs"></i>
                        <span class="text-sm font-medium">Export Report</span>
                        <i class="fas fa-chevron-down text-[10px] ml-1"></i>
                    </button>

                    <div id="exportMenu"
                        class="hidden absolute right-0 mt-2 w-40 bg-white border border-stone-200 rounded-lg shadow-xl z-50 overflow-hidden">
                        <button onclick="downloadReport('pdf')"
                            class="flex items-center gap-3 w-full px-4 py-3 text-sm text-stone-600 hover:bg-stone-50 transition-colors border-b border-stone-100">
                            <i class="fas fa-file-pdf text-rose-500"></i>
                            <span>PDF Document</span>
                        </button>
                        <button onclick="downloadReport('excel')"
                            class="flex items-center gap-3 w-full px-4 py-3 text-sm text-stone-600 hover:bg-stone-50 transition-colors">
                            <i class="fas fa-file-excel text-emerald-500"></i>
                            <span>Excel Sheet</span>
                        </button>
                    </div>
                </div>

            </div>
            <div class="mt-8 flex flex-wrap items-center gap-4 border-t pt-6">
                <div class="flex  bg-[#F5E9DA] p-1 rounded-lg border border-stone-200" id="rangeToggles">
                    <button onclick="setDateRange('day', this)"
                        class="range-btn px-4 py-1.5 text-xs font-semibold rounded-md transition-all text-stone-600">1
                        Day</button>
                    <button onclick="setDateRange('week', this)"
                        class="range-btn px-4 py-1.5 text-xs font-semibold rounded-md transition-all text-stone-600">Week</button>
                    <button onclick="setDateRange('month', this)"
                        class="range-btn px-4 py-1.5 text-xs font-semibold rounded-md transition-all text-stone-600">Month</button>
                </div>

                <form id="filterForm" class="flex flex-wrap items-center gap-4">
                    <div class="flex items-center gap-2">
                        <div class="relative">
                            <label
                                class="absolute -top-5 left-1 text-[10px] font-bold text-stone-500 uppercase">From</label>
                            <input type="date" name="startDate" id="startDate" value="<%= startDate || '' %>"
                                onchange="applyFilters()"
                                class="px-3 py-2 border border-stone-300 rounded-lg text-sm outline-none bg-white">
                        </div>
                        <span class="text-stone-400 mt-2">—</span>
                        <div class="relative">
                            <label
                                class="absolute -top-5 left-1 text-[10px] font-bold text-stone-500 uppercase">To</label>
                            <input type="date" name="endDate" id="endDate" value="<%= endDate || '' %>"
                                onchange="applyFilters()"
                                class="px-3 py-2 border border-stone-300 rounded-lg text-sm outline-none bg-white">
                        </div>
                    </div>

                    <div class="relative">
                        <label
                            class="absolute -top-5 left-1 text-[10px] font-bold text-stone-500 uppercase">Payment</label>
                        <select name="paymentMethod" onchange="applyFilters()"
                            class="px-3 py-2 border border-stone-300 rounded-lg text-sm outline-none bg-white min-w-[140px]">
                            <option value="">All Payments</option>
                            <option value="cashOnDelivery" <%=paymentMethod==='cashOnDelivery' ? 'selected' : '' %>>Cash
                                on Delivery</option>
                            <option value="wallet" <%=paymentMethod==='wallet' ? 'selected' : '' %>>Wallet</option>
                            <option value="razorpay" <%=paymentMethod==='razorpay' ? 'selected' : '' %>>Razorpay
                            </option>
                        </select>
                    </div>

                    <div class="relative">
                        <label
                            class="absolute -top-5 left-1 text-[10px] font-bold text-stone-500 uppercase">Status</label>
                        <select name="status" onchange="applyFilters()"
                            class="px-3 py-2 border border-stone-300 rounded-lg text-sm outline-none bg-white min-w-[140px]">
                            <option value="">All Statuses</option>
                            <% const statuses=["Pending", "Confirmed" , "Processing" , "Shipped" , "Delivered"
                                , "Cancelled" , "Return Requested" , "Returned" , "Rejected" ]; %>
                                <% statuses.forEach(s=> { %>
                                    <option value="<%= s %>" <%=status===s ? 'selected' : '' %>><%= s %>
                                    </option>
                                    <% }) %>
                        </select>
                    </div>

                    <button type="button" onclick="resetFilters()"
                        class="px-4 py-2 bg-stone-200 text-stone-700 rounded-lg text-sm font-medium hover:bg-stone-300 transition-colors">
                        Reset
                    </button>
                </form>
            </div>
        </div>

 <% 
  const stats = [
      { label: 'Total Sales Count', value: totalOrders, color: 'text-stone-700', bg: 'bg-white' },
      { label: 'Gross Sales', value: '₹' + grossSales.toLocaleString(), color: 'text-stone-700', bg: 'bg-white' },
      { label: 'Discount & Coupon Deducted', value: '₹' + totalDiscount.toLocaleString(), color: 'text-red-500', bg: 'bg-white' },
      { label: 'Net Revenue', value: '₹' + totalAmount.toLocaleString(), color: 'text-white', bg: 'bg-[#CEB195]' }
  ];
%>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <% stats.forEach(stat=> { %>
                <div
                    class="<%= stat.bg %> p-6 rounded-xl border border-stone-200 shadow-sm relative overflow-hidden transition-transform hover:scale-[1.02]">
                    <p
                        class="<%= stat.bg === 'bg-stone-800' ? 'text-stone-400' : 'text-stone-500' %> text-xs font-medium uppercase tracking-wider">
                        <%= stat.label %>
                    </p>
                    <h3 class="text-2xl font-bold <%= stat.color %> mt-2">
                        <%= stat.value %>
                    </h3>
                    <% if (stat.icon) { %>
                        <div class="absolute right-4 top-6 bg-stone-100 p-2 rounded-full">
                            <i class="fas <%= stat.icon %> text-stone-400"></i>
                        </div>
                        <% } %>
                </div>
                <% }) %>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden">
            <div class="p-6 border-b border-stone-100">
                <h2 class="text-lg font-bold text-stone-700">Detailed Sales Report</h2>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-stone-50 border-b border-stone-200">
                            <th class="px-6 py-4 text-xs font-bold text-stone-500 uppercase">Order ID</th>
                            <th class="px-6 py-4 text-xs font-bold text-stone-500 uppercase">Customer</th>
                            <th class="px-6 py-4 text-xs font-bold text-stone-500 uppercase">Date</th>
                            <th class="px-6 py-4 text-xs font-bold text-stone-500 uppercase">Payment</th>
                            <th class="px-6 py-4 text-xs font-bold text-stone-500 uppercase">Status</th>
                            <th class="px-6 py-4 text-xs font-bold text-stone-500 uppercase">Applied Coupon</th>
                            <th class="px-6 py-4 text-xs font-bold text-stone-500 uppercase">Offer Discount</th>
                            <th class="px-6 py-4 text-xs font-bold text-stone-500 uppercase text-right">Final Total</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-stone-100">
                        <% if(orders && orders.length> 0) { %>
                            <% orders.forEach(order=> { %>
                                <tr class="hover:bg-stone-50/50 transition-colors">
                                    <td class="px-6 py-4 text-sm font-bold text-stone-700">
                                        #<%= order.orderId || order._id.toString().slice(-6).toUpperCase() %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-stone-600">
                                        <%= order.userId?.fullname || 'Guest' %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-stone-500">
                                        <%= new Date(order.createdAt).toLocaleDateString('en-IN') %>
                                    </td>
                          <td class="px-6 py-4 whitespace-nowrap text-center">
                      <span class="inline-flex items-center justify-center w-28 px-2 py-1 bg-[#FDF8F3] border border-[#F3E8D6] border-l-[3px] border-l-[#B38B59] text-[#84633C] text-[9px] font-bold uppercase tracking-wider rounded-sm shadow-sm">
                        <%= order.paymentMethod %>
                       </span>
                       </td>                                               
                 <% 
    let returnInProgress = (typeof hasReturnRequest !== 'undefined' && hasReturnRequest);
    
    let badgeStyle = ''; 
    let displayStatus = order.status;

    if (returnInProgress) {
        displayStatus = "Return In Progress";
        badgeStyle = 'bg-orange-50 border-orange-100 border-l-orange-400 text-orange-700';
    } else {
        switch (order.status) { 
            case 'Cancelled': 
            case 'Rejected':
            case 'Return Rejected': 
                badgeStyle = 'bg-red-50 border-red-100 border-l-red-400 text-red-700'; break;
            case 'Confirmed': 
                badgeStyle = 'bg-emerald-50 border-emerald-100 border-l-emerald-400 text-emerald-700'; break;
            case 'Processing': 
                badgeStyle = 'bg-blue-50 border-blue-100 border-l-blue-400 text-blue-700'; break;
            case 'Shipped': 
                badgeStyle = 'bg-purple-50 border-purple-100 border-l-purple-400 text-purple-700'; break; 
            case 'Delivered': 
                badgeStyle = 'bg-green-50 border-green-100 border-l-green-500 text-green-800'; break;
            default: 
                badgeStyle = 'bg-stone-50 border-stone-200 border-l-stone-400 text-stone-600';
         } 
    }
%>

                                <td class="px-6 py-4 whitespace-nowrap">
                               <span class="inline-flex items-center px-2 py-0.5 border border-l-[3px] rounded-sm text-[9px] font-bold uppercase tracking-wider <%= badgeStyle %>">
                                  <%= displayStatus %>
                                      </span>
                                     </td>

<td class="px-6 py-4 whitespace-nowrap text-center">
    <% if(order.discount > 0) { %>
        <div class="flex flex-col items-center gap-1.5">
            <span class="inline-flex items-center justify-center w-28 px-2 py-1 bg-orange-50 border border-orange-100 border-l-[3px] border-l-orange-500 text-orange-700 text-[9px] font-bold uppercase tracking-wider rounded-sm shadow-sm">
                <%= order.couponId?.code || 'COUPON' %>
            </span>
            
            <span class="text-orange-600 text-[10px] font-bold">
                -₹<%= order.discount.toLocaleString('en-IN') %>
            </span>
        </div>
    <% } else { %>
        <span class="text-stone-300 text-xs">—</span>
    <% } %>
</td>
                                    <td class="px-6 py-4 text-sm">
                                        <div class="flex flex-col">
                                            <% if(order.offerDiscount> 0) { %>
                                                <span class="text-orange-600 font-medium">-₹<%=
                                                        order.offerDiscount.toLocaleString('en-IN') %></span>
                                                <span class="text-[9px] text-stone-400 uppercase">Product Offer</span>
                                                <% } else { %>
                                                    <span class="text-stone-300">₹0</span>
                                                    <% } %>
                                        </div>
                                    </td>

                                    <td class="px-6 py-4 text-sm text-stone-800 text-right font-bold">
                                        ₹<%= order.total.toLocaleString('en-IN') %>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="p-10 text-center text-stone-400">
                                                <div class="flex flex-col items-center gap-2">
                                                    <i class="fas fa-folder-open text-2xl"></i>
                                                    <span>No records found for the selected criteria</span>
                                                </div>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

  <div class="flex justify-center items-center gap-3 mt-12 mb-10">
    <% if (currentPage > 1) { %>
        <a href="?<%= qs %>&page=<%= currentPage - 1 %>"
           class="w-10 h-10 flex items-center justify-center rounded-xl bg-stone-50/80 text-stone-600 hover:bg-white hover:shadow-md transition-all">
            <span class="text-lg">«</span>
        </a>
    <% } else { %>
        <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-stone-100/50 text-stone-300 cursor-not-allowed">
            <span class="text-lg">«</span>
        </span>
    <% } %>

    <div class="flex items-center gap-2.5">
        <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="?<%= qs %>&page=<%= i %>"
               class="w-10 h-10 flex items-center justify-center rounded-xl text-sm font-bold transition-all
                <%= i === currentPage 
                    ? 'bg-[#C8A97E] text-white shadow-lg shadow-[#C8A97E]/20 scale-105' 
                    : 'bg-stone-50/80 text-stone-600 hover:bg-white hover:shadow-md' 
                %>">
                <%= i %>
            </a>
        <% } %>
    </div>

    <% if (currentPage < totalPages) { %>
        <a href="?<%= qs %>&page=<%= currentPage + 1 %>"
           class="w-10 h-10 flex items-center justify-center rounded-xl bg-stone-50/80 text-stone-600 hover:bg-white hover:shadow-md transition-all">
            <span class="text-lg">»</span>
        </a>
    <% } else { %>
        <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-stone-100/50 text-stone-300 cursor-not-allowed">
            <span class="text-lg">»</span>
        </span>
    <% } %>
</div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", () => {
        updateActiveButton();
    });

    function updateActiveButton() {
        const startInput = document.getElementById('startDate').value;
        const endInput = document.getElementById('endDate').value;
        const buttons = document.querySelectorAll('.range-btn');

        const today = new Date().toISOString().split('T')[0];

        const weekAgo = new Date();
        weekAgo.setDate(new Date().getDate() - 7);
        const formattedWeek = weekAgo.toISOString().split('T')[0];

        const monthAgo = new Date();
        monthAgo.setMonth(new Date().getMonth() - 1);
        const formattedMonth = monthAgo.toISOString().split('T')[0];

        buttons.forEach(b => {
            b.classList.remove('bg-white', 'shadow-sm');
            b.classList.add('text-stone-600');
        });

        let activeButton;
        if (startInput === today && endInput === today) {
            activeButton = buttons[0];
        } else if (startInput === formattedWeek && endInput === today) {
            activeButton = buttons[1];
        } else if (startInput === formattedMonth && endInput === today) {
            activeButton = buttons[2];
        }

        if (activeButton) {
            activeButton.classList.add('bg-white', 'shadow-sm');
            activeButton.classList.remove('text-stone-600');
        }
    }

    function setDateRange(range, btn) {
        const startInput = document.getElementById('startDate');
        const endInput = document.getElementById('endDate');
        const today = new Date();
        let startDate = new Date();

        if (range === 'day') {
            startDate = today;
        } else if (range === 'week') {
            startDate.setDate(today.getDate() - 7);
        } else if (range === 'month') {
            startDate.setMonth(today.getMonth() - 1);
        }

        const formatDate = (date) => date.toISOString().split('T')[0];

        startInput.value = formatDate(startDate);
        endInput.value = formatDate(today);

        applyFilters();
    }

    function applyFilters() {
        const form = document.getElementById('filterForm');
        const formData = new FormData(form);
        const params = new URLSearchParams();

        for (const [key, value] of formData.entries()) {
            if (value) {
                params.append(key, value);
            }
        }
        window.location.href = `/admin/sales-report?${params.toString()}`;
    }

    function resetFilters() {
        window.location.href = '/admin/sales-report';
    }

    function toggleExportMenu() {
        const menu = document.getElementById('exportMenu');
        menu.classList.toggle('hidden');

        const closeMenu = (e) => {
            const btn = document.getElementById('exportBtn');
            if (!btn.contains(e.target) && !menu.contains(e.target)) {
                menu.classList.add('hidden');
                document.removeEventListener('click', closeMenu);
            }
        };
        document.addEventListener('click', closeMenu);
    }

    function downloadReport(format) {
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;
        const paymentMethod = document.querySelector('select[name="paymentMethod"]').value;
        const status = document.querySelector('select[name="status"]').value;

        const params = new URLSearchParams();
        if (startDate) params.append('startDate', startDate);
        if (endDate) params.append('endDate', endDate);
        if (paymentMethod) params.append('paymentMethod', paymentMethod);
        if (status) params.append('status', status);

        window.location.href = `/admin/sales-report/download/${format}?${params.toString()}`;

        document.getElementById('exportMenu').classList.add('hidden');
    }
</script>