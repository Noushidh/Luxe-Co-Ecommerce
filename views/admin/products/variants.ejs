<!-- ================= PRODUCT INFO CARD ================= -->
<div id="productInfoCard" class="bg-white border border-[#C8A97E] rounded-2xl p-6 mb-8 shadow-md">

    <h3 class="text-2xl font-bold text-gray-900 mb-4">
        <%= product.name %>
    </h3>

    <div class="grid grid-cols-2 gap-6 text-sm text-gray-700">

        <p><strong class="text-gray-900">Variants:</strong>
            <%= product.variants?.length || 0 %>
        </p>

        <p><strong class="text-gray-900">Total Stock:</strong>
            <%= product.variants.reduce((s,v)=>s+v.stock,0) || 0 %>
        </p>

        <p><strong class="text-gray-900">Price:</strong> ₹<%= product.price %>
        </p>

        <p>
            <strong class="text-gray-900">Status:</strong>
            <% if (!product.isBlocked) { %>
                <span class="ml-2 px-3 py-1 bg-green-500 text-white rounded-full text-xs shadow">Active</span>
                <% } else { %>
                    <span class="ml-2 px-3 py-1 bg-red-500 text-white rounded-full text-xs shadow">Blocked</span>
                    <% } %>
        </p>

    </div>

</div>

<!-- ================= ACTION BUTTONS (Right aligned Add Variant) ================= -->
<div class="w-full flex justify-end items-center mb-4">
    <button id="addVariantBtn"
        class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 text-white text-sm rounded-lg shadow hover:bg-green-700 transition">
        <span class="font-medium">Add Variant</span>
        <span class="ml-2 text-lg font-bold">+</span>
    </button>
</div>


<!-- ================= VARIANT SECTION WRAPPER ================= -->
<div id="variantSection" class="space-y-8">
    <div id="variantContainer" class="space-y-6"></div>
    <div id="submitVariantsBox" class="hidden pt-6 pb-4">
        <button id="submitVariantsBtn" onclick="submitVariants()"
            class="w-full py-3 bg-[#C8A97E] text-white rounded-xl font-semibold shadow-md hover:bg-[#b6916a] transition">
            Save Variants
        </button>
    </div>
</div>


<div id="variantCardTemplate" class="hidden">
    <div class="variantCard bg-[#FFF7EF] border border-[#C8A97E] rounded-xl p-6 shadow-md relative">
        <div class="mainVariantLabel hidden text-sm font-semibold text-green-700 mb-3"></div>
        <div class="absolute top-4 right-4 flex gap-2">
            <button type="button" class="removeVariantBtn text-red-600 font-semibold text-sm hover:text-red-800">Remove</button>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Variant</h3>
        <p class="text-xs text-red-500 mb-2 font-medium italic">* Minimum 3 images required</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div>
                <label class="text-sm font-medium text-gray-700">Size</label>
                <select name="size" class="variantsize w-full mt-1 px-3 py-2 border border-gray-300 rounded-lg">
                    <% for (let s = 1; s <= 11; s++) { %>
                        <option value="<%= s %>"><%= s %></option>
                    <% } %>
                </select>
            </div>
            <div>
                <label class="text-sm font-medium text-gray-700">Stock</label>
                <input type="number" class="variantstock w-full mt-1 px-3 py-2 border rounded-lg" min="0">
            </div>
            <div>
                <label class="text-sm font-medium text-gray-700">Color</label>
                <input type="text" class="variantColor w-full mt-1 px-3 py-2 border rounded-lg">
            </div>
        </div>
        <div class="mt-5">
            <label class="text-sm font-medium text-gray-700">Variant Images</label>
            <div class="border-2 border-dashed border-[#C8A97E] p-5 rounded-xl bg-white">
                <button type="button" class="selectImagesBtn px-4 py-2 bg-[#C8A97E] text-white rounded-lg mx-auto block">Select Images</button>
                <input type="file" class="variantImages hidden" accept="image/*" multiple />
                <div class="variantPreview flex flex-wrap gap-3 mt-4"></div>
            </div>
        </div>
    </div>
</div>

<div id="cropModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black bg-opacity-75 p-4">
    <div class="bg-white rounded-2xl max-w-2xl w-full overflow-hidden shadow-2xl">
