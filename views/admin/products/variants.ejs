<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script>

let cropper;
const cropModal = document.getElementById('cropModal');
const croppingImage = document.getElementById('croppingImage');

function closeCropModal() {
    cropModal.classList.add('hidden');
    if (cropper) {
        cropper.destroy();
        cropper = null;
    }
}

function renderPreview(files, imgInput, preview) {
    preview.innerHTML = "";
    files.forEach((file, index) => {
        const wrapper = document.createElement("div");
        wrapper.className = "relative inline-block";
        const img = document.createElement("img");
        img.className = "w-20 h-20 rounded object-cover border";
        img.src = URL.createObjectURL(file);

        const removeBtn = document.createElement("button");
        removeBtn.innerHTML = "&times;";
        removeBtn.className = "absolute -top-2 -right-2 bg-red-600 text-white rounded-full w-6 h-6 text-xs flex items-center justify-center shadow";
        
        removeBtn.onclick = () => {
            files.splice(index, 1);
            const dt = new DataTransfer();
            files.forEach(f => dt.items.add(f));
            imgInput.files = dt.files;
            renderPreview(files, imgInput, preview);
        };
        wrapper.appendChild(img);
        wrapper.appendChild(removeBtn);
        preview.appendChild(wrapper);
    });
}

function handleImageSelection(input, preview, filesArray) {
    const selectedFiles = Array.from(input.files);
    if (selectedFiles.length === 0) return;
    let fileIndex = 0;

    function processNextFile() {
        if (fileIndex < selectedFiles.length) {
            const file = selectedFiles[fileIndex];
            const reader = new FileReader();
            reader.onload = (e) => {
croppingImage.src = e.target.result;
cropModal.classList.remove('hidden');

if (cropper) cropper.destroy();

cropper = new Cropper(croppingImage, {
    aspectRatio: 1, 
    viewMode: 1,           
    dragMode: 'move',     
    autoCropArea: 1,      
    responsive: true,
    checkOrientation: false, 
    background: false,     
    modal: true,            
    guides: true,           
    center: true,
    highlight: false,
    cropBoxMovable: true,   
    cropBoxResizable: true, 
});

                document.getElementById('cropSaveBtn').onclick = () => {
                    const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });
                    canvas.toBlob((blob) => {
                        const croppedFile = new File([blob], `crop_${Date.now()}.jpg`, { type: 'image/jpeg' });
                        filesArray.push(croppedFile);
                        
                        const dt = new DataTransfer();
                        filesArray.forEach(f => dt.items.add(f));
                        input.files = dt.files;

                        renderPreview(filesArray, input, preview);
                        fileIndex++;
                        if (fileIndex < selectedFiles.length) processNextFile();
                        else closeCropModal();
                    }, 'image/jpeg');
                };
            };
            reader.readAsDataURL(file);
        }
    }
    processNextFile();
}

function addVariantCard() {
    const template = document.getElementById("variantCardTemplate").querySelector(".variantCard");
    const card = template.cloneNode(true);
    let cardFiles = []; 

    const imgInput = card.querySelector(".variantImages");
    const preview = card.querySelector(".variantPreview");
    const selectBtn = card.querySelector(".selectImagesBtn");

    selectBtn.onclick = (e) => { e.preventDefault(); imgInput.click(); };
    imgInput.onchange = () => {
        handleImageSelection(imgInput, preview, cardFiles);
        imgInput.value = ""; 
    };

    const removeBtn = card.querySelector(".removeVariantBtn");
    const isFirst = document.getElementById("variantContainer").children.length === 0;
    if (isFirst) {
        card.querySelector(".mainVariantLabel").classList.remove("hidden");
        card.querySelector(".mainVariantLabel").innerText = "Main Variant";
        removeBtn.classList.add("hidden");
    }

    removeBtn.onclick = () => {
        card.remove();
        if (document.getElementById("variantContainer").children.length === 0) addVariantCard();
    };

    document.getElementById("variantContainer").appendChild(card);
    document.getElementById("submitVariantsBox").classList.remove("hidden");
}

document.addEventListener("DOMContentLoaded", () => {
    addVariantCard();
    document.getElementById("addVariantBtn").addEventListener("click", addVariantCard);
});

    //submit varia
    async function submitVariants() {
        const notyf = new Notyf({ position: { x: "right", y: "top" } });

        const btn = event.currentTarget || document.querySelector('button[onclick="submitVariants()"]');
        const originalText = btn.innerHTML;

        const cards = document.querySelectorAll("#variantContainer .variantCard");
        if (cards.length === 0) return notyf.error("Please add at least one variant.");

        const formData = new FormData();
        const variants = [];

        formData.append("productId", "<%= product._id %>");

        cards.forEach((card, i) => {
            const size = card.querySelector(".variantsize").value.trim();
            const stock = card.querySelector(".variantstock").value.trim();
            const color = card.querySelector(".variantColor").value.trim();
            const images = card.querySelector(".variantImages").files;

            if (!size || !stock || !color) throw notyf.error(`Variant ${i + 1}: Fill all fields`);
            if (images.length < 3) throw notyf.error(`Variant ${i + 1}: Upload at least 3 images`);

            variants.push({ size, stock, color });

            [...images].forEach(file => formData.append(`images_${i}`, file));
        });

        formData.append("variants", JSON.stringify(variants));

        try {
            btn.disabled = true;
            btn.innerHTML = `
            <span class="flex items-center justify-center gap-2">
                <svg class="animate-spin h-4 w-4 text-white" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Saving Variants...
            </span>`;
            const response = await axios.post("/admin/products/variants/save", formData);

            if (response.data.success) {
                notyf.success(response.data.message);
                setTimeout(() => window.location.href = response.data.redirect, 800);
            }
        } catch (error) {
            if (error.response && error.response.data && error.response.data.message) {
                notyf.error(error.response.data.message)
            
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }
    }
</script>