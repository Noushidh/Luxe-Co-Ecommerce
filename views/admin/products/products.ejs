<div class="w-full min-h-screen bg-[#F5E9DA] p-6">

    <h1 class="text-2xl font-bold text-[#2c2c2c]">Product Management</h1>
    <p class="text-sm text-gray-600 mt-1">Manage and organize all products in your store.</p>

    <!-- FILTER BAR -->
    <div class="mt-4 bg-white p-4 rounded-lg shadow flex flex-wrap items-center gap-4">

        <!-- STATUS FILTER -->
        <div>
            <label class="text-xs font-semibold text-gray-700">Status</label>
            <select id="filterStatus" onchange="applyFilters()" class="px-3 py-2 border rounded-lg text-sm bg-white">
                <option value="">All</option>
                <option value="active" <%=status==="active" ? "selected" : "" %>>Active</option>
                <option value="blocked" <%=status==="blocked" ? "selected" : "" %>>Blocked</option>
            </select>
        </div>

        <!-- STOCK FILTER -->
        <div>
            <label class="text-xs font-semibold text-gray-700">Stock</label>
            <select id="filterStock" onchange="applyFilters()" class="px-3 py-2 border rounded-lg text-sm bg-white">
                <option value="">All</option>
                <option value="in" <%=stock==="in" ? "selected" : "" %>>In Stock</option>
                <option value="out" <%=stock==="out" ? "selected" : "" %>>Out of Stock</option>
            </select>
        </div>

        <!-- CATEGORY FILTER -->
        <div>
            <label class="text-xs font-semibold text-gray-700">Category</label>
            <select id="filterCategory" onchange="applyFilters()" class="px-3 py-2 border rounded-lg text-sm bg-white">
                <option value="">All</option>
                <% subcategories.forEach(sub=> { %>
                    <option value="<%= sub._id %>" <%=category===sub._id.toString() ? "selected" : "" %>>
                        <%= sub.subcategory %>
                    </option>
                    <% }) %>
            </select>
        </div>

        <!-- ALPHABETIC FILTER -->
        <div>
            <label class="text-xs font-semibold text-gray-700">Sort</label>
            <select id="filterAlpha" onchange="applyFilters()" class="px-3 py-2 border rounded-lg text-sm bg-white">
                <option value="">Latest</option>
                <option value="az" <%=alpha==="az" ? "selected" : "" %>>Name A–Z</option>
                <option value="za" <%=alpha==="za" ? "selected" : "" %>>Name Z–A</option>
            </select>
        </div>

        <!-- RESET BUTTON -->
        <button onclick="resetFilters()"
            class="ml-auto px-4 py-2 bg-gray-300 text-gray-800 rounded-lg shadow text-sm hover:bg-gray-400">
            Reset Filters
        </button>
    </div>



    <form id="searchForm" method="GET" action="/admin/products" class="flex flex-col sm:flex-row items-center justify-between mt-6 gap-3">

        <!-- Keep filters -->
        <input type="hidden" name="status" value="<%= status %>">
        <input type="hidden" name="stock" value="<%= stock %>">
        <input type="hidden" name="category" value="<%= category %>">

        <input type="text" name="search" id="search" placeholder="Search products..." value="<%= search || '' %>"
            class="w-full sm:w-80 px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm" oninput="autoSearch()" />

        <button type="button" onclick="window.location='/admin/products/add'"
            class="w-full sm:w-auto px-4 py-2 bg-[#C8A97E] text-white rounded-lg shadow hover:shadow-md">
            + Add Product
        </button>

    </form>



    <div class="mt-6">
        <!-- Desktop table-like grid (visible on md+) -->
        <div class="hidden md:block bg-white shadow rounded-lg overflow-hidden">
            <div class="bg-[#C8A97E] grid grid-cols-9 text-xs font-bold text-gray-700 py-3 px-4">
                <div>Name</div>
                <div>Image</div>
                <div>Category</div>
                <div>Variant count</div>
                <div>Price</div>
                <div>Stock</div>
                <div>Status</div>
                <div>Variants</div>
                <div>Actions</div>
            </div>

            <% products.forEach(product=> {
                let firstVariant = product.variants?.[0] || null;
                let totalStock = product.variants?.reduce((sum, v) => sum + (v.stock || 0), 0) || 0;
                %>

                <div class="grid grid-cols-9 py-4 px-4 border-b border-gray-100 text-sm items-center">
                    <div class="font-medium text-gray-800"><%= product.name %></div>
                    <div class="px-4 py-2">
                        <% if (product.image) { %>
                            <img src="<%= product.image %>" class="w-16 h-16 object-cover rounded-lg border">
                        <% } else { %>
                            <span class="text-gray-500 text-sm">No Image</span>
                        <% } %>
                    </div>
                    <div><%= product.subCategory_id?.subcategory || "N/A" %></div>
                    <div>
                        <span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-semibold shadow"><%= product.variants.length %> Variants</span>
                    </div>
                    <div>₹ <%= product.price %></div>
                    <div>
                        <% if (totalStock> 0) { %>
                            <span class="text-green-600 font-semibold"><%= totalStock %></span>
                        <% } else { %>
                            <span class="text-red-600 font-semibold">Out of Stock</span>
                        <% } %>
                    </div>
                    <div id="status-<%= product._id %>">
                        <% if (!product.isBlocked) { %>
                            <span class="px-3 py-1 bg-green-500 text-white rounded-full text-xs shadow">Active</span>
                        <% } else { %>
                            <span class="px-3 py-1 bg-red-500 text-white rounded-full text-xs shadow">Blocked</span>
                        <% } %>
                    </div>
                    <div>
                        <a href="/admin/products/<%= product._id %>/variants/edit" class="text-blue-600 hover:text-blue-800 underline text-xs font-medium">Manage</a>
                    </div>
                    <div class="flex gap-2">
                        <button type="button" onclick="window.location.href='/admin/product/edit/<%= product._id %>'" class="px-3 py-1 bg-blue-600 text-white text-xs rounded hover:bg-blue-700 shadow">Edit</button>
                        <button onclick="confirmToggle('<%= product._id %>', <%= product.isBlocked %>)" id="btn-<%= product._id %>" class="px-3 py-1 text-white text-xs rounded <%= product.isBlocked ? 'bg-green-500' : 'bg-red-500' %>"><%= product.isBlocked ? 'Unblock' : 'Block' %></button>
                    </div>
                </div>

            <% }) %>
        </div>

        <!-- Mobile card list (visible on small screens) -->
        <div class="md:hidden space-y-4">
            <% products.forEach(product => {
                let totalStock = product.variants?.reduce((sum, v) => sum + (v.stock || 0), 0) || 0;
            %>
                <div class="bg-white shadow rounded-lg p-4">
                    <div class="flex items-center gap-4">
                        <div class="w-20 h-20 flex-shrink-0">
                            <% if (product.image) { %>
                                <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover rounded-lg" />
                            <% } else { %>
                                <div class="w-full h-full bg-gray-100 rounded-lg flex items-center justify-center text-sm text-gray-500">No Image</div>
                            <% } %>
                        </div>
                        <div class="flex-1">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h3 class="text-base font-semibold text-gray-800"><%= product.name %></h3>
                                    <p class="text-xs text-gray-500"><%= product.subCategory_id?.subcategory || 'N/A' %></p>
                                </div>
                                <div class="text-right">
                                    <div class="text-sm font-semibold">₹ <%= product.price %></div>
                                    <div class="text-xs text-gray-500"><%= product.variants.length %> variants</div>
                                </div>
                            </div>

                            <div class="mt-3 flex items-center justify-between gap-3">
                                <div>
                                    <% if (totalStock > 0) { %>
                                        <span class="text-green-600 font-semibold text-sm"><%= totalStock %> in stock</span>
                                    <% } else { %>
                                        <span class="text-red-600 font-semibold text-sm">Out of Stock</span>
                                    <% } %>
                                </div>

                                <div class="flex items-center gap-2">
                                    <a href="/admin/product/edit/<%= product._id %>" class="px-3 py-1 bg-blue-600 text-white text-xs rounded">Edit</a>
                                    <button onclick="confirmToggle('<%= product._id %>', <%= product.isBlocked %>)" id="btn-<%= product._id %>" class="px-3 py-1 text-white text-xs rounded <%= product.isBlocked ? 'bg-green-500' : 'bg-red-500' %>"><%= product.isBlocked ? 'Unblock' : 'Block' %></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <div class="mt-4">
        <%- include("../../partials/admin/pagination", { currentPage, totalPages, search,status,stock, category}) %>
    </div>
</div>


<!-- VARIANT MODAL  -->

<div id="variantModal" class="fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center z-50 hidden">

    <div class="bg-white w-full max-w-3xl rounded-xl shadow-xl p-6 relative 
                max-h-[90vh] overflow-y-auto">

        <button onclick="closeVariantModal()"
            class="absolute top-6 right-6 text-gray-600 hover:text-black text-3xl font-bold z-50">
            &times;
        </button><br>

        <!-- HEADER + ADD BUTTON -->
        <div class="flex justify-between items-center mb-4 mt-6">
            <h2 class="text-xl font-semibold text-gray-800">Manage Variants</h2>

            <button id="addVariantBlockBtn"
                class="px-4 py-2 bg-green-600 text-white rounded-lg shadow hover:bg-green-700">
                + Add Variant
            </button>
        </div>

        <div id="variantBlockContainer" class="space-y-6"></div>

        <div id="variantTemplate" class="hidden">
            <div class="variantBlock bg-[#FFF7EF] p-5 border border-[#C8A97E] rounded-xl">

                <div class="flex justify-between items-center mb-3">
                    <h3 class="text-lg font-medium text-gray-800">Variant</h3>
                    <button type="button" class="removeVariantBtn text-red-600 font-semibold">Remove</button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                    <div>
                        <label class="text-sm text-gray-700">Size</label>
                        <input type="text" class="variantsize w-full mt-1 px-3 py-2 border rounded-lg" />
                    </div>

                    <div>
                        <label class="text-sm text-gray-700">Stock</label>
                        <input type="number" class="variantstock w-full mt-1 px-3 py-2 border rounded-lg" />
                    </div>

                    <div>
                        <label class="text-sm text-gray-700">Color</label>
                        <input type="text" class="variantColor w-full mt-1 px-3 py-2 border rounded-lg" />
                    </div>
                </div>

                <div class="mt-4">
                    <label class="text-sm text-gray-700">Variant Images</label>
                    <p class="text-xs text-red-500">Minimum 3 images required</p>

                    <div class="border-2 border-dashed border-[#C8A97E] p-4 bg-white rounded-xl">
                        <button type="button"
                            class="selectImagesBtn px-4 py-2 bg-[#C8A97E] text-white rounded-lg shadow">
                            Select Images
                        </button>

                        <input type="file" class="variantImages hidden" multiple />

                        <div class="variantPreview flex flex-wrap gap-3 mt-3"></div>
                    </div>
                </div>

            </div>
        </div>

    </div>
    <!-- Block Confirmation Modal -->
</div> <!-- CLOSE variant modal container -->

<!-- NOW PLACE BLOCK MODAL OUTSIDE -->
<div id="blockModal" class="fixed inset-0 bg-black bg-opacity-40 hidden justify-center items-center">
    <div class="w-96 bg-orange-100 rounded-lg shadow-lg p-6 relative">
        <h2 id="blockMessage" class="text-center text-stone-900 text-base font-semibold"></h2>

        <div class="flex justify-center gap-4 mt-8">
            <button onclick="closeBlockModal()" class="px-6 py-2 bg-green-500 text-white rounded-md">Cancel</button>
            <button id="confirmBlockBtn" class="px-6 py-2 bg-red-600 text-white rounded-md">Confirm</button>
        </div>
    </div>
</div>


</div>
<script>
    let typingTimer;
    let selectedProductId = null;

    window.autoSearch = function () {
        clearTimeout(typingTimer);
        typingTimer = setTimeout(() => {
            document.getElementById("searchForm").submit();
        }, 800);
    };

    window.confirmToggle = function (id, isBlocked) {
        selectedProductId = id;

        document.getElementById("blockMessage").innerText =
            isBlocked
                ? "Are you sure you want to unblock this product?"
                : "Are you sure you want to block this product?";

        const modal = document.getElementById("blockModal");
        modal.classList.remove("hidden");
        modal.classList.add("flex");
    };

    window.closeBlockModal = function () {
        const modal = document.getElementById("blockModal");
        modal.classList.add("hidden");
        modal.classList.remove("flex");
    };

    document.getElementById("confirmBlockBtn").addEventListener("click", () => {
        window.toggleBlock(selectedProductId);
        window.closeBlockModal();
    });

    window.toggleBlock = async function (id) {
        const notyf = new Notyf({ position: { x: "right", y: "top" } });

        try {
            const response = await axios.patch(`/admin/products/${id}/toggle-block`);

            if (response.data.success) {
                const isBlocked = response.data.isBlocked;

                const statusEl = document.getElementById(`status-${id}`);
                if (statusEl) {
                    statusEl.innerHTML = isBlocked
                        ? `<span class="px-3 py-1 text-xs bg-red-500 text-white rounded-full">Blocked</span>`
                        : `<span class="px-3 py-1 text-xs bg-green-500 text-white rounded-full">Active</span>`;
                }

                const btn = document.getElementById(`btn-${id}`);
                if (btn) {
                    btn.innerText = isBlocked ? "Unblock" : "Block";
                    btn.className = `px-3 py-1 text-white text-xs rounded ${isBlocked ? "bg-green-500" : "bg-red-500"
                        }`;
                }
                notyf.success(response.data.message);
            }

        } catch (error) {
            console.error(error);
            notyf.error("Failed to update product status");
        }
    };

    function applyFilters() {
        const status = document.getElementById("filterStatus").value;
        const stock = document.getElementById("filterStock").value;
        const category = document.getElementById("filterCategory").value;
        const alpha = document.getElementById("filterAlpha").value;
        const search = document.getElementById("search") ? document.getElementById("search").value : "";

        const url = `/admin/products?status=${status}&stock=${stock}&category=${category}&alpha=${alpha}&search=${encodeURIComponent(search || "")}`;
        window.location.href = url;
    }

    function resetFilters() {
        window.location.href = "/admin/products";
    }

</script>