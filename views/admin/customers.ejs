<div class="w-full min-h-screen bg-[#F5E9DA] p-6">

    <h1 class="text-2xl font-bold text-[#2c2c2c]">User Management</h1>
    <p class="text-sm text-gray-600 mt-1">
        Manage registered customers and their order history.
    </p>

    <!-- FILTER BAR -->
    <div class="mt-4 bg-white p-4 rounded-lg shadow flex flex-wrap items-center gap-4">

        <!-- STATUS FILTER -->
        <div>
            <label class="text-xs font-semibold text-gray-700">Status</label>
            <select id="filterStatus" onchange="applyFilters()" class="px-3 py-2 border rounded-lg text-sm bg-white">
                <option value="">All</option>
                <option value="active" <%=status==="active" ? "selected" : "" %>>Active</option>
                <option value="blocked" <%=status==="blocked" ? "selected" : "" %>>Blocked</option>
            </select>
        </div>

        <!-- ALPHABETIC FILTER -->
        <div>
            <label class="text-xs font-semibold text-gray-700">Sort</label>
            <select id="filterAlpha" onchange="applyFilters()" class="px-3 py-2 border rounded-lg text-sm bg-white">
                <option value="">Latest</option>
                <option value="az" <%=alpha==="az" ? "selected" : "" %>>Name A–Z</option>
                <option value="za" <%=alpha==="za" ? "selected" : "" %>>Name Z–A</option>
            </select>
        </div>

        <!-- RESET BUTTON -->
        <button onclick="resetFilters()"
            class="ml-auto px-4 py-2 bg-gray-300 text-gray-800 rounded-lg shadow text-sm hover:bg-gray-400">
            Reset Filters
        </button>
    </div>


    <!-- Search -->
    <form method="GET" id="searchForm" class="flex items-center justify-between mt-6">
        <input type="text" name="search" value="<%= search || '' %>" placeholder="Search by name or email..."
            class="w-80 px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm" oninput="autoSearch()" />
    </form>

    <!-- Table -->
    <div class="mt-6 bg-white shadow rounded-lg overflow-hidden">

        <!-- Header -->
        <div class="bg-[#C8A97E] 
                    grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 
                    text-xs font-bold text-gray-700 py-3 px-4">

            <div>Name</div>
            <div>Email</div>
            <div class="hidden sm:block">Joined Date</div>
            <div class="hidden md:block">Orders</div>
            <div class="hidden lg:block">Status</div>
            <div class="hidden lg:block">Action</div>
        </div>

        <!-- Rows -->
        <% users.forEach((user)=> { %>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 
                        py-4 px-4 border-b border-gray-100 text-sm">

                <!-- Name -->
                <div class="text-gray-700 font-medium">
                    <%= user.fullname %>
                </div>

                <!-- Email -->
                <div class="text-gray-600">
                    <%= user.email %>
                </div>

                <!-- Joined Date -->
                <div class="text-gray-600 hidden sm:block">
                    <%= user.createdAt.toDateString() %>
                </div>

                <!-- Orders -->
                <div class="text-gray-700 hidden md:block">
                    <%= user.orders ? user.orders.length : 0 %>
                </div>

                <!-- Status -->
                <div class="hidden lg:block" id="status-<%= user._id %>">
                    <% if (!user.isBlocked) { %>
                        <span class="inline-block px-4 py-1 text-xs text-white bg-green-500 rounded-full shadow">
                            Active
                        </span>
                        <% } else { %>
                            <span class="inline-block px-4 py-1 text-xs text-white bg-red-500 rounded-full shadow">
                                Blocked
                            </span>
                            <% } %>
                </div>



                <div class="hidden lg:flex gap-2">
                    <button onclick="confirmToggle('<%= user._id %>', <%= user.isBlocked %>)" id="btn-<%= user._id %>"
                        class="px-3 py-1 text-white text-xs rounded <%= user.isBlocked ? 'bg-green-500' : 'bg-red-500' %>">
                        <%= user.isBlocked ? 'Unblock' : 'Block' %>
                    </button>
                </div>
            </div>
            <% }) %>

    </div>


    <!-- Block Confirmation Modal -->
    <div id="blockModal" class="fixed inset-0 bg-black bg-opacity-40 hidden justify-center items-center">
        <div class="w-96 bg-orange-100 rounded-lg shadow-lg p-6 relative">

            <h2 id="blockMessage" class="text-center text-stone-900 text-base font-semibold">
            </h2>

            <!-- Buttons -->
            <div class="flex justify-center gap-4 mt-8">
                <button onclick="closeBlockModal()"
                    class="px-6 py-2 bg-green-500 text-white rounded-md text-sm font-medium">
                    Cancel
                </button>

                <button id="confirmBlockBtn" class="px-6 py-2 bg-red-600 text-white rounded-md text-sm font-medium">
                    Confirm
                </button>
            </div>
        </div>
    </div>

    <!-- Pagination -->
<%
    let params = [];

    if (search) params.push(`search=${encodeURIComponent(search)}`);
    if (status) params.push(`status=${status}`);
    if (alpha) params.push(`alpha=${alpha}`);

    const qs = params.join("&");
%>

<div class="flex flex-col items-center gap-4 mt-12 mb-10">
    <div class="flex justify-center items-center gap-3">
        <% if (currentPage > 1) { %>
            <a href="?<%= qs %>&page=<%= currentPage - 1 %>"
               class="w-10 h-10 flex items-center justify-center rounded-full bg-[#E7D7C3] text-stone-700 hover:bg-[#D8C4A8] transition-all shadow-sm">
                <i class="fas fa-chevron-left text-xs"></i>
            </a>
        <% } else { %>
            <span class="w-10 h-10 flex items-center justify-center rounded-full bg-stone-100 text-stone-300 cursor-not-allowed">
                <i class="fas fa-chevron-left text-xs"></i>
            </span>
        <% } %>

        <div class="flex items-center gap-2">
            <% for (let i = 1; i <= totalPages; i++) { %>
                <a href="?<%= qs %>&page=<%= i %>"
                   class="w-10 h-10 flex items-center justify-center rounded-full text-sm font-bold transition-all
                    <%= i === currentPage 
                        ? 'bg-[#C8A97E] text-white shadow-md scale-110' 
                        : 'bg-[#E7D7C3] text-stone-700 hover:bg-[#D8C4A8]' 
                    %>">
                    <%= i %>
                </a>
            <% } %>
        </div>

        <% if (currentPage < totalPages) { %>
            <a href="?<%= qs %>&page=<%= currentPage + 1 %>"
               class="w-10 h-10 flex items-center justify-center rounded-full bg-[#E7D7C3] text-stone-700 hover:bg-[#D8C4A8] transition-all shadow-sm">
                <i class="fas fa-chevron-right text-xs"></i>
            </a>
        <% } else { %>
            <span class="w-10 h-10 flex items-center justify-center rounded-full bg-stone-100 text-stone-300 cursor-not-allowed">
                <i class="fas fa-chevron-right text-xs"></i>
            </span>
        <% } %>
    </div>

    <span class="text-[10px] font-bold text-stone-400 uppercase tracking-widest">
        Page <%= currentPage %> of <%= totalPages %>
    </span>
</div>

</div>

  <script type="module" src="/script/adminjs/customers.js"></script>
