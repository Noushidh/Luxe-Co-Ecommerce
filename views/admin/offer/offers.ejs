<div class="p-6 bg-[#F5E9DA] min-h-screen">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-2xl font-bold text-stone-800 tracking-tight">Offers Management</h1>
            <p class="text-stone-500 text-sm">Manage active and upcoming promotional offers.</p>
        </div>
        <button onclick="window.location.href='/admin/offers/add'" 
                class="bg-[#C8A97E] text-white px-6 py-2.5 rounded shadow-sm hover:bg-[#b69668] transition-all flex items-center gap-2 font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Add New Offer
        </button>
    </div>

    <div class="flex flex-wrap items-center gap-4 mb-6">
        <div class="relative flex-grow max-w-md">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-stone-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </span>
            <input type="text" id="offerSearch" onkeyup="filterOffers()"
                   placeholder="Search by offer title..."
                   class="w-full pl-10 pr-4 py-2.5 bg-white border border-stone-200 rounded text-sm focus:outline-none focus:ring-1 focus:ring-[#C8A97E]">
        </div>

        <select id="statusFilter" onchange="filterOffers()"
                class="px-4 py-2.5 bg-white border border-stone-200 rounded text-sm text-stone-600 font-medium focus:outline-none focus:ring-1 focus:ring-[#C8A97E]">
            <option value="all">All Status</option>
            <option value="Active">Active Now</option>
            <option value="Upcoming">Upcoming</option>
            <option value="Expired">Expired</option>
        </select>

        <button onclick="resetFilters()"
                class="text-[10px] font-black text-stone-400 hover:text-rose-600 uppercase tracking-widest transition-colors flex items-center gap-1.5 ml-auto">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Reset Filters
        </button>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-stone-100 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-[#C8A97E] border-b border-stone-100">
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase">Offer Title</th>
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase">Type</th>
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase">Target</th>
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase">Discount </th>
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase">Start Date</th>
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase">End Date</th>
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase">Status</th>
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase text-center">Actions</th>
                </tr>
            </thead>
            <tbody id="offersTableBody">
                <% if (offers && offers.length > 0) { %>
                    <% offers.forEach(offer => { %>
                    <tr class="border-b border-stone-50 hover:bg-stone-50/50 transition-colors">
                        <td class="px-6 py-4 text-sm font-medium text-stone-800"><%= offer.offerTitle %></td>
                        <td class="px-6 py-4 text-sm text-stone-600 uppercase"><%= offer.appliesTo %></td>
                        <td class="px-6 py-4 text-sm text-stone-600"><%= offer.target %></td>
                        <td class="px-6 py-4 text-sm text-stone-600 font-mono"><%= offer.discountPercentage %>%</td>
                        <td class="px-6 py-4 text-sm text-stone-600"><%= new Date(offer.startDate).toLocaleDateString() %></td>
                        <td class="px-6 py-4 text-sm text-stone-600"><%= new Date(offer.expiryDate).toLocaleDateString() %></td>
                        <td class="px-6 py-4">
                            <% if (offer.status === 'Active') { %>
                                <span class="px-3 py-1 text-[11px] font-bold uppercase tracking-wider bg-green-100 text-green-700 rounded-full">Active</span>
                            <% } else if (offer.status === 'Upcoming') { %>
                                <span class="px-3 py-1 text-[11px] font-bold uppercase tracking-wider bg-orange-50 text-orange-600 rounded-full border border-orange-100">Upcoming</span>
                            <% } else { %>
                                <span class="px-3 py-1 text-[11px] font-bold uppercase tracking-wider bg-rose-50 text-rose-500 rounded-full border border-rose-100">Expired</span>
                            <% } %>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <div class="flex justify-center items-center gap-3">
                                <button onclick="editOffer('<%= offer._id %>')" class="text-stone-400 hover:text-[#C8A97E] transition-colors">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                                    </svg>
                                </button>
                                <button onclick="deleteOffer('<%= offer._id %>')" class="text-stone-400 hover:text-rose-500 transition-colors">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="8" class="px-6 py-20 text-center">
                            <div class="flex flex-col items-center justify-center">
                                <div class="w-16 h-16 bg-stone-100 rounded-full flex items-center justify-center mb-4">
                                    <svg class="w-8 h-8 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                                    </svg>
                                </div>
                                <h3 class="text-stone-800 font-medium">No offers found</h3>
                                <p class="text-stone-500 text-sm mt-1">There are currently no offers to display. Click "Add New Offer" to get started.</p>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>