<div class="p-6 bg-[#F5E9DA] min-h-screen">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-2xl font-bold text-stone-800 tracking-tight">Offers Management</h1>
            <p class="text-stone-500 text-sm">Manage active and upcoming promotional offers.</p>
        </div>
        <button onclick="window.location.href='/admin/offers/add'"
            class="bg-[#C8A97E] text-white px-6 py-2.5 rounded shadow-sm hover:bg-[#b69668] transition-all flex items-center gap-2 font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Add New Offer
        </button>
    </div>

<form method="GET" id="searchForm" class="flex flex-wrap items-center justify-between gap-4 mt-6 mb-6">
    <div class="flex items-center gap-4">
        <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-stone-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </span>
            <input type="text" name="search" id="offerSearch" value="<%= search || '' %>" 
                placeholder="Search by offer title..." oninput="autoSearch()"
                class="w-80 pl-10 pr-4 py-2 bg-white border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#C8A97E]">
        </div>

        <select name="status" onchange="this.form.submit()"
            class="px-4 py-2 bg-white border border-stone-200 rounded-lg text-sm text-stone-600 font-medium focus:outline-none focus:ring-1 focus:ring-[#C8A97E]">
            <option value="all">All Status</option>
            <option value="active" <%= status === "active" ? "selected" : "" %>>Active</option>
            <option value="blocked" <%= status === "blocked" ? "selected" : "" %>>Blocked</option>
            <option value="expired" <%= status === "expired" ? "selected" : "" %>>Expired</option>
        </select>
    </div>

    <a href="/admin/offers" 
        class="text-[10px] font-black text-stone-400 hover:text-rose-600 uppercase tracking-widest transition-colors flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        Reset Filters
    </a>
</form>

    <div class="bg-white rounded-xl shadow-sm border border-stone-100 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-[#C8A97E] border-b border-stone-100">
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase">Offer Title</th>
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase">Type</th>
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase">Target</th>
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase">Discount </th>
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase">Start Date</th>
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase">End Date</th>
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase">Status</th>
                    <th class="px-6 py-4 text-xs font-bold text-white uppercase text-center">Actions</th>
                </tr>
            </thead>
            <tbody id="offersTableBody">
                <% if (offers && offers.length> 0) { %>
                    <% offers.forEach(offer=> { %>
                        <tr class="offer-row border-b border-stone-50 hover:bg-stone-50/50 transition-colors"
                            data-title="<%= offer.offerTitle.toLowerCase() %>" data-status="<%= offer.status %>">

                            <td class="px-6 py-4 text-sm font-medium text-stone-800">
                                <%= offer.offerTitle %>
                            </td>
                            <td class="px-6 py-4 text-stone-500 text-xs font-bold uppercase">
                                <%= offer.appliesTo %>
                            </td>

                            <td class="px-6 py-4 text-stone-600 text-xs">
                                <% if (offer.appliesTo==='all' ) { %>
                                    Entire Store
                                    <% } else if (offer.appliesTo==='category' ) { %>
                                        <%= (offer.categoryId && offer.categoryId.subcategory) ?
                                            offer.categoryId.subcategory : offer.categoryScope %>
                                            <% } else if (offer.appliesTo==='product' ) { %>
                                                <%= (offer.productId && offer.productId.name) ? offer.productId.name
                                                    : 'Unknown Product' %>
                                                    <% } %>
                            </td>
                            <td class="px-6 py-4 font-bold text-[#C8A97E]">
                                <%= offer.discountType==='percentage' ? offer.discountValue + '%' : '₹' +
                                    offer.discountValue %>
                            </td>

                            <td class="px-6 py-4 text-sm text-stone-600">
                                <%= new Date(offer.startDate).toLocaleDateString() %>
                            </td>
                            <td class="px-6 py-4 text-sm text-stone-600">
                                <%= new Date(offer.expiryDate).toLocaleDateString() %>
                            </td>

                            <td class="px-6 py-4">
                                <div class="hidden lg:block" id="status-<%= offer._id %>">
                                    <% if (offer.isActive) { %>
                                        <span
                                            class="inline-block px-4 py-1 text-xs text-white bg-green-500 rounded-full shadow">
                                            Active
                                        </span>
                                        <% } else { %>
                                            <span
                                                class="inline-block px-4 py-1 text-xs text-white bg-red-500 rounded-full shadow">
                                                Inactive
                                            </span>
                                            <% } %>
                                </div>
                            </td>

                            <td class="px-6 py-4 text-center">
                                <div class="flex justify-center items-center gap-3">
                                    <button onclick="window.location.href='/admin/offers/edit/<%= offer._id %>'"
                                        class="text-stone-400 hover:text-[#C8A97E] transition-colors">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z">
                                            </path>
                                        </svg>
                                    </button>
                                    <button onclick="deleteOffer('<%= offer._id %>')"
                                        class="text-stone-400 hover:text-rose-500 transition-colors">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                            </path>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                            <% } else { %>
                                <% } %>
            </tbody>
        </table>
    </div>
    
<div class="flex flex-col items-center gap-4 mt-12 mb-10">
    <div class="flex justify-center items-center gap-2.5">
        
        <% if (currentPage > 1) { %>
            <a href="?<%= qs %>&page=<%= currentPage - 1 %>"
               class="w-10 h-10 flex items-center justify-center rounded-xl bg-stone-50/80 text-stone-600 hover:bg-white hover:shadow-md transition-all">
                <span class="text-lg">«</span>
            </a>
        <% } %>

        <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="?<%= qs %>&page=<%= i %>"
               class="w-10 h-10 flex items-center justify-center rounded-xl text-sm font-bold transition-all
                <%= i === currentPage 
                    ? 'bg-[#C8A97E] text-white shadow-lg shadow-[#C8A97E]/20 scale-105' 
                    : 'bg-stone-50/80 text-stone-600 hover:bg-white hover:shadow-md' 
                %>">
                <%= i %>
            </a>
        <% } %>

        <% if (currentPage < totalPages) { %>
            <a href="?<%= qs %>&page=<%= currentPage + 1 %>"
               class="w-10 h-10 flex items-center justify-center rounded-xl bg-stone-50/80 text-stone-600 hover:bg-white hover:shadow-md transition-all">
                <span class="text-lg">»</span>
            </a>
        <% } %>
    </div>
</div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
const notyf = new Notyf({ position: { x: 'right', y: 'top' }, duration: 3000 });
let searchTimeout;
function autoSearch() {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
        document.getElementById('searchForm').submit();
    }, 500); 
}
    async function deleteOffer(offerId) {
        const result = await Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e11d48',
            cancelButtonColor: '#4b5563',
            confirmButtonText: 'Yes, delete it!'
        });

        if (result.isConfirmed) {
            try {
                const response = await axios.delete(`/admin/offers/delete/${offerId}`);

                if (response.data.success) {
                    notyf.success(response.data.message);
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                }
            } catch (error) {
                console.log(error)
                notyf.error(error.response?.data?.message || 'Something went wrong', 'error');
            }
        }
    }
</script>