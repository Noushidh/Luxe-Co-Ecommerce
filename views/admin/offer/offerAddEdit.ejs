<div class="w-full min-h-screen px-4 md:px-8 bg-[#F5E9DA] py-8 overflow-x-hidden">
    <div class="max-w-4xl mx-auto">

        <div class="mb-8">
            <h1 class="text-2xl font-bold text-stone-800 tracking-tight">
                <%= offer ? 'Edit Offer' : 'Create New Offer' %>
            </h1>
            <p class="text-stone-500 text-sm font-medium">
                <%= offer ? 'Update the details of your existing offer.' : 'Define discounts for specific products, categories, or your entire store.' %>
            </p>
        </div>

        <form action="<%= offer ? '/admin/offers/edit/' + offer._id : '/admin/offers/add' %>" method="POST" id="addOfferForm"
            class="bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden">
            
            <input type="hidden" id="offerId" value="<%= offer ? offer._id : '' %>">

            <div class="p-6 md:p-8 space-y-6">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-stone-700">Offer Title *</label>
                        <input type="text" name="offerTitle" required 
                            value="<%= offer ? offer.offerTitle : '' %>"
                            placeholder="e.g. Summer Clearance Sale"
                            class="mt-1 w-full border rounded-lg px-4 py-2.5 border-stone-200 bg-stone-50/50 focus:bg-white focus:ring-1 focus:ring-[#C8A97E] outline-none transition-all">
                    </div>

                   <input type="hidden" name="discountType" value="percentage">

                     <div>
                        <label class="block text-sm font-bold text-stone-700">Discount Type</label>
                         <div class="mt-1 w-full border rounded-lg px-3 py-2.5 border-stone-200 bg-stone-100 text-stone-500 cursor-not-allowed">
                          Percentage (%)
                            </div>
                         </div>

                    <div>
                        <label id="discountValueLabel" class="block text-sm font-bold text-stone-700">Discount Value *</label>
                        <input type="number" id="discountValue" name="discountValue" min="1" required
                            value="<%= offer ? offer.discountValue : '' %>"
                            placeholder="e.g. 20"
                            class="mt-1 w-full border rounded-lg px-4 py-2.5 border-stone-200 bg-stone-50/50 focus:bg-white focus:ring-1 focus:ring-[#C8A97E] outline-none">
                    </div>
                </div>

                <hr class="border-stone-100">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-stone-700">Applies To</label>
                        <select id="appliesTo" name="appliesTo" onchange="toggleScopeFields()"
                            class="mt-1 w-full border rounded-lg px-3 py-2.5 border-stone-200 bg-stone-50/50 focus:bg-white focus:ring-1 focus:ring-[#C8A97E] outline-none">
                            <option value="all" <%= offer && offer.appliesTo === 'all' ? 'selected' : '' %>>Entire Store (All Products)</option>
                            <option value="category" <%= offer && offer.appliesTo === 'category' ? 'selected' : '' %>>Specific Category</option>
                            <option value="product" <%= offer && offer.appliesTo === 'product' ? 'selected' : '' %>>Specific Product</option>
                        </select>
                    </div>

                    <input type="hidden" name="targetId" id="targetId" value="<%= offer ? offer.targetId : 'all' %>">

                    <div id="categoryScopeDiv" class="<%= offer && offer.appliesTo === 'category' ? '' : 'hidden' %> animate-in fade-in slide-in-from-top-1 duration-300">
                        <label class="block text-sm font-bold text-stone-700">Select Main Category</label>
                        <select id="categoryScope" onchange="fetchSubCategories()"
                            class="mt-1 w-full border rounded-lg px-3 py-2.5 bg-stone-50 border-stone-200 focus:bg-white focus:ring-1 focus:ring-[#C8A97E] outline-none transition-all">
                            <option value="none" <%= !offer || offer.categoryScope === 'none' ? 'selected' : '' %>>-- Select Category --</option>
                            <option value="Men" <%= offer && offer.categoryScope === 'Men' ? 'selected' : '' %>>Men</option>
                            <option value="Women" <%= offer && offer.categoryScope === 'Women' ? 'selected' : '' %>>Women</option>
                            <option value="Kids" <%= offer && offer.categoryScope === 'Kids' ? 'selected' : '' %>>Kids</option>
                        </select>
                    </div>

                    <div id="subCategoryDiv" class="<%= offer && offer.appliesTo === 'category' && offer.categoryScope !== 'none' ? '' : 'hidden' %> animate-in fade-in slide-in-from-top-1 duration-300">
                        <label class="block text-sm font-bold text-stone-700">Select Subcategory</label>
                        <select id="subCategorySelect" onchange="setTargetId(this.value)"
                            class="w-full mt-1 px-4 py-2.5 border border-stone-200 rounded-lg bg-stone-50 focus:bg-white focus:ring-1 focus:ring-[#C8A97E] outline-none">
                            <option value="all_in_category">-- Apply to All Subcategories --</option>
                            <% if (typeof subcategories !== 'undefined' && subcategories.length > 0) { %>
                                <% subcategories.forEach(sc => { %>
                                    <option class="subcat-option"
                                        data-category="<%= (sc.category || '').toString().toLowerCase() %>"
                                        value="<%= sc._id %>"
                                        <%= offer && offer.targetId == sc._id.toString() ? 'selected' : '' %>>
                                        <%= sc.subcategory %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <div id="productSearchDiv"
                        class="<%= offer && offer.appliesTo === 'product' ? '' : 'hidden' %> animate-in fade-in slide-in-from-top-1 duration-300 relative">
                        <label class="block text-sm font-bold text-stone-700">Search Product *</label>
                        <input type="text" id="productSearchInput" placeholder="Type product name..."
                            onkeyup="searchProducts(this.value)"
                            class="mt-1 w-full border rounded-lg px-3 py-2.5 border-stone-200 bg-stone-50/50 focus:bg-white focus:ring-1 focus:ring-[#C8A97E] outline-none">

                        <div id="searchResults"
                            class="absolute z-10 w-full bg-white border rounded-lg mt-1 shadow-xl hidden max-h-48 overflow-y-auto">
                        </div>

                        <div id="selectedProductBadge" class="mt-2 <%= offer && offer.appliesTo === 'product' && offer.productId ? '' : 'hidden' %>">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-black tracking-widest bg-[#C8A97E] text-white uppercase">
                                Selected: <span id="chosenProductName" class="ml-1"><%= (offer && offer.productId) ? offer.productId.name : '' %></span>
                            </span>
                        </div>
                    </div>
                </div>

                <hr class="border-stone-100">

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end">
                    <div>
                        <label class="block text-sm font-bold text-stone-700">Start Date</label>
                        <input type="date" name="startDate" id="startDate" required
                            value="<%= offer ? offer.startDate.toISOString().split('T')[0] : '' %>"
                            class="mt-1 w-full border rounded-lg px-4 py-2.5 border-stone-200 bg-stone-50/50 focus:bg-white focus:ring-1 focus:ring-[#C8A97E] outline-none h-[46px]">
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-stone-700">Expiry Date</label>
                        <input type="date" name="expiryDate" id="expiryDate" required
                            value="<%= offer ? offer.expiryDate.toISOString().split('T')[0] : '' %>"
                            class="mt-1 w-full border rounded-lg px-4 py-2.5 border-stone-200 bg-stone-50/50 focus:bg-white focus:ring-1 focus:ring-[#C8A97E] outline-none h-[46px]">
                    </div>

                    <div class="flex items-center justify-between px-1 py-2 h-[46px]">
                        <div>
                            <label class="block text-sm font-bold text-stone-700">Status</label>
                            <p class="text-[11px] text-stone-500 leading-none">Enable or disable offers</p>
                        </div>

                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="isActive" id="isActiveToggle" class="sr-only peer" <%= (!offer || offer.isActive) ? 'checked' : '' %>>
                            <div class="w-11 h-6 bg-stone-300 peer-focus:outline-none rounded-full peer 
                                peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full 
                                peer-checked:after:border-white after:content-[''] after:absolute 
                                after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 
                                after:border after:rounded-full after:h-5 after:w-5 after:transition-all 
                                peer-checked:bg-[#C8A97E]">
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <div class="bg-stone-50 px-8 py-5 flex justify-end items-center gap-6 border-t border-stone-200">
                <button type="button" onclick="history.back()"
                    class="text-xs font-black text-stone-400 hover:text-stone-800 uppercase tracking-widest transition-colors">Cancel</button>
                <button type="button" onclick="saveOfferData()"
                    class="px-10 py-3 bg-[#C8A97E] text-white rounded shadow-sm hover:brightness-110 active:scale-95 transition-all font-black text-xs tracking-[0.15em] uppercase">
                    <%= offer ? 'Update Offer' : 'Save Offer' %>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    const notyf = new Notyf({ duration: 3000, position: { x: 'right', y: 'top' }, });

    document.addEventListener('DOMContentLoaded', () => {
        const offerId = document.getElementById('offerId').value;
        
        if (!offerId) {
            const today = new Date().toISOString().split('T')[0];
            const startDateInput = document.getElementById('startDate');
            if (startDateInput && !startDateInput.value) {
                startDateInput.value = today;
            }
        }
        
        updateDiscountLabels();
        if (document.getElementById('appliesTo').value === 'category') {
            fetchSubCategories();
        }
    });


    function toggleScopeFields() {
        const appliesTo = document.getElementById('appliesTo').value;
        const catDiv = document.getElementById('categoryScopeDiv');
        const subDiv = document.getElementById('subCategoryDiv');
        const searchDiv = document.getElementById('productSearchDiv');
        const targetIdInput = document.getElementById('targetId');

        catDiv.classList.add('hidden');
        subDiv.classList.add('hidden');
        searchDiv.classList.add('hidden');
        document.getElementById('selectedProductBadge').classList.add('hidden');

        if (appliesTo === 'all') {
            targetIdInput.value = 'all';
        } else if (appliesTo === 'category') {
            catDiv.classList.remove('hidden');
        } else if (appliesTo === 'product') {
            searchDiv.classList.remove('hidden');
            targetIdInput.value = "";
        }
    }

    function fetchSubCategories() {
        const mainCat = document.getElementById('categoryScope').value.toLowerCase();
        const subDiv = document.getElementById('subCategoryDiv');
        const subSelect = document.getElementById('subCategorySelect');
        const options = subSelect.querySelectorAll('.subcat-option');
        const targetIdInput = document.getElementById('targetId');

        if (mainCat === "none" || mainCat === "") {
            subDiv.classList.add('hidden');
            targetIdInput.value = "";
            return;
        }

        subDiv.classList.remove('hidden');
        
        let visibleCount = 0;
        options.forEach(opt => {
            const isMatch = opt.getAttribute('data-category') === mainCat;
            opt.style.display = isMatch ? 'block' : 'none';
            if (isMatch) visibleCount++;
        });

        if (!subSelect.value || subSelect.value === "") {
            subSelect.value = "all_in_category";
            targetIdInput.value = "category_" + mainCat;
        }
    }

    function setTargetId(val) {
        const targetIdInput = document.getElementById('targetId');
        const mainCat = document.getElementById('categoryScope').value.toLowerCase();
        targetIdInput.value = (val === "all_in_category") ? "category_" + mainCat : val;
    }

   async function saveOfferData() {
    const form = document.getElementById('addOfferForm');
    const offerId = document.getElementById('offerId').value;
    const discountVal = parseFloat(document.getElementById('discountValue').value);

    if (isNaN(discountVal) || discountVal <= 0 || discountVal > 100) {
        return notyf.error("Percentage must be between 1 and 100");
    }

    const data = {
        offerTitle: form.offerTitle.value.trim(),
        discountValue: discountVal,
        appliesTo: document.getElementById('appliesTo').value,
        targetId: document.getElementById('targetId').value,
        categoryScope: document.getElementById('categoryScope').value,
        startDate: document.getElementById('startDate').value,
        expiryDate: document.getElementById('expiryDate').value,
        isActive: document.getElementById('isActiveToggle').checked
    };

    if (!data.offerTitle) return notyf.error("Offer title is required");
    if (!data.targetId || data.targetId === "none") return notyf.error("Select a Category or Product");
    if (new Date(data.expiryDate) <= new Date(data.startDate)) return notyf.error("Expiry must be after Start date");

    const url = offerId ? `/admin/offers/edit/${offerId}` : '/admin/offers/add';
    const method = offerId ? 'patch' : 'post';

    try {
        const response = await axios({ method, url, data });
        if (response.data.success) {
            notyf.success(response.data.message);
            setTimeout(() => window.location.href = '/admin/offers', 1500);
        }
    } catch (error) {
        notyf.error(error.response?.data?.message || "Server Error");
    }
}

    let debounceTimer;
    async function searchProducts(query) {
        clearTimeout(debounceTimer);
        const resultsDiv = document.getElementById('searchResults');
        if (query.length < 2) return resultsDiv.classList.add('hidden');

        debounceTimer = setTimeout(async () => {
            try {
                const response = await axios.get(`/admin/offers/api/search-products?q=${query}`);
                const products = response.data.products;
                resultsDiv.innerHTML = '';
                if (products?.length > 0) {
                    resultsDiv.classList.remove('hidden');
                    products.forEach(p => {
                        const item = document.createElement('div');
                        item.className = "p-3 hover:bg-stone-100 cursor-pointer text-sm";
                        item.textContent = p.name;
                        item.onclick = () => {
                            document.getElementById('productSearchInput').value = p.name;
                            document.getElementById('targetId').value = p._id;
                            document.getElementById('chosenProductName').textContent = p.name;
                            document.getElementById('selectedProductBadge').classList.remove('hidden');
                            resultsDiv.classList.add('hidden');
                        };
                        resultsDiv.appendChild(item);
                    });
                }
            } catch (err) { console.error(err); }
        }, 300);
    }
</script>