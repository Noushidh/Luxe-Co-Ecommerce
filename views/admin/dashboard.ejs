<div class="w-full max-w-[1400px] mx-auto px-6">

    <!-- GRAPH + TOP PRODUCT -->
    <div class="grid grid-cols-3 gap-6 mt-8">

        <!-- Graph -->
        <div class="col-span-2 bg-white p-6 rounded-xl shadow">
            <div class="flex justify-between mb-4">
                <h3 class="text-sm font-medium">Monthly Revenue</h3>
                <span class="text-sm">This Year</span>
            </div>
            <canvas id="revenueChart" class="w-full h-64"></canvas>
        </div>

        <!-- Top Product -->
        <div class="bg-white p-6 rounded-xl shadow">
            <h3 class="text-sm font-medium mb-4">Top-Selling Product</h3>
            <div class="w-full h-32 bg-gray-100 rounded-lg"></div>

            <p class="font-medium mt-4 text-center">Premium Sports Shoes</p>
            <p class="text-center text-[#c8a97e]">₹4,599</p>
            <p class="text-center text-xs text-gray-500">142 units sold</p>
        </div>

    </div>

    <!-- Recent Orders -->
    <div class="bg-white p-6 rounded-xl shadow mt-8">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-sm font-medium">Recent Orders</h3>
            <a href="#" class="text-[#c8a97e] text-sm">View All</a>
