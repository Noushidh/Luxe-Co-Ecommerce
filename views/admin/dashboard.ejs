<div class="max-w-[1600px] mx-auto px-8 py-10 font-['Inter']">
    
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-12 gap-6">
        <div>
            <h1 class="text-3xl font-black tracking-tighter uppercase leading-none mb-2 text-stone-900">Executive Dashboard</h1>
            <p class="text-stone-400 text-[10px] font-bold uppercase tracking-[0.4em]">Real-time Performance Metrics</p>
        </div>

        <div class="flex items-center bg-white border border-stone-100 rounded-2xl p-1.5 shadow-sm">
            <button onclick="updateFilter('yearly')" class="px-5 py-2 text-[10px] font-bold uppercase tracking-widest rounded-xl hover:bg-stone-50 transition-all">Yearly</button>
            <button onclick="updateFilter('monthly')" class="px-5 py-2 text-[10px] font-bold uppercase tracking-widest rounded-xl bg-stone-900 text-white shadow-lg">Monthly</button>
            <button onclick="updateFilter('weekly')" class="px-5 py-2 text-[10px] font-bold uppercase tracking-widest rounded-xl hover:bg-stone-50 transition-all">Weekly</button>
        </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
        <div class="bg-white p-8 rounded-[2rem] border border-stone-100 shadow-sm">
            <p class="text-[10px] font-black text-stone-400 uppercase tracking-widest mb-3">Total Revenue</p>
            <h3 class="text-3xl font-black tracking-tighter">₹<%= totalRevenue.toLocaleString() %></h3>
        </div>
        <div class="bg-white p-8 rounded-[2rem] border border-stone-100 shadow-sm">
            <p class="text-[10px] font-black text-stone-400 uppercase tracking-widest mb-3">Total Orders</p>
            <h3 class="text-3xl font-black tracking-tighter"><%= totalOrders %></h3>
        </div>
        <div class="bg-white p-8 rounded-[2rem] border border-stone-100 shadow-sm">
            <p class="text-[10px] font-black text-stone-400 uppercase tracking-widest mb-3">Avg. Order Value</p>
            <h3 class="text-3xl font-black tracking-tighter">₹<%= Math.round(totalRevenue/totalOrders).toLocaleString() %></h3>
        </div>
        <div class="bg-white p-8 rounded-[2rem] border border-stone-100 shadow-sm">
            <p class="text-[10px] font-black text-stone-400 uppercase tracking-widest mb-3">Active Users</p>
            <h3 class="text-3xl font-black tracking-tighter"><%= totalUsers %></h3>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
        
        <div class="lg:col-span-8 bg-white p-10 rounded-[3rem] border border-stone-100 shadow-sm">
            <div class="flex justify-between items-center mb-10">
                <h3 class="text-xs font-black uppercase tracking-[0.3em] text-stone-900">Revenue Stream</h3>
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-[#C8A97E]"></span>
                    <span class="text-[10px] font-bold text-stone-400 uppercase">Growth Index</span>
                </div>
            </div>
            <div class="h-[400px]">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <div class="lg:col-span-4 bg-stone-900 rounded-[3rem] p-10 text-white flex flex-col justify-between shadow-2xl relative overflow-hidden">
            <div class="relative z-10">
                <span class="text-[#C8A97E] text-[10px] font-black uppercase tracking-[0.5em] mb-8 block">Leaderboard</span>
                <% if (topProducts && topProducts.length > 0) { %>
                    <div class="aspect-square w-full bg-stone-800 rounded-[2.5rem] overflow-hidden mb-8 border border-white/5 shadow-2xl">
                        <img src="<%= topProducts[0].imageUrl %>" class="w-full h-full object-cover" alt="Best Seller">
                    </div>
                    <h4 class="text-3xl font-black uppercase tracking-tighter mb-1 leading-none"><%= topProducts[0].name %></h4>
                    <p class="text-stone-500 text-xs font-bold uppercase tracking-widest">Most Wanted Item</p>
                <% } %>
            </div>
            
            <div class="pt-8 border-t border-white/10 flex justify-between items-center relative z-10">
                <div>
                    <p class="text-[9px] font-black text-stone-500 uppercase mb-1">Volume</p>
                    <p class="text-xl font-bold"><%= topProducts[0].totalSolds %> Units</p>
                </div>
                <div class="text-right">
                    <p class="text-[9px] font-black text-stone-500 uppercase mb-1">Status</p>
                    <p class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Trending Up</p>
                </div>
            </div>
            <div class="absolute -bottom-20 -right-20 w-64 h-64 bg-[#C8A97E]/10 rounded-full blur-[100px]"></div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="bg-white p-10 rounded-[2.5rem] border border-stone-100 shadow-sm">
            <h3 class="text-xs font-black uppercase tracking-[0.3em] mb-8">Top 10 Products</h3>
            <div class="space-y-5">
                <% topProducts.forEach((product, i) => { %>
                <div class="flex items-center gap-4 group cursor-default">
                    <span class="text-[10px] font-black text-stone-200 group-hover:text-[#C8A97E] transition-colors"><%= (i+1).toString().padStart(2, '0') %></span>
                    <div class="flex-grow">
                        <p class="text-[11px] font-black text-stone-700 uppercase truncate"><%= product.name %></p>
                        <p class="text-[9px] text-stone-400 font-bold uppercase tracking-tighter"><%= product.totalSolds %> Sales</p>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>

<div class="bg-white p-10 rounded-[2.5rem] border border-stone-100 shadow-sm">
    <h3 class="text-xs font-black uppercase tracking-[0.3em] mb-8">Main Categories</h3>
    <div class="space-y-8">
        <% 
           const maxCatCount = topCategories.length > 0 ? topCategories[0].count : 1;
           topCategories.forEach(cat => { 
           const percentage = (cat.count / maxCatCount) * 100;
        %>
        <div class="group">
            <div class="flex justify-between text-[10px] font-black uppercase mb-3 tracking-widest">
                <span class="text-stone-600"><%= cat._id %></span>
                <span class="text-stone-300"><%= Math.round(percentage) %>%</span>
            </div>
            <div class="w-full h-[3px] bg-stone-50 rounded-full overflow-hidden">
                <div class="h-full bg-stone-900 group-hover:bg-[#C8A97E] transition-all duration-1000" 
                     style="width: <%= percentage %>%"></div>
            </div>
        </div>
        <% }) %>
    </div>
</div>

 <div class="bg-white p-10 rounded-[2.5rem] border border-stone-100 shadow-sm">
    <h3 class="text-xs font-black uppercase tracking-[0.3em] mb-8">Top 10 Subcategories</h3>
    <div class="space-y-5">
        <% topSubcategories.forEach((sub, i) => { %>
        <div class="flex items-center justify-between group cursor-default">
            <div class="flex items-center gap-4">
                <span class="text-[10px] font-black text-stone-200 group-hover:text-stone-900 transition-colors">
                    <%= (i+1).toString().padStart(2, '0') %>
                </span>
                <p class="text-[11px] font-black text-stone-700 uppercase"><%= sub._id %></p>
            </div>
            <span class="text-[10px] font-bold text-stone-400 bg-stone-50 px-3 py-1 rounded-full">
                <%= sub.totalSold %> Sold
            </span>
        </div>
        <% }) %>
    </div>
</div>


    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const rawRevenueData = <%- monthlyRevenue %>;
    const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    
    const labels = rawRevenueData.map(item => monthNames[item._id - 1]);
    const dataValues = rawRevenueData.map(item => item.total);

    const ctx = document.getElementById('revenueChart').getContext('2d');
    
    const gradient = ctx.createLinearGradient(0, 0, 0, 400);
    gradient.addColorStop(0, 'rgba(200, 169, 126, 0.1)');
    gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Revenue',
                data: dataValues,
                borderColor: '#1C1917',
                borderWidth: 3,
                backgroundColor: gradient,
                fill: true,
                tension: 0.4,
                pointRadius: 0,
                pointHoverRadius: 6,
                pointHoverBackgroundColor: '#C8A97E',
                pointHoverBorderColor: '#fff',
                pointHoverBorderWidth: 3
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { 
                    grid: { display: false },
                    ticks: { font: { weight: '600', size: 10 }, color: '#A8A29E' }
                },
                y: { 
                    border: { display: false },
                    grid: { color: '#F5F5F4' },
                    ticks: { font: { weight: '600', size: 10 }, color: '#A8A29E' }
                }
            }
        }
    });
</script>