    </div>

    <!-- Offers & Banners -->
    <div class="grid grid-cols-2 gap-6 mt-8">

        <!-- Offers -->
        <div class="bg-white p-6 rounded-xl shadow">
            <h3 class="text-sm font-medium mb-4">Active Offers</h3>

            <div class="bg-[#faf6f1] p-3 rounded-lg mb-3">
                <p class="font-medium">Summer Sale</p>
                <p class="text-xs text-gray-600">30% off on all summer items</p>
            </div>

            <div class="bg-[#faf6f1] p-3 rounded-lg mb-3">
                <p class="font-medium">New User Discount</p>
                <p class="text-xs text-gray-600">₹500 off on first purchase</p>
            </div>
        </div>

    </div>

</div>
