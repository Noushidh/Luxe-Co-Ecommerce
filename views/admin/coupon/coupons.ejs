<div class="w-full min-h-[calc(100vh-103px)] px-3 sm:px-4 md:px-6 lg:px-8 overflow-x-hidden">
    <div class="max-w-[1400px] mx-auto">

        <div class="p-6 bg-white rounded-xl shadow-sm border border-stone-200">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-stone-800 tracking-tight">Coupon Management</h2>
                    <p class="text-sm text-stone-500 font-medium">Create and monitor discount codes for your store.</p>
                </div>
                <a href="/admin/coupons/add"
                    class="flex items-center gap-2 px-6 py-3 rounded shadow-sm text-white text-xs font-black tracking-widest transition-all hover:brightness-110 active:scale-95 inline-block"
                    style="background-color: #C8A97E; text-decoration: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4" />
                    </svg>
                    ADD NEW COUPON
                </a>
            </div>

      <form method="GET" id="searchForm" class="flex flex-wrap items-center justify-between gap-4 mt-6 mb-6">
    <div class="flex items-center gap-4">
        <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-stone-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </span>
            <input type="text" name="search" id="offerSearch" value="<%= search || '' %>" 
                placeholder="Search by coupen name  & code..." oninput="autoSearch()"
                class="w-80 pl-10 pr-4 py-2 bg-white border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#C8A97E]">
        </div>

        <select name="status" onchange="this.form.submit()"
            class="px-4 py-2 bg-white border border-stone-200 rounded-lg text-sm text-stone-600 font-medium focus:outline-none focus:ring-1 focus:ring-[#C8A97E]">
            <option value="all">All Status</option>
            <option value="active" <%= status === "active" ? "selected" : "" %>>Active</option>
            <option value="blocked" <%= status === "blocked" ? "selected" : "" %>>Inactive</option>
            <option value="expired" <%= status === "expired" ? "selected" : "" %>>Expired</option>
        </select>
    </div>

    <a href="/admin/coupons" 
        class="text-[10px] font-black text-stone-400 hover:text-rose-600 uppercase tracking-widest transition-colors flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        Reset Filters
    </a>
</form>

            <div class="overflow-x-auto border border-stone-200 rounded-lg shadow-sm">
                <table class="w-full text-left border-collapse" id="couponTable">
                    <thead>
                        <tr class="text-white uppercase text-[10px] tracking-[0.15em] font-black"
                            style="background-color: #C8A97E;">
                            <th class="px-6 py-5">Name</th>
                            <th class="px-6 py-5">Code</th>
                            <th class="px-6 py-5">Discount</th>
                            <th class="px-6 py-5">Max Discount</th>
                            <th class="px-6 py-5">Min Order</th>
                            <th class="px-6 py-5">Expiry</th>
                            <th class="px-6 py-5 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-stone-100 bg-white">
                        <% if (coupons && coupons.length> 0) { %>
                            <% coupons.forEach(coupon=> { %>
                                <tr class="hover:bg-stone-50/50 transition-colors">
                                    <td class="px-6 py-5">
                                        <span class="font-bold text-stone-800 text-sm">
                                            <%= coupon.name %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-5">
                                        <span
                                            class="bg-stone-100 text-stone-600 px-2.5 py-1 rounded text-[11px] font-black font-mono border border-stone-200 uppercase tracking-wider">
                                            <%= coupon.code %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-5 text-stone-700 text-sm font-bold">
                                        <%= coupon.discountType==='percentage' ? coupon.discountValue + '%' : '₹' +
                                            coupon.discountValue %>
                                    </td>
                                    <td class="px-6 py-5 text-stone-500 text-sm font-medium">
                                        <%= coupon.maxDiscountAmount ? '₹' + coupon.maxDiscountAmount : '—' %>
                                    </td>
                                    <td class="px-6 py-5 text-stone-800 text-sm font-bold">
                                        ₹<%= coupon.minPurchase %>
                                    </td>
                                    <td class="px-6 py-5 text-stone-500 text-sm font-medium expiry-cell">
                                        <%= new Date(coupon.expiryDate).toLocaleDateString('en-IN', { day: 'numeric' ,
                                            month: 'short' , year: 'numeric' }) %>
                                            <span class="hidden raw-date">
                                                <%= coupon.expiryDate %>
                                            </span>
                                    </td>
                                    <td class="px-6 py-5">
                                        <div class="flex justify-center gap-4">
                                            <a href="/admin/coupons/edit/<%= coupon._id %>"
                                                class="text-stone-400 hover:text-stone-800 transition-all transform hover:scale-110"
                                                title="Edit Coupon">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                                    </path>
                                                </svg>
                                            </a>
                                            <button onclick="deleteCoupon('<%= coupon._id %>')"
                                                class="text-stone-300 hover:text-rose-600 transition-all transform hover:scale-110"
                                                title="Delete Coupon">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                                    </path>
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="px-6 py-20 text-center">
                                                <div class="flex flex-col items-center justify-center text-stone-400">
                                                    <svg class="w-12 h-12 mb-3 opacity-20" fill="none"
                                                        stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="1"
                                                            d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5.5 0 11-1 0 .5.5 0 011 0z">
                                                        </path>
                                                    </svg>
                                                    <p class="text-base font-medium">No coupons found</p>
                                                    <p class="text-xs">Try adjusting your filters or add a new
                                                        promotion.</p>
                                                </div>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
  <% if (totalPages > 1) { %>
<div class="flex flex-col items-center gap-4 mt-12 mb-10">
    <div class="flex justify-center items-center gap-2.5">
        
        <% if (currentPage > 1) { %>
            <a href="/admin/coupons?<%= qs %>&page=<%= currentPage - 1 %>"
               class="w-10 h-10 flex items-center justify-center rounded-xl bg-stone-50/80 text-stone-600 hover:bg-white hover:shadow-md transition-all">
                <span class="text-lg">«</span>
            </a>
        <% } %>

        <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="/admin/coupons?<%= qs %>&page=<%= i %>"
               class="w-10 h-10 flex items-center justify-center rounded-xl text-sm font-bold transition-all
                <%= i === currentPage 
                    ? 'bg-[#C8A97E] text-white shadow-lg shadow-[#C8A97E]/20 scale-105' 
                    : 'bg-stone-50/80 text-stone-600 hover:bg-white hover:shadow-md' 
                %>">
                <%= i %>
            </a>
        <% } %>

        <% if (currentPage < totalPages) { %>
            <a href="/admin/coupons?<%= qs %>&page=<%= currentPage + 1 %>"
               class="w-10 h-10 flex items-center justify-center rounded-xl bg-stone-50/80 text-stone-600 hover:bg-white hover:shadow-md transition-all">
                <span class="text-lg">»</span>
            </a>
        <% } %>
    </div>
</div>
<% } %>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const notyf = new Notyf({ position: { x: 'right', y: 'top' }, duration: 3000 });
    let searchTimer;
    function autoSearch() {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
            document.getElementById('searchForm').submit();
        }, 500); 
    }
    async function deleteCoupon(couponId) {
        console.log("click")
        const result = await Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e11d48',
            cancelButtonColor: '#4b5563',
            confirmButtonText: 'Yes, delete it!'
        });

        if (result.isConfirmed) {
            try {
                const response = await axios.delete(`/admin/coupons/delete/${couponId}`);

                if (response.data.success) {
                    notyf.success(response.data.message);
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                }
            } catch (error) {
                console.log(error)
                notyf.error(error.response?.data?.message || 'Something went wrong', 'error');
            }
        }
    }
</script>