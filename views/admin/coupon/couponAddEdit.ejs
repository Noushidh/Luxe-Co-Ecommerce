<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Coupon | Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">
    <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
</head>
<body class="bg-stone-100 font-sans">

<div class="max-w-5xl mx-auto p-6 min-h-screen">
  <div class="flex justify-between items-center mb-6">
    <h1 id="pageTitle" class="text-2xl font-bold text-stone-800">Add New Coupon</h1>
    <a href="/admin/coupons" class="text-stone-500 hover:text-stone-700 flex items-center gap-2 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to List
    </a>
  </div>

  <form id="couponForm" class="space-y-6">
    <input type="hidden" id="couponId" name="couponId">

    <div class="bg-white p-6 rounded-xl shadow-sm border border-stone-200">
      <h3 class="text-lg font-medium text-stone-700 mb-4 border-b pb-2">Basic Information</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-stone-600">Coupon Name *</label>
          <input type="text" id="name" name="name" required placeholder="Festival Offer" 
                 class="mt-1 w-full border rounded-lg px-3 py-2 outline-none border-stone-300 focus:ring-2 focus:ring-[#C8A97E]">
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-600">Coupon Code *</label>
          <div class="flex gap-2 mt-1">
            <input type="text" id="code" name="code" required placeholder="SAVE50" 
                   class="flex-1 border rounded-lg px-3 py-2 uppercase font-mono font-bold border-stone-300 outline-none focus:ring-2 focus:ring-[#C8A97E]">
            <button type="button" onclick="generateRandomCode()" 
                    class="px-4 py-2 bg-stone-800 text-white text-xs font-bold rounded-lg hover:bg-stone-700 transition-all active:scale-95 shadow-sm">
              GENERATE
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-stone-200">
      <h3 class="text-lg font-medium text-stone-700 mb-4 border-b pb-2">Discount Logic</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div>
          <label class="block text-sm font-medium text-stone-600">Discount Type</label>
          <select id="discountType" name="discountType" class="mt-1 w-full border rounded-lg px-3 py-2 border-stone-300">
            <option value="percentage">Percentage (%)</option>
            <option value="fixedAmount">Fixed Amount (₹)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-600">Discount Value *</label>
          <input type="number" id="discountValue" name="discountValue" min="1" required class="mt-1 w-full border rounded-lg px-3 py-2 border-stone-300">
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-600">Max Discount (₹)</label>
          <input type="number" id="maxDiscountAmount" name="maxDiscountAmount" min="0" placeholder="e.g. 500" class="mt-1 w-full border rounded-lg px-3 py-2 border-stone-300">
        </div>
      </div>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-stone-200">
      <h3 class="text-lg font-medium text-stone-700 mb-4 border-b pb-2">Usage & Validity</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div><label class="block text-sm font-medium text-stone-600">Min Purchase (₹)</label>
          <input type="number" id="minPurchase" name="minPurchase" placeholder="0" min="0" class="mt-1 w-full border rounded-lg px-3 py-2 border-stone-300">
        </div>
        <div><label class="block text-sm font-medium text-stone-600">Total Usage Limit</label>
          <input type="number" id="limit" name="limit" placeholder="Unlimited" min="0" class="mt-1 w-full border rounded-lg px-3 py-2 border-stone-300">
        </div>
        <div><label class="block text-sm font-medium text-stone-600">Start Date</label>
          <input type="date" id="startDate" name="startDate" class="mt-1 w-full border rounded-lg px-3 py-2 border-stone-300">
        </div>
        <div><label class="block text-sm font-medium text-stone-600">Expiry Date *</label>
          <input type="date" id="expiryDate" name="expiryDate" required class="mt-1 w-full border rounded-lg px-3 py-2 border-stone-300">
        </div>
      </div>
    </div>

    <div class="flex items-center justify-between p-6 bg-white rounded-xl shadow-sm border border-stone-200">
      <div class="flex items-center gap-3">
        <input type="checkbox" id="isActive" name="isActive" checked class="w-5 h-5 accent-[#C8A97E]">
        <label for="isActive" class="text-sm font-medium text-stone-700">Active and Ready to Use</label>
      </div>
      <div class="flex gap-4">
        <button type="button" onclick="window.location.href='/admin/coupons'" class="px-8 py-2 text-stone-600 font-medium">Discard</button>
        <button type="submit" id="submitBtn" class="px-10 py-2 text-white rounded shadow-md font-black tracking-widest text-xs transition-all hover:brightness-110 active:scale-95" style="background-color: #C8A97E;">SAVE COUPON</button>
      </div>
    </div>
  </form>
</div>

<script>
      const notyf = new Notyf({ position: { x: 'right', y: 'top' }, duration: 3000 });

function generateRandomCode() {
  const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  let result = "CPN-"; 
  for (let i = 0; i < 6; i++) {
    result += chars.charAt(Math.floor(Math.random() * chars.length));
  }
  document.getElementById('code').value = result;
}
  

  document.getElementById('couponForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());
    data.isActive = document.getElementById('isActive').checked; 

    console.log("Data being sent:", data); // Check your browser console!

    try {
        const response = await axios.post('/admin/coupons/add', data);
        if (response.data.success) {
          notyf.success(response.data.message)
          setTimeout(()=>{window.location.href = '/admin/coupons'},1000)  
        }else{
          notyf.error(response.data.message);
        }
    } catch (err) {
        notyf.error(err.response?.data?.message || "Error saving coupon!");
    }
  });
</script>

</body>
</html>